---
import Base from '../layouts/Base.astro';
import { conBase } from '../lib/base';
import Encabezado from '../components/Encabezado.astro';
import Silla from '../components/Silla.astro';
import Estrella from '../components/Estrella.astro';
import Pantalla from '../components/movil/Pantalla.astro';
import { registro, festival } from '../data/site';
import { artistas } from '../data/artistas';
---

<Base
  titulo={registro.titulo}
  descripcion={`${registro.titulo} del ${festival.nombre}. ${registro.estado}.`}
>
  {/* ── Móvil: la ficha y poco más ─────────────────────────────────────── */}
  <Fragment slot="movil">
    <Pantalla
      titulo={registro.titulo}
      indice="04"
      nota={registro.estado}
      fondo="rojo"
    >
      <div class="p-4">
        <article
          class="border-2 border-tinta bg-amarillo text-tinta shadow-[6px_6px_0_var(--color-tinta)]"
        >
          <header class="border-b-2 border-tinta bg-tinta px-4 py-4 text-papel">
            <p class="meta text-[0.55rem] text-amarillo">{registro.ciudad}</p>
            <h2 class="display mt-2 text-4xl leading-none">
              {registro.estado}
            </h2>
          </header>

          <dl class="divide-y divide-tinta/20 px-4">
            {
              [
                ['Fecha', 'A determinar'],
                ['Hora', 'A determinar'],
                ['Lugar', registro.ciudad],
              ].map(([k, v]) => (
                <div class="flex items-baseline gap-4 py-3">
                  <dt class="meta w-16 shrink-0 text-[0.55rem] text-rojo">
                    {k}
                  </dt>
                  <dd class="font-mono text-sm">{v}</dd>
                </div>
              ))
            }
          </dl>

          <p
            class="meta border-t-2 border-tinta px-4 py-3 text-[0.5rem] leading-relaxed text-tinta/55"
          >
            {registro.nota}
          </p>
        </article>

        <p class="meta mt-5 text-[0.55rem] leading-relaxed text-amarillo/70">
          {registro.estado} — el registro abrirá junto con el programa.
        </p>

        <a href={conBase("/artistas")} class="boton boton--papel mt-5">
          {artistas.titulo}
        </a>
      </div>
    </Pantalla>
  </Fragment>

  <Encabezado
    indice={`Registro / ${festival.anio}`}
    titulo={registro.titulo}
    fondo="rojo"
  />

  <section class="relative overflow-hidden border-b-2 border-tinta bg-amarillo">
    <Silla
      variante="roja"
      deriva
      class="absolute -right-8 -bottom-12 w-48 opacity-15 lg:w-80"
    />

    {/* Apretado por abajo: la nota es lo último que hay y con `py-28` quedaba
        un palmo de vacío entre ella y la banda de cierre. */}
    <div class="relative px-4 pt-16 pb-14 sm:px-6 lg:px-10 lg:pt-20 lg:pb-16">
      <!-- Tarjeta de evento en estado "por definir" -->
      <article
        class="max-w-2xl border-2 border-tinta bg-papel shadow-[10px_10px_0_var(--color-tinta)]"
        data-reveal="escala"
      >
        <header class="border-b-2 border-tinta bg-tinta px-6 py-5 text-papel">
          <p class="meta text-amarillo">{registro.ciudad}</p>
          <h2 class="display mt-3 text-5xl leading-none lg:text-6xl">
            {registro.estado}
          </h2>
        </header>

        <div class="px-6 py-8">
          <dl class="space-y-4">
            <div class="flex items-baseline gap-4 border-b border-tinta/20 pb-4">
              <dt class="meta w-24 shrink-0 text-rojo">Fecha</dt>
              <dd class="font-mono text-base">A determinar</dd>
            </div>
            <div class="flex items-baseline gap-4 border-b border-tinta/20 pb-4">
              <dt class="meta w-24 shrink-0 text-rojo">Hora</dt>
              <dd class="font-mono text-base">A determinar</dd>
            </div>
            <div class="flex items-baseline gap-4">
              <dt class="meta w-24 shrink-0 text-rojo">Lugar</dt>
              <dd class="font-mono text-base">{registro.ciudad}</dd>
            </div>
          </dl>

          <p class="meta mt-8 leading-relaxed text-tinta/55">
            {registro.nota}
          </p>
        </div>

        <footer class="flex flex-wrap gap-3 border-t-2 border-tinta px-6 py-5">
          {/* El mismo botón dormido que el de donar en la portada: un
              tratamiento para «esto existe y todavía no está abierto», no uno
              por página. */}
          <button type="button" class="boton boton--papel boton--dormido" disabled>
            {registro.acciones.registro}
          </button>
          <a href={conBase("/programa")} class="boton boton--papel">
            {registro.acciones.leerMas}
          </a>
        </footer>
      </article>

      <p class="meta mt-10 max-w-md text-tinta/50" data-reveal="arriba">
        {registro.estado} — el registro abrirá junto con el programa.
      </p>
    </div>
  </section>

  {/* La misma secuencia de Sedes: rojo → amarillo → rojo. El papel queda
      contenido en la tarjeta, donde sí funciona como superficie de lectura,
      y deja de ocupar una banda completa. */}
  <section class="relative overflow-hidden border-t-2 border-tinta bg-rojo text-amarillo">
    <Estrella tinta="amarilla" alto="abajo" />
    <div class="relative px-4 py-20 sm:px-6 lg:px-10">
      <p
        class="display max-w-4xl text-[9vw] leading-[0.95] lg:text-[5.5vw]"
        data-lineas
        data-reveal="lineas"
      >
        {festival.fechas}
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal="arriba">
        <a href={conBase("/programa")} class="boton boton--amarillo">Ver el programa</a>
        {
          festival.donaciones.paypal && (
            <a
              href={festival.donaciones.paypal}
              target="_blank"
              rel="noopener"
              class="boton boton--papel"
            >
              ★ Donar ★
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>
