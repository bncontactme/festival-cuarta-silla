---
import Base from '../layouts/Base.astro';
import { conBase } from '../lib/base';
import Encabezado from '../components/Encabezado.astro';
import RejaArtistas from '../components/RejaArtistas.astro';
import BuscadorArtistas from '../components/BuscadorArtistas.astro';
import Estrella from '../components/Estrella.astro';
import Pantalla from '../components/movil/Pantalla.astro';
import { artistas } from '../data/artistas';
import { festival } from '../data/site';

const cuantos = artistas.lista.length;
---

<Base
  titulo={artistas.titulo}
  descripcion={
    cuantos
      ? `Lxs ${cuantos} artistas del ${festival.nombre} en ${festival.ciudad}.`
      : `Artistas del ${festival.nombre} en ${festival.ciudad}. ${artistas.vacio.titulo}.`
  }
>
  {/* ── Móvil: la misma reja, en dos columnas ──────────────────────────── */}
  {/* Estuvo en una sola columna, a lo ancho de la pantalla, para que la foto
      se viera —que es lo único que se viene a ver—. Y se veía; lo que no se
      veía era el grupo: una cara por pantalla son trece pantallas de scroll
      para dieciocho nombres, y la primera pregunta de esta página es
      «¿quiénes son?». A dos columnas la foto todavía se lee y el scroll baja
      a menos de cuatro pantallas.

      Ya no monta su propia lista: pinta el MISMO `RejaArtistas` que el
      escritorio, y las columnas las decide `movil.css` preguntándole al ancho
      del marco. Dos rejas distintas para la misma lista eran dos sitios donde
      arreglar lo mismo. */}
  <Fragment slot="movil">
    <Pantalla
      titulo={artistas.titulo}
      indice="05"
      nota={cuantos ? `${cuantos} ${cuantos === 1 ? 'nombre' : 'nombres'}` : undefined}
      fondo="amarillo"
      ancho="reja"
    >
      {cuantos > 0 && (
        <Fragment slot="fijo">
          <BuscadorArtistas variante="movil" />
        </Fragment>
      )}

      {
        cuantos === 0 ? (
          <div class="p-4">
            <div class="ficha">
              <p class="display text-3xl leading-[0.95]">
                {artistas.vacio.titulo}
              </p>
              <p class="mt-4 font-mono text-[0.8rem] leading-relaxed text-tinta/70">
                {artistas.vacio.nota}
              </p>
            </div>
          </div>
        ) : (
          <RejaArtistas />
        )
      }
    </Pantalla>
  </Fragment>

  <Encabezado
    indice={
      cuantos
        ? `${artistas.titulo} / ${String(cuantos).padStart(2, '0')}`
        : `${artistas.titulo} / ${festival.anio}`
    }
    titulo={artistas.titulo}
    fondo="amarillo"
  />

  {/* Vacía, la sección se aprieta: la ficha de «todavía no hay» flotando en
      media pantalla de blanco se lee como un error de maquetación y no como un
      estado. Llena, la reja va a sangre y no lleva relleno ninguno. */}
  {/* El campo pasa a amarillo. El blanco no desaparece: se queda donde tiene
      oficio, que es el marco de las fotos de cada ficha. */}
  <section class="bg-amarillo">
    {/* La banda de buscar, pegada debajo de la barra de navegación. Va aquí y
        no dentro del `Encabezado`: ése es el cartel de la página —se va con el
        scroll, como se va la portada de una revista— y esto es un mando, que
        tiene que seguir a mano en la fila catorce. */}
    {cuantos > 0 && <BuscadorArtistas variante="escritorio" />}

    <div class={cuantos ? '' : 'px-4 py-14 sm:px-6 lg:px-10 lg:py-16'}>
      {/* Sin `border-r` en el contenedor: los cantos derechos de la última
          columna son los de las fichas, y el de abajo cierra la reja. */}
      <RejaArtistas class={cuantos ? 'border-b-2' : ''} />
    </div>
  </section>

  <section class="relative overflow-hidden border-t-2 border-tinta bg-rojo">
    <Estrella tinta="amarilla" alto="abajo" />
    <div class="relative px-4 py-20 sm:px-6 lg:px-10">
      <p
        class="meta mb-6 inline-block bg-amarillo px-3 py-1.5 text-tinta"
        data-reveal="lado"
      >
        {festival.ciudad}
      </p>
      <p
        class="display max-w-4xl text-[9vw] leading-[0.95] text-amarillo lg:text-[5.5vw]"
        data-lineas
        data-reveal="lineas"
      >
        {festival.fechas}
      </p>
      <a
        href={conBase("/programa")}
        class="boton boton--amarillo mt-10"
        data-reveal="arriba"
      >
        Ver el programa
      </a>
    </div>
  </section>
</Base>
