---
import Base from '../layouts/Base.astro';
import { conBase } from '../lib/base';
import { imagen, juegoDeImagenes } from '../lib/imagen';
import Encabezado from '../components/Encabezado.astro';
import Estrella from '../components/Estrella.astro';
import Aporte from '../components/Aporte.astro';
import SubirFotos from '../components/SubirFotos.astro';
import Visor from '../components/Visor.astro';
import SubirBanda from '../components/SubirBanda.astro';
import Pantalla from '../components/movil/Pantalla.astro';
import { archivo } from '../data/archivo';
import { festival } from '../data/site';

const ediciones = archivo.lista;
const aportes = archivo.aportes;
const hayNada = ediciones.length === 0 && aportes.length === 0;

const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
const fotosDelPublico = aportes.reduce((n, a) => n + a.fotos.length, 0);
const cuenta = [
  aportes.length ? plural(aportes.length, 'entrada', 'entradas') : null,
  ediciones.length ? plural(ediciones.length, 'edición', 'ediciones') : null,
].filter(Boolean).join(' · ');
---

<Base
  titulo={archivo.titulo}
  descripcion={`Registro del ${festival.nombre} en ${festival.ciudad}: sus ediciones y las fotos de quienes estuvieron.`}
>
  {/* ── Móvil: la invitación, las entradas y las fotos de cada año ──────── */}
  <Fragment slot="movil">
    <Pantalla
      titulo={archivo.titulo}
      indice="06"
      nota={cuenta || undefined}
      fondo="amarillo"
    >
      {/* La invitación va primero y lleva el botón a todo lo ancho: en el
          teléfono es donde está la cámara, y donde de verdad se va a usar. */}
      <SubirBanda movil />

      {
        aportes.length > 0 && (
          <ul class="grid grid-cols-2 gap-3 px-4 pt-4 pb-8">
            {aportes.map((a, i) => (
              <Aporte aporte={a} indice={i} sizes="(min-width: 32rem) 15rem, 47vw" />
            ))}
          </ul>
        )
      }

      {
          ediciones.map((e) => (
            <section class="border-b-2 border-tinta/20 px-4 py-6">
              <p class="meta text-[0.6rem] text-tinta/55">{e.anio}</p>
              <h2 class="display mt-2 text-3xl leading-none">{e.edicion}</h2>
              {e.lema && (
                <p class="mt-2 font-mono text-[0.8rem] opacity-60">{e.lema}</p>
              )}
              <div class="mt-4 grid grid-cols-2 gap-2">
                {e.fotos.map((f) => (
                  <img
                    src={imagen(f.src, 480)}
                    srcset={juegoDeImagenes(f.src, [320, 480]) || undefined}
                    sizes="50vw"
                    alt={f.pie ?? `${e.edicion}, ${e.anio}`}
                    width="1200"
                    height="900"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full border-2 border-tinta object-cover"
                  />
                ))}
              </div>
            </section>
          ))
      }
    </Pantalla>
  </Fragment>

  <Encabezado
    indice={
      hayNada
        ? `${archivo.titulo} / ${archivo.abierto.rotulo}`
        : `${archivo.titulo} / ${String(aportes.length + ediciones.length).padStart(2, '0')}`
    }
    titulo={archivo.titulo}
    fondo="amarillo"
  />

  {/* ── La invitación ────────────────────────────────────────────────────
      Arriba de todo y siempre, llena o vacía la galería: es la puerta del
      archivo abierto, y una puerta al final de cien fotos no la encuentra
      nadie. Una franja negra de un renglón entre el amarillo del encabezado y
      el de las entradas. */}
  <SubirBanda />

  {/* ── Las entradas del público ─────────────────────────────────────────
      Antes que las ediciones: son lo que se mueve, lo que alguien subió la
      semana pasada. Las ediciones son el fondo del archivo y van debajo, de
      la más reciente a la más vieja, como siempre. */}
  {
    aportes.length > 0 && (
      <section class="border-b-2 border-tinta bg-amarillo">
        <div class="px-4 pt-8 pb-14 sm:px-6 lg:px-10 lg:pt-10 lg:pb-16">
          <div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-tinta pb-4">
            <h2 class="display text-4xl leading-none lg:text-5xl" data-reveal="lado">
              {archivo.abierto.entradas}
            </h2>
            <p class="meta text-tinta/60" data-reveal="arriba">
              {plural(aportes.length, 'entrada', 'entradas')} ·{' '}
              {plural(fotosDelPublico, 'foto', 'fotos')}
            </p>
          </div>
          <ul class="mt-8 grid grid-cols-4 gap-5">
            {aportes.map((a, i) => (
              <Aporte aporte={a} indice={i} sizes="(min-width: 64rem) 23vw, 46vw" />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
      /* Una banda por edición, y dentro una hoja de contactos. El año manda:
         va en display al tamaño de un titular de sección, porque en un
         archivo lo primero que se busca es el año y no el nombre.

         Las ediciones alternan campo —roja, amarilla, roja— igual que dos
         posts seguidos de la cuenta. Es la traducción más directa de la
         referencia que hay en el sitio: un archivo es, estructuralmente, un
         feed. Y el año va siempre en la tinta contraria a la de su campo, que
         es el único sitio donde las dos tintas se tocan a plena fuerza — algo
         que sólo se puede hacer a tamaño cartel, y 9vw lo es de sobra. */
      ediciones.map((e, n) => {
        const rojo = n % 2 === 0;
        return (
        <section
          class={`border-b-2 border-tinta ${rojo ? 'relative overflow-hidden bg-rojo' : 'bg-amarillo'}`}
        >
          {rojo && <Estrella tinta="amarilla" alto="abajo" />}
          <div class="relative px-4 pt-12 pb-16 sm:px-6 lg:px-10 lg:pt-16 lg:pb-20">
            <div class="relative flex flex-wrap items-end justify-between gap-6 border-b-2 border-tinta pb-8">
              <div>
                {rojo ? (
                  <p
                    class="meta mb-5 inline-block bg-amarillo px-3 py-1.5 text-tinta"
                    data-reveal="lado"
                  >
                    {String(n + 1).padStart(2, '0')} / {e.edicion}
                  </p>
                ) : (
                  <p class="meta mb-5 flex items-center gap-4 text-tinta" data-reveal="lado">
                    <span class="inline-block h-[2px] w-12 bg-rojo" />
                    {String(n + 1).padStart(2, '0')} / {e.edicion}
                  </p>
                )}
                <h2
                  class={`display text-[16vw] leading-[0.82] lg:text-[9vw] ${rojo ? 'text-amarillo' : 'text-rojo'}`}
                  data-lineas
                  data-reveal="lineas"
                >
                  {e.anio}
                </h2>
                {e.lema && (
                  <p
                    class={`mt-5 max-w-[48ch] font-mono text-sm leading-relaxed ${rojo ? 'text-papel' : 'text-tinta/70'}`}
                    data-reveal="arriba"
                  >
                    {e.lema}
                  </p>
                )}
              </div>

              {/* Los números de la edición, en columna y alineados a la
                  derecha: son datos de ficha, no titulares. */}
              <dl
                class={`meta grid gap-2 text-right ${rojo ? 'text-papel' : 'text-tinta/55'}`}
                data-reveal="arriba"
              >
                {e.sedes && (
                  <div>
                    <dt class="sr-only">{archivo.acciones.sedes}</dt>
                    <dd>
                      {e.sedes} {archivo.acciones.sedes}
                    </dd>
                  </div>
                )}
                {e.actividades && (
                  <div>
                    <dt class="sr-only">{archivo.acciones.actividades}</dt>
                    <dd>
                      {e.actividades} {archivo.acciones.actividades}
                    </dd>
                  </div>
                )}
                <div>
                  <dt class="sr-only">Fotos</dt>
                  <dd>{e.fotos.length} fotos</dd>
                </div>
              </dl>
            </div>

            <ul class="relative mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {e.fotos.map((f, i) => (
                <li data-reveal="escala" data-retraso={(i % 3) * 90}>
                  <figure>
                    <img
                      src={imagen(f.src, 800)}
                      srcset={juegoDeImagenes(f.src) || undefined}
                      sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                      alt={f.pie ?? `${e.edicion}, ${e.anio}`}
                      width="1200"
                      height="900"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full border-2 border-tinta object-cover"
                    />
                    {f.pie && (
                      <figcaption
                        class={`meta mt-2.5 leading-relaxed ${rojo ? 'text-papel' : 'text-tinta/55'}`}
                      >
                        {f.pie}
                      </figcaption>
                    )}
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </section>
        );
      })
  }

  <section class="relative overflow-hidden bg-rojo text-amarillo">
    <Estrella tinta="amarilla" alto="abajo" />
    <div class="relative px-4 py-20 sm:px-6 lg:px-10">
      {/* El rótulo se lleva su propio campo amarillo: a 11,5px sobre rojo no
          hay ningún color de la paleta que llegue a 4,5:1. */}
      <p
        class="meta mb-6 inline-block bg-amarillo px-3 py-1.5 text-tinta"
        data-reveal="lado"
      >
        {festival.edicion}
      </p>
      <p
        class="display max-w-4xl text-[9vw] leading-[0.95] lg:text-[5.5vw]"
        data-lineas
        data-reveal="lineas"
      >
        {festival.fechas}
      </p>
      <a
        href={conBase("/programa")}
        class="boton boton--papel mt-10"
        data-reveal="arriba"
      >
        Ver el programa
      </a>
    </div>
  </section>

  {/* Los dos diálogos, fuera de las dos versiones: sirven a las dos. Ver el
      slot `capa` en `Base.astro`. */}
  <Fragment slot="capa">
    <SubirFotos />
    {aportes.length > 0 && <Visor aportes={aportes} />}
  </Fragment>

  <script>
    import '../scripts/galeria.ts';
  </script>
</Base>
