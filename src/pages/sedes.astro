---
/**
 * Las sedes: un tablero de una sola pantalla.
 *
 * No es una página que se recorre, es un instrumento que se mira entero: nada
 * de scroll de página, el plano quieto a la izquierda y, a la derecha, una
 * columna que son dos hojas —la lista de las dieciséis y el «Conoce más» de la
 * elegida—. Elegir una sede no cambia de página, así que nadie pierde dónde
 * estaba: al volver, la lista sigue en el mismo renglón.
 *
 * La página de cada sede sigue existiendo y no es un duplicado: es lo que abre
 * sin JavaScript, lo que indexa Google y lo que se comparte por WhatsApp. Ésta
 * es para decidir a dónde se va esta tarde; aquélla, para contarlo.
 *
 * Lo que tenía la página anterior y aquí no está, con su razón:
 *   · la rejilla de dieciséis tarjetas con nombre, dirección y dos botones —el
 *     plano contesta lo mismo y además contesta «qué cae cerca de qué», que es
 *     lo que una lista de direcciones no puede;
 *   · el encabezado de cartel a 11vw — trescientos píxeles de rótulo antes de
 *     poder ver el instrumento lo partían en dos. El nombre se aprieta en la
 *     cabecera de la lista, que es donde además dice algo;
 *   · el cierre rojo con la ciudad y las fechas — la barra de arriba ya lo dice
 *     y era lo único que obligaba a hacer scroll;
 *   · el pie del sitio — el móvil ya lo esconde en sus pantallas por lo mismo:
 *     una aplicación de una pantalla no tiene pie. Lo imprescindible se queda
 *     en la franja de abajo;
 *   · el recorrido, que estaba en una sección propia: sale dentro del panel de
 *     cada sede, en su día y marcado, que es donde se necesita.
 */
import Base from '../layouts/Base.astro';
import Pantalla from '../components/movil/Pantalla.astro';
import Mapa from '../components/Mapa.astro';
import PanelDeSede from '../components/PanelDeSede.astro';
import { conBase } from '../lib/base';
import {
  agendaPorSede,
  festival,
  privacidad,
  rutaDeSede,
  sedes,
} from '../data/site';
---

<Base
  titulo={sedes.titulo}
  descripcion={`Las ${sedes.lista.length} sedes del ${festival.nombre} en ${festival.ciudad}.`}
>
  {/* ── Móvil: dieciséis puertas, y nada entre el dedo y la sede ────────
      Esto fue un acordeón. Tocar una sede la abría en el sitio y enseñaba su
      dirección y dos botones, y uno de los dos —«Conoce más»— llevaba a la
      página de esa sede… donde está esa misma dirección, ese mismo mapa y
      además el programa. O sea: dos toques, y un desvío por un resumen, para
      llegar a lo que el primer toque ya podía dar entero.

      Ahora la fila ES el enlace. Se toca el nombre y se está en la sede. La
      dirección y el «Cómo llegar» no se pierden —abren allí, en la cabecera
      de la pantalla, que es donde alguien de pie en la calle los busca—. */}
  <Fragment slot="movil">
    <Pantalla
      titulo={sedes.titulo}
      indice="03"
      nota={`${sedes.lista.length} lugares en ${festival.ciudad}`}
      fondo="rojo"
      fondoCuerpo="amarillo"
    >
      {
        sedes.lista.map((sede) => (
          <a href={conBase(rutaDeSede(sede.nombre))} class="sede-fila">
            <span class="display sede-fila-nombre">{sede.nombre}</span>
            {/* La misma punta que la lista del tablero y que el pie del panel:
                quien la ve ya sabe que eso abre algo. */}
            <span class="sede-fila-punta" aria-hidden="true">
              ›
            </span>
          </a>
        ))
      }
    </Pantalla>
  </Fragment>

  {/* ── El tablero ───────────────────────────────────────────────────────
      El plano ocupa la izquierda ENTERA: de debajo de la barra de navegación
      a la franja de abajo, sin banda de rótulo que le corte la cabeza ni pie
      amarillo que le corte los pies. El rótulo de la página se fue a la
      columna de la derecha, encima de la lista, que es donde dice algo. */}
  <div class="tablero-sedes" data-tablero>
    <div class="tablero-cuerpo">
      <Mapa lista="entera" marco="sangre" rotulos="siempre" panel class="h-full">
        {/* El rótulo, ahora cabecera de la lista. Se queda pegado arriba
            mientras corren las dieciséis, y el panel lo tapa entero al
            abrirse porque el panel trae la suya. */}
        <Fragment slot="cabecera">
          <div class="cabecera-lista">
            <p class="flex items-baseline gap-4">
              <span class="display text-3xl leading-none text-amarillo">{sedes.titulo}</span>
              <span class="meta ml-auto text-rojo" data-barra-ahora hidden></span>
            </p>
            <p class="meta mt-2 text-papel/60">
              {sedes.lista.length} lugares · {festival.ciudad} · todo en 2,8 km
            </p>
          </div>
        </Fragment>

        <Fragment slot="panel">
          {agendaPorSede.map((agenda) => <PanelDeSede agenda={agenda} />)}
        </Fragment>
      </Mapa>
    </div>

    {/* La franja: lo que no se puede perder del pie, y nada más. Cuarenta
        píxeles a cambio de que la página no scrollee.

        Aquí estuvo «Y por las dieciséis» con el recorrido. Se cae: la Marcha
        del Arte sale ya DENTRO del panel de cada sede, en su día y marcada
        «Pasa por aquí · todas las sedes», que es donde sirve —cuando estás
        mirando el sábado de Ánima Galería— y no en una banda al pie que se lee
        una vez y estorba dieciséis. */}
    <div class="tablero-franja meta">
      <p class="tablero-legal">
        <a href={conBase('/privacidad')} class="hover:text-amarillo">{privacidad.subtitulo}</a>
        <span class="text-papel/60">{festival.creditoFooter}</span>
      </p>
    </div>
  </div>
</Base>
