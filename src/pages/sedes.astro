---
/**
 * Las sedes.
 *
 * Lo que había era una rejilla de tarjetas: dieciséis nombres con su dirección
 * y dos botones —Instagram y el mapa—. Contestaba «dónde es el festival» y no
 * tenía dónde contestar «qué pasa aquí», que es la otra mitad de la pregunta y
 * la que se hace uno cuando ya sabe que hay catorce sitios y cuatro días.
 *
 * Ahora la página es un tablero: las dieciséis a la izquierda y el programa de
 * la elegida a la derecha, cada sede con su propia dirección
 * (`/sedes/<ranura>`). En el teléfono no hay dos columnas, así que son dos
 * pantallas: ésta es el índice —los dieciséis nombres con lo que hay en cada
 * uno— y cada nombre lleva a la suya.
 *
 * Por qué el tablero y no un pliegue dentro de la tarjeta: No Museo tiene once
 * actividades y cuatro sedes no tienen ninguna. Un pliegue abierto estira su
 * fila de la rejilla hasta mil quinientos píxeles y deja dos columnas de
 * amarillo vacío al lado — se probó, se ve en la maqueta de la que salió esto.
 */
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Estrella from '../components/Estrella.astro';
import Pantalla from '../components/movil/Pantalla.astro';
import TableroSedes from '../components/TableroSedes.astro';
import { conBase } from '../lib/base';
import { sedes, festival, agendaPorSede, programaPublicado, recorridos } from '../data/site';
---

<Base
  titulo={sedes.titulo}
  descripcion={`Las ${sedes.lista.length} sedes del ${festival.nombre} en ${festival.ciudad}, con el programa de cada una.`}
>
  {/* ── Móvil: el índice de las dieciséis ───────────────────────────────
      Cada renglón es un enlace a su pantalla, no un pliegue. El pliegue
      enseñaba la dirección a un toque, que estaba bien cuando la tarjeta era
      todo lo que había; ahora hay una pantalla por sede con la dirección
      arriba, y dejar el pliegue sería poner un paso antes de la puerta. */}
  <Fragment slot="movil">
    <Pantalla
      titulo={sedes.titulo}
      indice="03"
      nota={`${sedes.lista.length} lugares en ${festival.ciudad}`}
      fondo="rojo"
      fondoCuerpo="amarillo"
    >
      {
        agendaPorSede.map((agenda) => (
          <a
            href={conBase(agenda.ruta)}
            class="flex items-center gap-4 border-b-2 border-tinta px-4 py-3"
          >
            <span class="min-w-0">
              <span class="display block text-2xl leading-none">{agenda.sede.nombre}</span>
              {programaPublicado && (
                <span class="meta mt-1 block text-[0.5rem] opacity-50">{agenda.resumen}</span>
              )}
            </span>
            <span class="meta ml-auto shrink-0" aria-hidden="true">→</span>
          </a>
        ))
      }

      <div class="p-4">
        <a href={conBase('/programa')} class="boton">Ver el programa</a>
      </div>
    </Pantalla>
  </Fragment>

  <Encabezado
    indice={`${sedes.titulo} / ${festival.ciudad}`}
    titulo={sedes.titulo}
    fondo="rojo"
  />

  {/* Sin `activa`, el tablero abre la primera. Es lo que hace que esta página
      conteste algo desde el primer píxel en vez de pedir un clic para empezar
      a servir. */}
  <TableroSedes />

  {/* Rojo, amarillo, rojo: la página abre y cierra en la misma tinta. */}
  <section class="relative overflow-hidden border-t-2 border-tinta bg-rojo">
    <Estrella tinta="amarilla" alto="abajo" />
    <div class="relative px-4 py-20 sm:px-6 lg:px-10">
      <p class="meta mb-6 inline-block bg-amarillo px-3 py-1.5 text-tinta" data-reveal="lado">
        {festival.ciudad}
      </p>
      <p
        class="display max-w-4xl text-[9vw] leading-[0.95] text-amarillo lg:text-[5.5vw]"
        data-lineas
        data-reveal="lineas"
      >
        {festival.fechas}
      </p>

      {/* El recorrido se dice también aquí, una vez y en su sitio: dentro de
          cada sede sale marcado —pasa por todas—, pero quien mira la página
          entera tiene que poder enterarse de que existe sin abrir ninguna. */}
      {
        programaPublicado && recorridos.length > 0 && (
          <p class="meta mt-8 max-w-xl text-amarillo/80" data-reveal="arriba">
            {recorridos[0].titulo} · pasa por todas las sedes
          </p>
        )
      }
    </div>
  </section>
</Base>
