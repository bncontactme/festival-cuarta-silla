---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Estrella from '../components/Estrella.astro';
import Pantalla from '../components/movil/Pantalla.astro';
import { sedes, festival, enlaceMapa } from '../data/site';
---

<Base
  titulo={sedes.titulo}
  descripcion={`Las ${sedes.lista.length} sedes del ${festival.nombre} en ${festival.ciudad}.`}
>
  {/* ── Móvil: las ocho a la vez, la dirección a un toque ──────────────── */}
  {/* La cuadrícula de tarjetas de escritorio, en una columna, eran ocho
      pantallas. Aquí lo primero que hace falta es el nombre — «¿cuáles
      son?» —; la dirección y los enlaces sólo importan de la que te
      interesa. */}
  <Fragment slot="movil">
    <Pantalla
      titulo={sedes.titulo}
      indice="03"
      nota={`${sedes.lista.length} lugares en ${festival.ciudad}`}
      fondo="rojo"
      fondoCuerpo="amarillo"
    >
      {
        sedes.lista.map((sede, i) => (
          <details class="plegable">
            <summary>
              <span class="meta bg-amarillo px-1.5 py-0.5 text-[0.6rem] text-tinta">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="display text-2xl leading-none">{sede.nombre}</span>
              <span class="plegable-signo" aria-hidden="true">
                +
              </span>
            </summary>

            <div class="bg-amarillo px-4 py-4 text-tinta">
              <address class="text-sm leading-snug not-italic opacity-70">
                {sede.direccion}
              </address>
              <div class="mt-4 flex divide-x-2 divide-tinta border-2 border-tinta">
                {sede.instagram && (
                  <a
                    href={sede.instagram}
                    target="_blank"
                    rel="noopener"
                    class="meta flex-1 bg-tinta px-3 py-3 text-center text-[0.55rem] font-bold text-amarillo"
                  >
                    {sedes.acciones.conoce} ↗
                  </a>
                )}
                <a
                  href={enlaceMapa(sede)}
                  target="_blank"
                  rel="noopener"
                  class="meta flex-1 bg-rojo px-3 py-3 text-center text-[0.55rem] font-bold text-papel"
                >
                  {sedes.acciones.ubicacion} ↗
                </a>
              </div>
            </div>
          </details>
        ))
      }
    </Pantalla>
  </Fragment>

  <Encabezado
    indice={`${sedes.titulo} / Guadalajara`}
    titulo={sedes.titulo}
    fondo="rojo"
  />

  {/* El campo pasa a amarillo. Tinta sobre amarillo son 15,3:1 — se leen
      mejor que como estaban, en tinta sobre blanco justo debajo de un
      encabezado negro. El blanco sale de aquí porque en este sistema es la
      ventana donde algo tiene que verse de verdad (fotos, logos), y una
      dirección no es ninguna de las dos cosas. */}
  <section class="bg-amarillo">
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3">
      {
        sedes.lista.map((sede, i) => (
          <li
            class="group relative flex flex-col justify-between overflow-hidden border-r-2 border-b-2 border-tinta"
            data-reveal="escala"
            data-retraso={(i % 3) * 90}
          >
            {/* Cortina que sube al pasar el cursor. Es de tinta y no roja: la
                dirección mide 16px y sobre rojo se queda en 4,0:1 en el mejor
                caso, mientras que sobre tinta llega a 15,3:1. El rojo no se
                pierde — vive en la barra de ubicación, que es donde el rojo
                tiene su oficio en esta página: la acción. */}
            <span
              class="absolute inset-0 -z-0 origin-bottom scale-y-0 bg-tinta transition-transform duration-500 ease-[var(--ease-cortina)] group-hover:scale-y-100"
              aria-hidden="true"
            />

            <div class="relative p-6 transition-colors duration-500 group-hover:text-amarillo lg:p-8">
              <p class="meta text-tinta/55 transition-colors duration-500 group-hover:text-amarillo">
                {String(i + 1).padStart(2, '0')}
              </p>

              <h2 class="display mt-4 text-4xl leading-[0.95] lg:text-5xl">
                {sede.nombre}
              </h2>

              <address class="mt-5 min-h-[3.5rem] text-base leading-snug not-italic opacity-70">
                {sede.direccion}
              </address>
            </div>

            {/* Antes esta barra era amarilla o negra según la sede tuviera
                Instagram o no, y de la rejilla salía un damero que nadie
                diseñó. Ahora cada acción tiene una forma fija: conocer es de
                tinta y ubicar es de rojo, con Instagram o sin él. Catorce
                marcas rojas repartidas por la rejilla son el grito de esta
                página — el mismo papel que en la portada hace una banda a
                sangre, aquí repartido en la unidad que se repite. */}
            <div class="relative flex divide-x-2 divide-tinta border-t-2 border-tinta">
              {sede.instagram && (
                <a
                  href={sede.instagram}
                  target="_blank"
                  rel="noopener"
                  class="meta flex-1 bg-tinta px-4 py-4 text-center font-bold text-amarillo transition-colors duration-300 hover:bg-amarillo hover:text-tinta"
                >
                  {sedes.acciones.conoce} ↗
                </a>
              )}
              <a
                href={enlaceMapa(sede)}
                target="_blank"
                rel="noopener"
                class="meta flex-1 bg-rojo px-4 py-4 text-center font-bold text-papel transition-colors duration-300 hover:bg-tinta hover:text-amarillo"
              >
                {sedes.acciones.ubicacion} ↗
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Rojo, amarillo, rojo: la página abre y cierra en la misma tinta y el
      cuerpo va en la otra. La silla en marca de agua se cae — al 20% de rojo
      sobre amarillo salía naranja, un tono que no está en el manual. La
      estrella hace ese trabajo sin inventar ningún color. */}
  <section class="relative overflow-hidden border-t-2 border-tinta bg-rojo">
    <Estrella tinta="amarilla" alto="abajo" />
    <div class="relative px-4 py-20 sm:px-6 lg:px-10">
      <p class="meta mb-6 inline-block bg-amarillo px-3 py-1.5 text-tinta" data-reveal="lado">
        {festival.ciudad}
      </p>
      <p
        class="display max-w-4xl text-[9vw] leading-[0.95] text-amarillo lg:text-[5.5vw]"
        data-lineas
        data-reveal="lineas"
      >
        {festival.fechas}
      </p>
    </div>
  </section>
</Base>
