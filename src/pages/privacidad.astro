---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import { privacidad, festival } from '../data/site';
---

<Base titulo={privacidad.titulo} descripcion={privacidad.cuerpo}>
  <Encabezado
    indice="Legal"
    titulo={privacidad.titulo}
    fondo="hueso"
  />

  <section class="bg-hueso">
    <div class="max-w-3xl px-4 py-20 sm:px-6 lg:px-10 lg:py-24">
      <h2
        class="display text-4xl leading-none text-rojo lg:text-5xl"
        data-reveal="arriba"
      >
        {privacidad.subtitulo}
      </h2>
      <p
        class="mt-8 text-lg leading-relaxed text-tinta/85"
        data-reveal="arriba"
        data-retraso="100"
      >
        {privacidad.cuerpo}
      </p>
      <p class="meta mt-16 border-t-2 border-tinta/20 pt-6 text-tinta/50">
        {festival.creditoFooter}
      </p>
    </div>
  </section>
</Base>
