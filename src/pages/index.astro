---
import Base from '../layouts/Base.astro';
import { conBase } from '../lib/base';
import Marquee from '../components/Marquee.astro';
import Silla from '../components/Silla.astro';
import Mosaico from '../components/Mosaico.astro';
import Portada from '../components/movil/Portada.astro';
import {
  festival,
  manifiesto,
  sedes,
  patrocinadores,
  colaboradores,
  programa,
  enlaceMapa,
  mapaIncrustado,
} from '../data/site';

const cuenta = [
  { campo: 'dias', label: 'Días' },
  { campo: 'horas', label: 'Horas' },
  { campo: 'minutos', label: 'Min' },
  { campo: 'segundos', label: 'Seg' },
] as const;
---

<Base titulo="Inicio">
  <Fragment slot="movil"><Portada /></Fragment>

  <!-- ══ HERO ═══════════════════════════════════════════════════════════ -->
  <section
    class="relative overflow-hidden border-b-2 border-tinta bg-amarillo"
  >
    <div class="cuadricula absolute inset-0 opacity-60" aria-hidden="true"></div>

    <!-- Sillas de fondo, en capas: `.flotador` es el ÁREA por la que puede
         pasear —para la de la derecha, la mitad derecha del hero: el límite
         es donde termina el titular—; `.sigue` es la deriva hacia el cursor
         (JS); `.flota` es el vaivén de agua (CSS, en porcentajes del área); y
         la silla misma lleva la deriva con el scroll.

         Orden de pintado, por orden en el DOM y sin un solo z-index: la
         cuadrícula, encima las sillas, encima el bloque de texto. Nada de
         esto necesita recibir el cursor —quien las mueve es el puntero desde
         la ventana, no el hover—, así que pueden ir debajo del texto sin
         perder el movimiento. -->
    <div
      class="flotador absolute top-0 right-0 h-[64%] w-1/2 opacity-25"
      data-area
      aria-hidden="true"
    >
      <div class="sigue absolute inset-0">
        <!-- El relleno corre el centro de la órbita un 6 % del área hacia la
             derecha: queda más al borde, como estaba antes de darle sitio
             para pasear, y de paso se aleja del límite del titular. -->
        <div class="flota absolute inset-0 grid place-items-center pl-[12%]">
          <Silla variante="roja" deriva class="w-56 rotate-6 xl:w-72" />
        </div>
      </div>
    </div>
    <div
      class="flotador absolute -bottom-16 -left-12 w-32 opacity-20 sm:w-52 lg:w-64"
      aria-hidden="true"
    >
      <div class="sigue">
        <div class="flota flota--b">
          <Silla variante="roja" deriva class="w-full -rotate-12" />
        </div>
      </div>
    </div>

    <div class="relative px-4 pt-3 pb-8 sm:px-6 sm:pt-4 lg:px-10 lg:pt-5">
      <p
        class="meta flex flex-wrap items-center gap-x-4 gap-y-2 text-rojo"
        data-reveal="lado"
      >
        <span class="inline-block h-[2px] w-10 bg-rojo"></span>
        {festival.ciudad}
        <span aria-hidden="true">/</span>
        {festival.anio}
      </p>

      <h1 class="mt-8">
        <span class="sr-only">
          {festival.nombre} — {festival.fechas} — {festival.ciudad}
        </span>

        <span
          class="display block text-[15vw] leading-[0.86] text-rojo"
          aria-hidden="true"
          data-lineas
          data-reveal="lineas"
        >
          Festival
        </span>
        <span
          class="display block text-[15vw] leading-[0.86] text-tinta"
          aria-hidden="true"
          data-lineas
          data-reveal="lineas"
          data-retraso="90"
        >
          de Arte
        </span>
        <span
          class="display block text-[15vw] leading-[0.86] text-rojo"
          aria-hidden="true"
          data-lineas
          data-reveal="lineas"
          data-retraso="180"
        >
          Conceptual
        </span>
      </h1>

      <!-- Franja de datos: fecha + wordmark + CTA -->
      <div
        class="mt-12 grid gap-8 border-t-2 border-tinta pt-8 lg:grid-cols-[1fr_auto] lg:items-end"
      >
        <div data-reveal="arriba">
          <p class="meta mb-3 text-rojo">Cuándo</p>
          <p
            class="font-mono text-xl leading-tight font-bold sm:text-2xl lg:text-3xl"
          >
            {festival.fechas}
          </p>
          <p class="font-mono text-xl leading-tight sm:text-2xl lg:text-3xl">
            {festival.ciudad}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4" data-reveal="arriba" data-retraso="120">
          <a
            href={festival.convocatoriaPDF}
            target="_blank"
            rel="noopener"
            class="boton"
          >
            ★ Convocatoria ★
          </a>
          <a href={conBase("/programa")} class="boton boton--hueso">Programa</a>
        </div>
      </div>
    </div>

    <!-- Cuenta regresiva -->
    <div
      class="relative border-t-2 border-tinta bg-tinta text-hueso"
      data-cuenta={festival.inicioISO}
    >
      <dl class="grid grid-cols-4 divide-x-2 divide-hueso/25">
        {
          cuenta.map(({ campo, label }) => (
            <div class="px-3 py-5 text-center sm:py-7">
              <dd
                class="display display-centro text-[13vw] leading-none text-amarillo sm:text-6xl lg:text-7xl"
                data-campo={campo}
              >
                --
              </dd>
              <dt class="meta mt-3 text-hueso/60">{label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ══ CINTA ══════════════════════════════════════════════════════════ -->
  <Marquee
    items={[
      'Cuarta Silla',
      festival.fechas,
      'Arte Conceptual',
      festival.ciudad,
    ]}
    duracion="40s"
    class="meta border-b-2 border-tinta bg-rojo py-4 text-amarillo"
  />

  {/* ══ MANIFIESTO ═══════════════════════════════════════════════════════
      La sección se queda con lo que se lee de pie: la pregunta. Los tres
      párrafos y el cierre viven en un modal — el manifiesto es para quien
      quiere leerlo, no para que le pase por encima a quien vino a ver fechas.

      Dos bandas, como las secciones del sitio y como el modal: la pregunta
      sobre hueso y, abajo, una franja de tinta a sangre con la tesis y la
      puerta de entrada. Sin esa franja los tres elementos quedaban flotando
      sueltos en una caja gris, que era el problema.

      El diálogo es un `<dialog>` nativo: el foco, la capa superior, Esc y el
      inerte de lo que queda atrás ya vienen resueltos y bien. */}
  <section
    id="manifiesto"
    {/* Borde amarillo: abajo sigue la sección de sedes, que también es
        oscura, y un filete tinta contra tinta no se ve. */}
    class="relative overflow-hidden border-b-2 border-amarillo bg-hueso"
  >
    <Silla
      variante="roja"
      deriva
      class="pointer-events-none absolute -right-16 -top-8 w-56 opacity-[0.09] lg:w-80"
    />

    <div class="relative px-4 pt-16 pb-14 sm:px-6 lg:px-10 lg:pt-20 lg:pb-16">
      <p class="meta mb-8 flex items-center gap-4 text-rojo" data-reveal="lado">
        <span class="inline-block h-[2px] w-12 bg-rojo"></span>
        01 / Manifiesto
      </p>

      {/* Medida corta a propósito: la pregunta se apila en bloque de cartel
          en vez de estirarse en una línea larga y dejar media sección vacía. */}
      <h2
        class="display max-w-[13ch] text-[10vw] leading-[0.95] text-tinta lg:text-[6.5vw]"
        data-lineas
        data-reveal="lineas"
      >
        {manifiesto.titulo}
      </h2>
    </div>

    {/* La tesis es la misma frase con la que cierra el modal: se ve el
        reclamo, se lee el argumento y se vuelve a salir por el reclamo. */}
    <div class="relative border-t-2 border-tinta bg-tinta text-hueso">
      <div
        class="flex flex-wrap items-center justify-between gap-x-10 gap-y-6 px-4 py-8 sm:px-6 lg:px-10"
      >
        <p
          class="max-w-2xl font-mono text-base leading-snug font-bold text-amarillo sm:text-lg"
          data-reveal="arriba"
        >
          {manifiesto.cierre}
        </p>

        <button
          type="button"
          class="boton boton--hueso shrink-0"
          data-abre="manifiesto"
          data-reveal="arriba"
          data-retraso="120"
        >
          Leer el manifiesto ↗
        </button>
      </div>
    </div>
  </section>

  {/* El modal es una mini-página, no una tarjeta: tres bandas a sangre
      —cabecera roja, cuerpo hueso, remate tinta— con los mismos filetes de
      2 px que separan las secciones del sitio. */}
  <dialog
    class="modal"
    data-modal="manifiesto"
    aria-labelledby="modal-manifiesto-titulo"
  >
    {/* La ✕ cuelga del diálogo y no de la caja que scrollea: así no se va
        con el texto. */}
    <button type="button" class="modal-cerrar" data-cierra aria-label="Cerrar">
      ✕
    </button>

    {/* `data-lenis-prevent`: sin eso la rueda dentro del modal se la queda
        Lenis y mueve la página de atrás en lugar del texto. */}
    <div class="modal-caja" data-lenis-prevent>
      <header class="modal-cabecera">
        <div class="cuadricula absolute inset-0 opacity-40" aria-hidden="true">
        </div>
        <p class="meta relative mb-6">01 / Manifiesto</p>
        <h2
          id="modal-manifiesto-titulo"
          class="display relative max-w-[16ch] text-[8vw] leading-[0.92] sm:text-[5.5vw] lg:text-[3.4vw]"
        >
          {manifiesto.titulo}
        </h2>
      </header>

      {/* Numerados: son tres argumentos encadenados, no tres párrafos
          sueltos, y el número lo dice sin tener que escribirlo. */}
      <ol class="modal-parrafos">
        {
          manifiesto.parrafos.map((parrafo, i) => (
            <li>
              <span class="modal-numero" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p>{parrafo}</p>
            </li>
          ))
        }
      </ol>

      <figure class="modal-cierre">
        <blockquote>{manifiesto.cierre}</blockquote>
      </figure>
    </div>
  </dialog>

  <!-- ══ SEDES ══════════════════════════════════════════════════════════ -->
  <section class="border-b-2 border-amarillo bg-pizarra text-hueso">
    <div class="px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <div
        class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-hueso/25 pb-8"
      >
        <div>
          <p
            class="meta mb-6 flex items-center gap-4 text-amarillo"
            data-reveal="lado"
          >
            <span class="inline-block h-[2px] w-12 bg-amarillo"></span>
            02 / {sedes.titulo}
          </p>
          <h2
            class="display text-[13vw] leading-[0.82] text-hueso lg:text-[8vw]"
            data-lineas
            data-reveal="lineas"
          >
            {sedes.titulo}
          </h2>
        </div>
        <a href={conBase("/sedes")} class="boton" data-reveal="arriba">Ver las {sedes.lista.length}</a>
      </div>

      {/* Mapa a la izquierda, lista a la derecha. El iframe no se carga
          hasta que alguien elige una sede: catorce mapas de Google al entrar
          serían catorce peticiones a un tercero que nadie pidió. */}
      <div class="mt-10">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-12">
        <!-- ── Mapa ───────────────────────────────────────────────────── -->
        <div
          class="relative flex h-[55vh] flex-col border-2 border-hueso/25 lg:h-[60vh]"
        >
          {/* Columna flexible: al aparecer el pie, el mapa cede alto en vez
              de estirar el marco. */}
          <div class="relative flex-1 overflow-hidden bg-pizarra">
            <!-- Lo que se ve antes de elegir -->
            <div
              class="absolute inset-0 grid place-items-center px-8 text-center"
              data-mapa-vacio
            >
              <div
                class="cuadricula absolute inset-0 opacity-25"
                aria-hidden="true"
              >
              </div>
              <Silla
                variante="roja"
                class="absolute -bottom-10 -left-10 w-48 opacity-20 lg:w-60"
              />
              <p class="meta relative max-w-xs leading-relaxed text-hueso/60">
                {sedes.acciones.sinMapa}
              </p>
            </div>

            <iframe
              class="absolute inset-0 h-full w-full border-0"
              title={`Mapa de las sedes del ${festival.nombre}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              hidden
              data-mapa></iframe>
          </div>

          <!-- Pie: qué se está viendo -->
          <div
            class="flex shrink-0 flex-wrap items-center justify-between gap-4 border-t-2 border-hueso/25 bg-amarillo px-5 py-4 text-tinta"
            hidden
            data-mapa-pie
          >
            <div>
              <p class="display text-xl leading-none" data-mapa-nombre></p>
              <address
                class="mt-2 text-sm leading-snug not-italic opacity-70"
                data-mapa-direccion></address>
            </div>
            <a
              class="meta border-2 border-tinta bg-tinta px-4 py-2.5 text-[0.6rem] font-bold text-amarillo transition-colors duration-300 hover:bg-amarillo hover:text-tinta"
              target="_blank"
              rel="noopener"
              data-mapa-enlace
            >
              {sedes.acciones.ubicacion} ↗
            </a>
          </div>
        </div>

        {/* ── Lista ────────────────────────────────────────────────────
            Scrollea por dentro, al alto del mapa, pero **no desde el
            principio**: hasta que la caja no se ve entera queda bloqueada. Si
            no, al bajar por la portada la rueda cae dentro de la lista con
            media sección todavía fuera de cuadro y la página se queda
            trabada — el usuario cree que el sitio se rompió.
            `data-lenis-prevent` es lo que hace que, ya desbloqueada, la rueda
            mueva la lista y no la página: Lenis captura el scroll de toda la
            ventana y sin eso esta caja no se entera. */}
        <ul
          class="lista-sedes h-[55vh] border-t-2 border-hueso/25 pr-3 lg:h-[60vh]"
          data-lista-sedes
          data-lenis-prevent
        >
          {
            sedes.lista.map((sede, i) => (
              <li
                class="fila-sede flex items-center gap-4 border-b border-hueso/20"
                data-reveal="arriba"
                data-retraso={Math.min(i, 8) * 50}
              >
                {/* La fila entera elige la sede: el objetivo es la franja,
                    no un enlace de dos palabras. */}
                <button
                  type="button"
                  class="group flex flex-1 items-baseline gap-x-5 py-3.5 text-left"
                  aria-pressed="false"
                  data-sede
                  data-nombre={sede.nombre}
                  data-direccion={sede.direccion}
                  data-incrustado={mapaIncrustado(sede)}
                  data-enlace={enlaceMapa(sede)}
                >
                  <span class="meta w-8 shrink-0 text-hueso/40 transition-colors group-hover:text-amarillo">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="display truncate text-2xl leading-none transition-colors group-hover:text-amarillo">
                    {sede.nombre}
                  </span>
                </button>

                {sede.instagram && (
                  <a
                    href={sede.instagram}
                    target="_blank"
                    rel="noopener"
                    class="meta shrink-0 text-[0.6rem] text-hueso/40 transition-colors duration-300 hover:text-amarillo"
                  >
                    IG ↗
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      </div>
    </div>
  </section>

  <!-- ══ PROGRAMA (adelanto) ════════════════════════════════════════════ -->
  <section class="border-b-2 border-tinta bg-amarillo">
    <div class="px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <p class="meta mb-8 flex items-center gap-4 text-rojo" data-reveal="lado">
        <span class="inline-block h-[2px] w-12 bg-rojo"></span>
        03 / {programa.titulo}
      </p>

      <div
        class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-end"
      >
        <h2
          class="display text-[15vw] leading-[0.95] text-tinta lg:text-[9vw]"
          data-reveal="arriba"
        >
          {programa.titulo}
          <span class="block text-rojo">{programa.estado}</span>
        </h2>

        <div data-reveal="arriba">
          <ul class="mb-8 divide-y-2 divide-tinta border-y-2 border-tinta">
            {
              programa.dias.map((d) => (
                <li class="flex items-baseline justify-between gap-4 py-3">
                  <span class="font-mono text-base font-bold sm:text-lg">
                    {d.dia}
                  </span>
                  <span class="meta text-tinta/60">{d.fecha}</span>
                </li>
              ))
            }
          </ul>
          <a href={conBase("/programa")} class="boton">Ver el programa</a>
        </div>
      </div>
    </div>
  </section>

  {/* ══ PATROCINADORES → COLABORADORES ═══════════════════════════════════
      Una sola sección con dos caras. Al terminar el turno de un grupo cambia
      la luz —fondo hueso ↔ pizarra, acento rojo ↔ amarillo—, el título y el
      número; el relevo va en tres tiempos para que no se lea como un
      parpadeo (ver el guion al pie).

      El turno no dura lo que dura la vuelta de la cinta. Trece logos en una
      fila son casi un minuto de recorrido, y esperar eso para ver un cambio
      de color es demasiado. Así que el turno es corto y fijo, y la cinta,
      cuando le toca esconderse, se queda **en pausa donde iba**: al volver
      sigue desde ahí y no desde el principio. Por eso no se pierde ninguna
      marca aunque el turno se corte a media pasada — sólo que se ven en dos o
      tres vueltas en vez de una. */}
  {
    (() => {
      const PASO = 224; // ancho del mosaico más su separación
      const VELOCIDAD = 55; // px/s: ritmo de mirar un logo, no de un ticker

      const grupos = [
        { clave: 'patrocinadores', indice: '04', datos: patrocinadores, turno: 20000 },
        { clave: 'colaboradores', indice: '05', datos: colaboradores, turno: 10000 },
      ];

      return (
        <section
          class="cinta-marcas overflow-hidden border-b-2"
          data-cinta
          data-dormida
          data-grupo="patrocinadores"
        >
          <div class="cinta-cabecera px-4 pt-20 pb-10 sm:px-6 lg:px-10">
            <p class="meta cinta-acento mb-8 flex items-center gap-4">
              <span class="inline-block h-[2px] w-12 bg-current" />
              <span data-rotulo>04 / {patrocinadores.titulo}</span>
            </p>
            <h2
              class="display text-[11vw] leading-[0.82] lg:text-[6vw]"
              data-titulo
            >
              {patrocinadores.titulo}
            </h2>
          </div>

          {/* Los dos grupos comparten celda: el que no toca se apaga sin
              salirse del flujo, así la sección no da un salto de alto. */}
          <div class="cinta-pista pb-20">
            {grupos.map(({ clave, indice, datos, turno }, n) => {
              // La unidad tiene que pasar el ancho de una pantalla ancha: si
              // no, la cinta deja un hueco a media vuelta. Con cinco logos eso
              // significa repetir la tanda.
              const repes = Math.max(1, Math.ceil(1500 / PASO / datos.lista.length));
              const unidad = Array.from({ length: repes }, () => datos.lista).flat();
              const duracion = ((unidad.length * PASO) / VELOCIDAD).toFixed(1);
              return (
                <div
                  class="grupo-marcas"
                  data-oculto={n === 0 ? undefined : ''}
                  data-grupo-nombre={clave}
                  data-indice={indice}
                  data-titulo-grupo={datos.titulo}
                  data-espera={turno}
                >
                  <p class="meta rotulo-grupo px-4 pb-4 sm:px-6 lg:px-10">
                    {indice} / {datos.titulo}
                  </p>
                  <div class="overflow-hidden" role="marquee">
                    <div class="marquee" style={`--duracion: ${duracion}s`}>
                      {[0, 1].map((copia) => (
                        <div class="flex shrink-0" aria-hidden={copia === 1}>
                          {unidad.map((marca) => (
                            <Mosaico marca={marca} class="mr-4" />
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      );
    })()
  }

  <!-- ══ CIERRE ═════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-rojo text-amarillo">
    <div
      class="relative px-4 py-24 text-center sm:px-6 lg:px-10 lg:py-32"
    >
      <img
        src={conBase("/logos/wordmark-amarilla.svg")}
        alt="Cuarta Silla"
        width="533"
        height="85"
        class="mx-auto w-[78vw] lg:w-[54vw]"
        data-reveal="escala"
      />
      <p class="meta mt-6 text-amarillo/80" data-reveal="arriba">
        {festival.fechas} · {festival.ciudad}
      </p>
      <div class="mt-12 flex flex-wrap justify-center gap-4" data-reveal="arriba" data-retraso="120">
        <a
          href={festival.convocatoriaPDF}
          target="_blank"
          rel="noopener"
          class="boton boton--hueso"
        >
          ★ Convocatoria ★
        </a>
        <a href={conBase("/registro")} class="boton boton--hueso">Registro a eventos</a>
      </div>
    </div>
  </section>


  <script>
    /** El mapa se llena al elegir una sede — antes no existe. */
    const mapa = document.querySelector('[data-mapa]');
    const vacio = document.querySelector('[data-mapa-vacio]');
    const pie = document.querySelector('[data-mapa-pie]');
    const nombre = document.querySelector('[data-mapa-nombre]');
    const direccion = document.querySelector('[data-mapa-direccion]');
    const enlace = document.querySelector('[data-mapa-enlace]');
    const filas = document.querySelectorAll('[data-sede]');

    if (mapa instanceof HTMLIFrameElement && filas.length) {
      for (const fila of filas) {
        fila.addEventListener('click', () => {
          for (const otra of filas) {
            otra.setAttribute('aria-pressed', 'false');
            otra.closest('.fila-sede')?.classList.remove('sede-activa');
          }
          fila.setAttribute('aria-pressed', 'true');
          fila.closest('.fila-sede')?.classList.add('sede-activa');

          mapa.src = fila.dataset.incrustado ?? '';
          mapa.hidden = false;
          if (vacio instanceof HTMLElement) vacio.hidden = true;
          if (pie instanceof HTMLElement) pie.hidden = false;
          if (nombre) nombre.textContent = fila.dataset.nombre ?? '';
          if (direccion) direccion.textContent = fila.dataset.direccion ?? '';
          if (enlace instanceof HTMLAnchorElement) {
            enlace.href = fila.dataset.enlace ?? '';
          }

          // En una ventana angosta el mapa queda arriba, fuera de vista.
          if (!window.matchMedia('(width >= 64rem)').matches) {
            mapa.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      }
    }
  </script>

  <script>
    /** La cinta de marcas alterna entre patrocinadores y colaboradores.
     *
     * No arranca hasta que la sección asoma, y al salir de cuadro vuelve a
     * dormirse en patrocinadores: quien baja hasta acá la encuentra siempre
     * empezada por el principio, no a mitad de un turno que corrió solo
     * mientras nadie miraba.
     *
     * La cinta que se apaga queda **en pausa donde iba**, no se saca del
     * flujo: con `display: none` la animación volvería a empezar de cero cada
     * vez y las últimas marcas no se verían nunca.
     *
     * El relevo va en tres tiempos: primero cambia la luz —el color de la
     * sección, que tarda más y arranca antes—, después se va el grupo que
     * estaba y recién ahí, con la cinta tapada, se cambia el título. Cambiar
     * las tres cosas en el mismo cuadro es lo que se veía como un parpadeo.
     */
    const cinta = document.querySelector('[data-cinta]');
    if (cinta) {
      const grupos = [...cinta.querySelectorAll('[data-grupo-nombre]')] as HTMLElement[];
      const cabecera = cinta.querySelector('.cinta-cabecera');
      const titulo = cinta.querySelector('[data-titulo]');
      const rotulo = cinta.querySelector('[data-rotulo]');
      const SALIDA = 420;
      let actual = 0;
      let mudando = false;
      let reloj: ReturnType<typeof setTimeout> | undefined;

      const armarTurno = (g: HTMLElement) => {
        clearTimeout(reloj);
        reloj = setTimeout(cambiar, Number(g.dataset.espera ?? 12000));
      };

      function cambiar() {
        if (mudando) return;
        mudando = true;
        clearTimeout(reloj);

        const saliente = grupos[actual];
        actual = (actual + 1) % grupos.length;
        const entrante = grupos[actual];

        cinta.setAttribute('data-grupo', entrante.dataset.grupoNombre ?? '');
        saliente.dataset.estado = 'saliendo';
        if (cabecera instanceof HTMLElement) cabecera.dataset.estado = 'saliendo';

        setTimeout(() => {
          saliente.dataset.oculto = '';
          delete saliente.dataset.estado;

          const nombre = entrante.dataset.tituloGrupo ?? '';
          if (titulo) titulo.textContent = nombre;
          if (rotulo) rotulo.textContent = `${entrante.dataset.indice} / ${nombre}`;
          if (cabecera instanceof HTMLElement) delete cabecera.dataset.estado;

          delete entrante.dataset.oculto;
          entrante.dataset.estado = 'entrando';
          setTimeout(() => delete entrante.dataset.estado, 800);
          armarTurno(entrante);
          mudando = false;
        }, SALIDA);
      }

      /** Vuelta a foja cero: primer grupo, sin turnos corriendo. */
      const dormir = () => {
        clearTimeout(reloj);
        mudando = false;
        actual = 0;
        grupos.forEach((g, i) => {
          delete g.dataset.estado;
          if (i === 0) delete g.dataset.oculto;
          else g.dataset.oculto = '';
        });
        cinta.setAttribute('data-grupo', grupos[0].dataset.grupoNombre ?? '');
        const nombre = grupos[0].dataset.tituloGrupo ?? '';
        if (titulo) titulo.textContent = nombre;
        if (rotulo) rotulo.textContent = `${grupos[0].dataset.indice} / ${nombre}`;
        cinta.setAttribute('data-dormida', '');
      };

      // Sin animación no hay turnos: se muestran los dos grupos, cada uno con
      // su rótulo, y nadie cambia nada solo.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        cinta.setAttribute('data-quieta', 'si');
        cinta.removeAttribute('data-dormida');
        grupos.forEach((g) => delete g.dataset.oculto);
      } else {
        const ojo = new IntersectionObserver(
          ([entrada]) => {
            if (entrada.isIntersecting) {
              cinta.removeAttribute('data-dormida');
              armarTurno(grupos[actual]);
            } else {
              dormir();
            }
          },
          // Umbral 0: arranca en cuanto el borde de arriba entra en cuadro.
          { threshold: 0 },
        );
        ojo.observe(cinta);
      }
    }
  </script>

  <script>
    /** La lista de sedes no se puede scrollear hasta verse entera.
     *
     * Una caja con scroll propio a media pantalla es una trampa: la rueda
     * cae adentro cuando todavía falta bajar, la página deja de moverse y
     * parece rota. Se desbloquea cuando la caja está completa en cuadro
     * —y ahí aparece la barra, que es el aviso de que ahora sí se mueve.
     */
    const lista = document.querySelector('[data-lista-sedes]');
    if (lista) {
      const ojo = new IntersectionObserver(
        ([entrada]) => {
          lista.toggleAttribute('data-suelta', entrada.isIntersecting);
        },
        // 0.99 y no 1: con alturas en `vh` el redondeo a subpíxel puede dejar
        // el umbral exacto sin cumplirse nunca.
        { threshold: 0.99 },
      );
      ojo.observe(lista);
    }
  </script>
</Base>
