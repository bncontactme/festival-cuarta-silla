---
import Base from '../layouts/Base.astro';
import { conBase } from '../lib/base';
import Marquee from '../components/Marquee.astro';
import Silla from '../components/Silla.astro';
import Estrella from '../components/Estrella.astro';
import Mosaico from '../components/Mosaico.astro';
import Portada from '../components/movil/Portada.astro';
import Gantt from '../components/Gantt.astro';
import AvisoPrograma from '../components/AvisoPrograma.astro';
import Mapa from '../components/Mapa.astro';
import {
  festival,
  convocatoriaVoluntarixs,
  manifiesto,
  sedes,
  patrocinadores,
  programa,
  programaPublicado,
} from '../data/site';

const cuenta = [
  { campo: 'dias', label: 'Días' },
  { campo: 'horas', label: 'Horas' },
  { campo: 'minutos', label: 'Min' },
  { campo: 'segundos', label: 'Seg' },
] as const;

/* Collage de Sedes. Las posiciones están compuestas a mano: no hay azar ni
   espejo (el respaldo lleva texto y voltearlo lo dejaría al revés). */
const sillasSedes = [
  { x: -7, y: 48, ancho: 18, giro: -10, opa: 0.11 },
  { x: 10, y: -6, ancho: 15, giro: 7, opa: 0.09 },
  { x: 27, y: 55, ancho: 14, giro: -4, opa: 0.075 },
  { x: 40, y: 12, ancho: 13, giro: 9, opa: 0.08 },
  { x: 54, y: -14, ancho: 18, giro: -7, opa: 0.095 },
  { x: 70, y: 49, ancho: 16, giro: 6, opa: 0.08 },
  { x: 85, y: 8, ancho: 14, giro: -5, opa: 0.085 },
  { x: 96, y: 52, ancho: 18, giro: 10, opa: 0.1 },
  { x: 19, y: 28, ancho: 9, giro: -11, opa: 0.055 },
  { x: 62, y: 31, ancho: 10, giro: 4, opa: 0.055 },
] as const;
---

<Base titulo="Inicio">
  <Fragment slot="movil"><Portada /></Fragment>

  <!-- ══ HERO ═══════════════════════════════════════════════════════════ -->
  <section
    class="relative overflow-hidden border-b-2 border-tinta bg-amarillo"
  >
    <div class="cuadricula absolute inset-0 opacity-60" aria-hidden="true"></div>

    <!-- Sillas de fondo, en capas: `.flotador` es el ÁREA por la que puede
         pasear —para la de la derecha, la mitad derecha del hero: el límite
         es donde termina el titular—; `.sigue` es la deriva hacia el cursor
         (JS); `.flota` es el vaivén de agua (CSS, en porcentajes del área); y
         la silla misma lleva la deriva con el scroll.

         Orden de pintado, por orden en el DOM y sin un solo z-index: la
         cuadrícula, encima las sillas, encima el bloque de texto. Nada de
         esto necesita recibir el cursor —quien las mueve es el puntero desde
         la ventana, no el hover—, así que pueden ir debajo del texto sin
         perder el movimiento. -->
    {/* Las sillas van en rojo, la tinta del festival, como marca de agua con
        color: sin `brightness(0)` —que las dejaba negras y apagadas—. */}
    <div
      class="flotador absolute top-0 right-0 h-[64%] w-1/2 opacity-[0.22]"
      data-area
      aria-hidden="true"
    >
      <div class="sigue absolute inset-0">
        <!-- El relleno corre el centro de la órbita un 6 % del área hacia la
             derecha: queda más al borde, como estaba antes de darle sitio
             para pasear, y de paso se aleja del límite del titular. -->
        <div class="flota absolute inset-0 grid place-items-center pl-[12%]">
          <Silla variante="roja" deriva class="w-56 rotate-6 xl:w-72" />
        </div>
      </div>
    </div>
    <div
      class="flotador absolute -bottom-16 -left-12 w-32 opacity-[0.22] sm:w-52 lg:w-64"
      aria-hidden="true"
    >
      <div class="sigue">
        <div class="flota flota--b">
          <Silla variante="roja" deriva class="w-full -rotate-12" />
        </div>
      </div>
    </div>

    <div class="relative px-4 pt-3 pb-8 sm:px-6 sm:pt-4 lg:px-10 lg:pt-5">
      <p
        class="meta flex flex-wrap items-center gap-x-4 gap-y-2 text-tinta"
        data-reveal="lado"
      >
        <span class="inline-block h-[2px] w-10 bg-rojo"></span>
        {festival.ciudad}
        <span aria-hidden="true">/</span>
        {festival.anio}
      </p>

      {/* `12.55vw` mide el titular por el ancho de la ventana y se olvida del
          alto: en una pantalla ancha y baja las tres líneas no caben y
          «CONCEPTUAL» entra cortada por el canto. El `min()` le pone techo
          —lo que quede de alto entre la barra y el pie de la pantalla— y sólo
          actúa ahí; en el resto sigue mandando el 15vw de siempre. */}
      <h1 class="mt-8">
        <span class="sr-only">
          {festival.nombre} — {festival.fechas} — {festival.ciudad}
        </span>

        <span
          class="display block text-[min(12.55vw,calc((100svh-8.5rem)/3.08))] leading-[0.86] text-rojo xl:text-[min(12.9vw,calc((100svh-8.5rem)/2.98))]"
          aria-hidden="true"
          data-lineas
          data-reveal="lineas"
        >
          Festival
        </span>
        <span
          class="display block text-[min(12.55vw,calc((100svh-8.5rem)/3.08))] leading-[0.86] text-tinta xl:text-[min(12.9vw,calc((100svh-8.5rem)/2.98))]"
          aria-hidden="true"
          data-lineas
          data-reveal="lineas"
          data-retraso="90"
        >
          de Arte
        </span>
        <span
          class="display block text-[min(12.55vw,calc((100svh-8.5rem)/3.08))] leading-[0.86] text-rojo xl:text-[min(12.9vw,calc((100svh-8.5rem)/2.98))]"
          aria-hidden="true"
          data-lineas
          data-reveal="lineas"
          data-retraso="180"
        >
          Conceptual
        </span>
      </h1>

      <!-- Franja de datos: fecha + wordmark + CTA -->
      <div
        class="mt-14 grid gap-8 border-t-2 border-tinta pt-8 lg:grid-cols-[1fr_auto] lg:items-end"
      >
        <div data-reveal="arriba">
          {/* En tinta, no en rojo: 11,5px de rojo sobre amarillo son 3,67:1.
              El rojo se queda en los filetes y en los campos, que no son
              texto y pueden ir a cualquier tamaño. */}
          <p class="meta mb-3 text-tinta">Cuándo</p>
          <p
            class="font-mono text-xl leading-tight font-bold sm:text-2xl lg:text-3xl"
          >
            {festival.fechas}
          </p>
          <p class="font-mono text-xl leading-tight sm:text-2xl lg:text-3xl">
            {festival.ciudad}
          </p>
        </div>

        {/* La convocatoria de voluntarixs es la acción principal de este
            bloque. Artistas conserva su puerta propia en la navegación. */}
        <div class="flex flex-wrap items-center gap-4" data-reveal="arriba" data-retraso="120">
          <a
            href={convocatoriaVoluntarixs.href}
            target="_blank"
            rel="noopener"
            class="boton whitespace-nowrap px-4"
          >
            {convocatoriaVoluntarixs.label}
          </a>
          <a href={conBase("/programa")} class="boton boton--papel">Programa</a>
        </div>
      </div>
    </div>

    <!-- Cuenta regresiva -->
    <div
      class="relative border-t-2 border-tinta bg-tinta text-papel"
      data-cuenta={festival.inicioISO}
    >
      <dl class="grid grid-cols-4 divide-x-2 divide-papel/25">
        {
          cuenta.map(({ campo, label }) => (
            <div class="px-3 py-5 text-center sm:py-7">
              <dd
                class="display display-centro text-[13vw] leading-none text-amarillo sm:text-6xl lg:text-7xl"
                data-campo={campo}
              >
                --
              </dd>
              <dt class="meta mt-3 text-papel/55">{label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ══ CINTA ══════════════════════════════════════════════════════════ -->
  <Marquee
    items={[
      'Cuarta Silla',
      festival.fechas,
      'Arte Conceptual',
      festival.ciudad,
    ]}
    duracion="40s"
    class="meta border-b-2 border-tinta bg-rojo py-4 text-amarillo"
  />

  {/* ══ MANIFIESTO ═══════════════════════════════════════════════════════
      Una sola banda, baja y limpia: rótulo, pregunta y puerta. Nada más.
      El manifiesto entero —los tres párrafos y el cierre— vive en el modal;
      repetir aquí la tesis en una franja oscura duplicaba el texto y le daba
      a la sección el doble de alto del que necesita para decir lo que dice.

      Es el respiro entre la cuenta regresiva y las sedes: si esta sección
      pesa lo mismo que ellas, la portada se vuelve una sucesión de bloques
      del mismo tamaño y ninguno destaca.

      El diálogo es un `<dialog>` nativo: el foco, la capa superior, Esc y el
      inerte de lo que queda atrás ya vienen resueltos y bien. */}
  <section
    id="manifiesto"
    {/* Borde amarillo: abajo sigue la sección de sedes, que también es
        oscura, y un filete tinta contra tinta no se ve. */}
    class="relative overflow-hidden border-b-2 border-tinta bg-rojo"
  >
    {/* La estrella sustituye a la silla en marca de agua. La silla iba al 10%
        de rojo sobre blanco, que es un rosa: sobre papel una trama de una
        tinta sigue siendo esa tinta, así que era legítima — pero ahora el
        campo es rojo y una trama de rojo sobre rojo no existe. La estrella
        entra en la tinta contraria, a plena fuerza, que es como entra en el
        feed: en ocho de sus doce posts. */}
    <Estrella tinta="amarilla" alto="centro" />

    {/* Alineadas por abajo: el botón se apoya en la última línea de la
        pregunta, no flota a media altura. En columna estrecha se apila y el
        botón queda debajo, que es el orden en que se lee de todos modos. */}
    <div
      class="relative flex flex-wrap items-end justify-between gap-x-10 gap-y-8 px-4 py-12 sm:px-6 lg:px-10 lg:py-14"
    >
      <div>
        <p
          class="meta mb-5 inline-block bg-amarillo px-3 py-1.5 text-tinta"
          data-reveal="lado"
        >
          01 / Manifiesto
        </p>

        {/* Dos líneas, no cuatro: apilada en columna estrecha la pregunta
            ocupaba un cuarto del ancho y dejaba un socavón de aire entre el
            titular y el botón. Con la medida ancha llena la mitad izquierda
            de la banda y la sección baja de alto, que es de lo que se
            trata. */}
        <h2
          class="display max-w-[20ch] text-[9vw] leading-[0.95] text-amarillo lg:text-[4.4vw]"
          data-lineas
          data-reveal="lineas"
        >
          {manifiesto.titulo}
        </h2>

        {/* La tesis, que antes iba en la franja oscura, aquí de subtítulo:
            misma frase con la que cierra el modal —se ve el reclamo, se lee
            el argumento y se vuelve a salir por el reclamo— pero a cuerpo de
            pie de foto y en la misma banda, sin fondo propio ni segundo
            bloque a sangre. */}
        <p
          class="mt-6 max-w-[54ch] font-mono text-sm leading-relaxed text-papel lg:text-[0.95rem]"
          data-reveal="arriba"
          data-retraso="80"
        >
          {manifiesto.cierre}
        </p>
      </div>

      <button
        type="button"
        class="boton boton--amarillo shrink-0"
        data-abre="manifiesto"
        data-reveal="arriba"
        data-retraso="120"
      >
        Leer el manifiesto ↗
      </button>
    </div>
  </section>

  {/* El modal es una mini-página, no una tarjeta: tres bandas a sangre
      —cabecera roja, cuerpo papel, remate tinta— con los mismos filetes de
      2 px que separan las secciones del sitio. */}
  <dialog
    class="modal"
    data-modal="manifiesto"
    aria-labelledby="modal-manifiesto-titulo"
  >
    {/* La ✕ cuelga del diálogo y no de la caja que scrollea: así no se va
        con el texto. */}
    <button type="button" class="modal-cerrar" data-cierra aria-label="Cerrar">
      ✕
    </button>

    {/* `data-lenis-prevent`: sin eso la rueda dentro del modal se la queda
        Lenis y mueve la página de atrás en lugar del texto. */}
    <div class="modal-caja" data-lenis-prevent>
      <header class="modal-cabecera">
        <div class="cuadricula absolute inset-0 opacity-40" aria-hidden="true">
        </div>
        <p class="meta relative mb-6">01 / Manifiesto</p>
        <h2
          id="modal-manifiesto-titulo"
          class="display relative max-w-[16ch] text-[8vw] leading-[0.92] sm:text-[5.5vw] lg:text-[3.4vw]"
        >
          {manifiesto.titulo}
        </h2>
      </header>

      {/* Numerados: son tres argumentos encadenados, no tres párrafos
          sueltos, y el número lo dice sin tener que escribirlo. */}
      <ol class="modal-parrafos">
        {
          manifiesto.parrafos.map((parrafo, i) => (
            <li>
              <span class="modal-numero" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p>{parrafo}</p>
            </li>
          ))
        }
      </ol>

      <figure class="modal-cierre">
        <blockquote>{manifiesto.cierre}</blockquote>
      </figure>
    </div>
  </dialog>

  <!-- ══ SEDES ══════════════════════════════════════════════════════════ -->
  {/* El campo pasa a amarillo y el plano se queda negro — pero como TARJETA
      puesta encima, no como sección. Es la diferencia que ordena todo el
      sistema: el negro es tinta y objeto, nunca superficie del alto de una
      pantalla. Antes esta sección eran 928px de negro corrido, el bloque más
      grande de la portada. */}
  <section class="relative overflow-hidden border-b-2 border-tinta bg-amarillo">
    {/* Un collage editorial, no un patrón: pocas sillas grandes, recortadas
        por los cantos y colocadas a mano para enmarcar el contenido. */}
    <div class="sedes-sillas absolute inset-0" aria-hidden="true">
      {
        sillasSedes.map((silla) => (
          <Silla
            variante="roja"
            class="silla-sede"
            style={`--x:${silla.x}%;--y:${silla.y}%;--ancho:${silla.ancho}vw;--giro:${silla.giro}deg;--opa:${silla.opa};`}
          />
        ))
      }
    </div>
    <div class="relative px-4 pt-12 pb-14 sm:px-6 lg:px-10 lg:pt-16 lg:pb-16">
      <div
        class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-tinta pb-8"
      >
        <div>
          <p
            class="meta mb-6 flex items-center gap-4 text-tinta"
            data-reveal="lado"
          >
            <span class="inline-block h-[2px] w-12 bg-rojo"></span>
            02 / {sedes.titulo}
          </p>
          {/* De 8vw a 4,5vw. Los titulares del feed miden un 8–10% del alto
              del lienzo; a 8vw éste medía casi un cuarto de la sección. La
              jerarquía entre secciones ya no la lleva el cuerpo — la lleva el
              cambio de campo. */}
          <h2
            class="display text-[9vw] leading-[0.9] text-tinta lg:text-[4.5vw]"
            data-lineas
            data-reveal="lineas"
          >
            {sedes.titulo}
          </h2>
        </div>
        <a href={conBase("/sedes")} class="boton" data-reveal="arriba">Ver las {sedes.lista.length}</a>
      </div>

      {/* Plano a la izquierda, lista a la derecha: son un solo
          instrumento, así que viven en un solo componente. */}
      <Mapa class="mt-8" />
    </div>
  </section>

  <!-- ══ PROGRAMA (adelanto) ════════════════════════════════════════════ -->
  {/* La misma cabecera que Sedes: rótulo, titular y puerta apoyados en un
      filete de 2 px. Antes el titular iba a 9vw —el mayor de la página
      después del hero, para una sección de adelanto— y el botón colgaba al
      pie de la columna derecha. Entre las dos cosas esto era un cartel
      enorme con dos cajitas flotando en un charco de amarillo. */}
  {/* Rojo: alterna con el amarillo de sedes, que es lo que impide que la
      portada se lea como un solo bloque. La ficha del mini-programa se queda
      blanca dentro del campo rojo — la misma gramática que el retrato montado
      sobre rojo en el feed. */}
  <section class="relative overflow-hidden border-b-2 border-tinta bg-rojo">
    {/* Izquierda y abajo, detrás de la ficha blanca del mini-programa: es
        opaca, se le monta encima y deja asomar la estrella por el hueco. Así
        queda lejos del botón —arriba a la derecha— y de la lista de días, que
        es texto y no la taparía. */}
    <Estrella tinta="amarilla" alto="abajo" lado="izquierda" />
    <div class="relative px-4 pt-12 pb-14 sm:px-6 lg:px-10 lg:pt-16 lg:pb-20">
      <div
        class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-tinta pb-8"
      >
        <div>
          <p
            class="meta mb-6 inline-block bg-amarillo px-3 py-1.5 text-tinta"
            data-reveal="lado"
          >
            03 / {programa.titulo}
          </p>
          {/* Al mismo cuerpo que SEDES, y las dos mucho más chicas que antes.
              Antes ésta iba un punto por debajo para que no compitieran: eran
              dos carteles del mismo tamaño gritando por turnos sobre el mismo
              campo amarillo. Ahora lo que las separa es el campo —una
              amarilla, la otra roja—, así que el cuerpo puede igualarse y
              bajar. La jerarquía la lleva el color, no el tamaño. */}
          <h2
            class="display text-[9vw] leading-[0.9] text-amarillo lg:text-[4.5vw]"
            data-lineas
            data-reveal="lineas"
          >
            {programa.titulo}
          </h2>
        </div>
        <a href={conBase("/programa")} class="boton boton--amarillo" data-reveal="arriba">
          Ver el programa
        </a>
      </div>

      {/* Un solo instrumento partido en dos mitades: la lista de la derecha
          manda y la rejilla de la izquierda enseña. Antes eran dos bloques
          que hablaban de lo mismo sin mirarse —el día salía escrito dos
          veces, una en la cabecera del mini y otra en la lista— y ninguno de
          los dos se podía tocar. */}
      {/* `items-stretch` y no `items-start`: la tarjeta de la izquierda mide
          lo que mide el día que se esté viendo, y la lista de la derecha medía
          siempre lo mismo —cuatro filas de sesenta píxeles—. La diferencia
          quedaba en un socavón de amarillo debajo de la lista, que era lo que
          hacía que la sección pareciera una caja a medio llenar. Estiradas a
          la par, las cuatro filas se reparten el alto que haya y las dos
          columnas cierran a la misma línea. */}
      {
        programaPublicado ? (
        <div
          class="mt-10 grid gap-10 lg:mt-12 lg:grid-cols-[1.35fr_1fr] lg:items-stretch lg:gap-14"
        >
          {/* El mini: la silueta del día, sin texto en las barras. No es para
              leer qué hay —eso está a la derecha y en el programa—, es para ver
              de un golpe cómo se reparte la jornada entre las sedes. */}
          <div data-reveal="arriba" data-retraso="120">
            <Gantt agrupar="sede" resumen mini selector="[data-dias-portada]" />
          </div>

          {/* Sin rótulo de columna: la tarjeta de la izquierda ya lleva el suyo
              dentro y aquí sobra: cuatro días con su fecha, bajo un titular que
              dice «Programa», no necesitan que nadie los presente. Sin él,
              además, el canto de arriba de la lista arranca exactamente en el
              canto de arriba de la tarjeta. */}
          <div data-reveal="arriba">
            <ul
              class="flex h-full flex-col border-y-2 border-amarillo"
              data-dias-portada
            >
              {
                programa.dias.map((d, i) => (
                  <li class="flex flex-1 border-b border-amarillo/30 last:border-b-0">
                    {/* La fila entera cambia el día de la rejilla: el objetivo
                        es la franja, no dos palabras. */}
                    <button
                      type="button"
                      class="dia-portada flex w-full items-center gap-x-4 py-4 text-left"
                      data-dia={i}
                      aria-pressed={i === 0 ? 'true' : 'false'}
                    >
                      <span class="meta dia-num w-7 shrink-0 text-papel/75 transition-colors duration-200">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <span class="display dia-nombre flex-1 text-2xl leading-none text-amarillo transition-colors duration-200">
                        {d.dia}
                      </span>
                      {/* Filete de 1 px y sin relleno vertical: con el de 2 px
                          del resto del sitio la etiqueta medía más que el
                          nombre del día y la fila crecía tres píxeles respecto
                          a las otras tres. */}
                      <span class="meta dia-hoy shrink-0 border border-amarillo px-1.5 text-[0.55rem] leading-[1.7] text-amarillo">
                        Hoy
                      </span>
                      <span class="meta shrink-0 text-papel/75">
                        {d.fecha.replace(' de septiembre', ' sep')}
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        ) : (
          <div class="mt-10 lg:mt-12">
            <AvisoPrograma compacto />
          </div>
        )
      }
    </div>
  </section>

  <!-- ══ PATROCINADORES ══════════════════════════════════════════════════
       Una cinta y una sola: aquí había un relevo entre Patrocinadores y
       Colaboradores —dos bloques turnándose el mismo hueco cada quince
       segundos— y la distinción no la usaba nadie. El festival metía todo en
       Patrocinadores, así que el segundo turno era un bloque vacío rotando en
       silencio; y el día que se quedó del todo sin marcas tumbó el build. Una
       lista, un rótulo, sin turnos.

       El collage de sillas del fondo es el mismo que usa Sedes detrás de las
       fichas. -->
  {
    patrocinadores.lista.length > 0 &&
      (() => {
        /* Cuánto mide un mosaico con su margen, y a qué velocidad corre la
           tira (píxeles por segundo). De aquí salen las dos cuentas de abajo. */
        const PASO = 240;
        const VELOCIDAD = 52;

        /* La lista se repite hasta cubrir de sobra el ancho de una pantalla:
           con tres marcas, la tira tendría huecos entre vuelta y vuelta. El
           `max(1, …)` es el suelo, y `length > 0` allá arriba es lo que evita
           dividir entre cero —que daba `Infinity` y reventaba el build al
           construir el arreglo. */
        const repes = Math.max(
          1,
          Math.ceil(1600 / PASO / patrocinadores.lista.length),
        );
        const unidad = Array.from(
          { length: repes },
          () => patrocinadores.lista,
        ).flat();
        const duracion = ((unidad.length * PASO) / VELOCIDAD).toFixed(1);

        return (
          <section
            class="cinta-marcas relative overflow-hidden border-b-2 border-tinta"
            data-cinta
            data-dormida
          >
            <div class="cinta-sillas absolute inset-0" aria-hidden="true">
              {sillasSedes.map((silla) => (
                <Silla
                  variante="roja"
                  class="silla-sede"
                  style={`--x:${silla.x}%;--y:${silla.y}%;--ancho:${silla.ancho}vw;--giro:${silla.giro}deg;--opa:${silla.opa};`}
                />
              ))}
            </div>

            <div class="cinta-cabecera relative px-4 pt-12 pb-9 sm:px-6 lg:px-10 lg:pt-16">
              <p class="meta cinta-acento mb-7 flex items-center gap-4">
                <span class="cinta-filete inline-block h-[2px] w-12" />
                <span>04 / {patrocinadores.titulo}</span>
              </p>
              <h2 class="display text-[9vw] leading-[0.9] lg:text-[4.5vw]">
                {patrocinadores.titulo}
              </h2>
            </div>

            <div class="cinta-pista relative pb-16 lg:pb-20">
              <div class="cinta-ventana overflow-hidden" role="marquee">
                {/* Dos copias de la misma tira, la segunda escondida de los
                    lectores de pantalla: la animación corre la primera hasta
                    su ancho y la segunda entra detrás sin costura. */}
                <div class="marquee" style={`--duracion: ${duracion}s`}>
                  {[0, 1].map((copia) => (
                    <div class="flex shrink-0" aria-hidden={copia === 1}>
                      {unidad.map((marca) => (
                        <Mosaico marca={marca} class="mr-4" />
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>
        );
      })()
  }

  <!-- ══ CIERRE ═════════════════════════════════════════════════════════ -->
  {/* Sin estrella: el wordmark gótico ES la marca gráfica de esta banda y no
      necesita competencia. Es el único cierre del sitio que ya trae su propio
      dibujo. */}
  <section class="relative overflow-hidden bg-rojo text-amarillo">
    <div
      class="relative px-4 py-16 text-center sm:px-6 lg:px-10 lg:py-20"
    >
      <img
        src={conBase("/logos/wordmark-amarilla.svg")}
        alt="Cuarta Silla"
        width="533"
        height="85"
        class="mx-auto w-[68vw] lg:w-[44vw]"
        data-reveal="escala"
      />
      {/* Iba en amarillo al 80% sobre rojo: 2,9:1, de las peores del sitio.
          Sobre rojo la letra chica va blanca. */}
      <p class="meta mt-6 text-papel" data-reveal="arriba">
        {festival.fechas} · {festival.ciudad}
      </p>
      {/* El remate lleva un solo botón, y es el de donar. Lo demás —programa,
          sedes, artistas, archivo— ya está en la barra de arriba y en el pie;
          repetirlo aquí abajo convertía el cierre en otro menú. Con una sola
          puerta, la banda pide una cosa y se entiende cuál.

          Mientras no exista la cuenta de PayPal el botón sale desactivado y
          diciéndolo, en vez de desaparecer: el cierre se quedaría sin nada
          debajo del logotipo. En cuanto `festival.donaciones.paypal` tenga el
          enlace, se convierte solo en el botón de verdad. */}
      <div class="mt-9 flex justify-center" data-reveal="arriba" data-retraso="120">
        {
          festival.donaciones.paypal ? (
            <a
              href={festival.donaciones.paypal}
              target="_blank"
              rel="noopener"
              class="boton boton--papel"
            >
              ★ Donar ★
            </a>
          ) : (
            <span class="boton boton--papel boton--dormido">
              ★ Donar — próximamente ★
            </span>
          )
        }
      </div>
      {
        festival.donaciones.nota && (
          <p
            class="meta mx-auto mt-6 max-w-[38ch] leading-relaxed text-papel"
            data-reveal="arriba"
            data-retraso="180"
          >
            {festival.donaciones.nota}
          </p>
        )
      }
    </div>
  </section>

  <script>
    /* Lo único que le queda de guion a la cinta: pausarla cuando no está en
       cuadro y dejarla quieta si el sistema pide menos movimiento. La rotación
       entre grupos se fue con Colaboradores. */
    const cinta = document.querySelector('[data-cinta]');
    if (cinta) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        /* Quieta se lee arrastrando: el CSS le devuelve el scroll a la tira y
           esconde la copia de repuesto, que sin animación sería la lista
           escrita dos veces. */
        cinta.setAttribute('data-quieta', 'si');
        cinta.removeAttribute('data-dormida');
      } else {
        /* Fuera de cuadro la animación se pausa: nace dormida —el atributo
           viene puesto en el HTML— y despierta al asomarse. */
        const ojo = new IntersectionObserver(
          ([entrada]) => {
            if (entrada.isIntersecting) cinta.removeAttribute('data-dormida');
            else cinta.setAttribute('data-dormida', '');
          },
          { threshold: 0 },
        );
        ojo.observe(cinta);
      }
    }
  </script>
</Base>
