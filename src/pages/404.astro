---
import Base from '../layouts/Base.astro';
import { conBase } from '../lib/base';
import Estrella from '../components/Estrella.astro';
import Juego from '../components/Juego.astro';
import { nav } from '../data/site';
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe.">
  <section
    class="relative flex min-h-[70vh] items-center overflow-hidden bg-rojo text-amarillo"
  >
    {/* La silla iba al 20% de amarillo sobre rojo, que da naranja: una trama
        de una tinta sobre la OTRA inventa un color que no está en el manual.
        La estrella entra a plena fuerza y se queda dentro del sistema. */}
    <Estrella tinta="amarilla" alto="abajo" />

    {/* En escritorio, dos columnas: el aviso a la izquierda y el juego en el
        rojo que sobraba a la derecha, los dos a la vista sin bajar. La
        primera mide lo que el titular y 28rem como poco, para que los
        botones hagan dos renglones y no uno que se coma el ancho del juego.
        En el teléfono, el juego va debajo de los botones: lo primero de una
        404 es devolver a la gente a alguna parte. */}
    <div
      class="relative grid w-full items-center gap-x-16 gap-y-14 px-4 py-24 sm:px-6 lg:grid-cols-[fit-content(28rem)_minmax(0,1fr)] lg:px-10"
    >
      <div>
        <p class="meta mb-6 inline-block bg-amarillo px-3 py-1.5 text-tinta">
          Error 404
        </p>
        <h1 class="display text-[22vw] leading-[0.95] lg:text-[13vw]">
          Silla<br />vacía
        </h1>
        {/* En papel y a cuerpo grande: amarillo sobre rojo da 3,67:1 y esto es
            texto corrido. A 20px en negrita cuenta como texto grande y el blanco
            sobre rojo (4,0:1) ya alcanza. */}
        <p class="mt-8 max-w-md text-xl font-bold text-papel">
          Esta página no existe. Estas sí:
        </p>
        <ul class="mt-8 flex flex-wrap gap-3">
          {
            nav.map((item) => (
              <li>
                <a href={conBase(item.href)} class="boton boton--papel">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* El dino de Chrome vive en la página de error; el nuestro, también. */}
      <Juego class="max-w-3xl" />
    </div>
  </section>
</Base>
