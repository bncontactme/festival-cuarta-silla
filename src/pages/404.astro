---
import Base from '../layouts/Base.astro';
import { conBase } from '../lib/base';
import Estrella from '../components/Estrella.astro';
import Juego from '../components/Juego.astro';
import { nav } from '../data/site';
---

{/* Sin `slot="movil"`, a propósito: en el teléfono la 404 es la misma de
    escritorio, en una columna, y no una pantalla del sitio móvil. El cartel
    —«Silla vacía» a cuerpo de cartel, los botones blancos, la estrella— es
    la gracia de esta página, y en una pantalla de las de filas se perdía. */}
<Base titulo="Página no encontrada" descripcion="Esta página no existe.">
  <section
    class="relative flex min-h-[70vh] items-center overflow-hidden bg-rojo text-amarillo"
  >
    {/* La silla iba al 20% de amarillo sobre rojo, que da naranja: una trama
        de una tinta sobre la OTRA inventa un color que no está en el manual.
        La estrella entra a plena fuerza y se queda dentro del sistema. */}
    <Estrella tinta="amarilla" alto="abajo" />

    {/* En escritorio, dos columnas, y cada una con su oficio. A la izquierda,
        el titular solo, como un cartel. A la derecha, lo que se hace con él:
        arriba el aviso y las salidas, a la altura del «Error 404»; abajo el
        juego, asentado en la base de «vacía» como en un suelo, con la
        estrella asomando por detrás. Arriba y abajo, los cantos de las dos
        columnas coinciden: nada flota.

        En el teléfono, una columna en ese mismo orden, más apretada: el
        juego entero cabe en la primera pantalla de un teléfono normal.

        Y en ese orden en el HTML, no sólo en la vista: quien tabula llega
        antes a las salidas que al juego, que es lo que toca en una 404. */}
    <div
      class="relative grid w-full gap-x-16 gap-y-6 px-4 pt-6 pb-12 sm:px-6 lg:grid-cols-[max-content_minmax(0,1fr)] lg:gap-y-12 lg:px-10 lg:py-24"
    >
      <div>
        <p class="meta mb-4 inline-block bg-amarillo px-3 py-1.5 text-tinta lg:mb-6">
          Error 404
        </p>
        <h1 class="display text-[22vw] leading-[0.95] lg:text-[13vw]">
          Silla<br />vacía
        </h1>
      </div>

      <div class="flex min-w-0 flex-col justify-between gap-8 lg:gap-12">
        <div>
          {/* En papel y a cuerpo grande: amarillo sobre rojo da 3,67:1 y esto
              es texto corrido. A 20px en negrita cuenta como texto grande y
              el blanco sobre rojo (4,0:1) ya alcanza. */}
          <p class="max-w-md text-xl font-bold text-papel">
            Esta página no existe. Estas sí:
          </p>
          <ul class="mt-4 flex flex-wrap gap-3 lg:mt-5">
            {
              nav.map((item) => (
                <li>
                  <a href={conBase(item.href)} class="boton boton--papel">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* El dino de Chrome vive en la página de error; el nuestro, también. */}
        <Juego class="w-full max-w-4xl" />
      </div>
    </div>
  </section>
</Base>
