---
import { conBase } from '../../lib/base';
/**
 * Marco de una pantalla interior del sitio móvil: barra con vuelta a la
 * portada y un cuerpo que cabe entero (o hace scroll él solo, sin arrastrar
 * la página).
 *
 * `fondo` decide la pareja de colores, siempre dentro de la paleta del
 * manual — nunca se inventa una combinación nueva por conveniencia.
 */
interface Props {
  titulo: string;
  indice: string;
  nota?: string;
  fondo?: 'amarillo' | 'papel' | 'tinta' | 'rojo';
  /** Campo de la zona de contenido. Permite repetir en móvil la secuencia
   *  del escritorio: portada roja y cuerpo amarillo. */
  fondoCuerpo?: 'amarillo' | 'papel' | 'tinta' | 'rojo';
  /**
   * Hasta dónde se ensancha el marco en una pantalla grande.
   *
   * `pulgar` (por defecto) lo topa en 32rem, que es la regla de la casa: en
   * tablet el diseño está pensado para una mano y se centra en vez de
   * estirarse — una columna de tarjetas de 820 px de ancho no es el mismo
   * diseño más grande, es otro peor.
   *
   * `reja` lo sube a 40rem, y existe para una pantalla: la de artistas. Ese
   * tope está calibrado para una COLUMNA, y una reja de fotos no se ahoga con
   * el ancho, se ahoga sin él — en una tablet de 768 px, dieciocho retratos en
   * una tira de 512 dejaban hueco muerto a los dos lados y dieciséis
   * pantallas de scroll. Con 40rem caben tres columnas y sigue habiendo
   * márgenes: se ensancha la reja, no se abandona la regla.
   */
  ancho?: 'pulgar' | 'reja';
}

const {
  titulo,
  indice,
  nota,
  fondo = 'amarillo',
  fondoCuerpo = fondo,
  ancho = 'pulgar',
} = Astro.props;

const paletas = {
  amarillo: 'bg-amarillo text-tinta',
  papel: 'bg-papel text-tinta',
  tinta: 'bg-tinta text-papel',
  rojo: 'bg-rojo text-amarillo',
};

const paletaCabecera = paletas[fondo];
const paletaCuerpo = paletas[fondoCuerpo];

/* Sobre rojo, lo chico va en papel y no en la tinta del campo: el amarillo
   sobre rojo da 3,67:1 y bajarle la opacidad, como hacía la nota, lo dejaba
   por debajo de 3. El titular sí se queda en amarillo — es tamaño cartel. */
const menudo = fondo === 'rojo' ? 'text-papel opacity-80' : 'opacity-55';
const indicePiel = fondo === 'rojo' ? 'text-papel opacity-75' : 'opacity-45';
---

<div class={`movil-marco movil-marco--${ancho} ${paletaCuerpo}`}>
  <header class={`movil-barra ${paletaCabecera}`}>
    <a href={conBase("/")} class="meta px-4 font-bold">
      <span aria-hidden="true">←</span>&nbsp; Portada
    </a>
    <span class={`meta border-l-2 border-current px-4 ${indicePiel}`}>{indice}</span>
  </header>

  <div class="movil-cuerpo">
    <div class={`border-b-2 border-current px-4 py-5 ${paletaCabecera}`}>
      <h1 class="display text-[12cqw] leading-[0.92]">{titulo}</h1>
      {nota && <p class={`meta mt-2 text-[0.6rem] ${menudo}`}>{nota}</p>}
    </div>

    {/* Lo que se queda arriba mientras el cuerpo hace scroll — hoy, la banda
        del buscador de artistas. Va DENTRO del cuerpo y no en la barra de
        arriba porque el que hace scroll es el cuerpo: pegado ahí, se queda
        quieto justo debajo del título y el contenido corre por debajo. En la
        barra de arriba le robaría sitio a la vuelta a la portada, que es la
        única salida que tiene una pantalla del móvil. */}
    <slot name="fijo" />

    <div class={`movil-contenido ${paletaCuerpo}`}>
      <slot />
    </div>
  </div>
</div>
