---
/**
 * La portada móvil: la silla roja en medio del campo amarillo. Luego cuatro
 * puertas.
 *
 * No es la home de escritorio recortada — no lleva manifiesto, ni adelanto de
 * sedes, ni patrocinadores. Es un índice: dice cuándo, dónde, y a dónde ir.
 * Todo lo demás está a un toque de distancia y cabe en su propia pantalla.
 *
 * La secuencia de entrada vive entera en movil.css; aquí sólo están las
 * piezas que anima.
 */
import Silla from '../Silla.astro';
import { conBase } from '../../lib/base';
import {
  festival,
  manifiesto,
  privacidad,
  programa,
  registroEventos,
  sedes,
  convocatoriaVoluntarixs,
  estadoPrograma,
} from '../../data/site';
import { artistas } from '../../data/artistas';
import { archivo } from '../../data/archivo';

/* «Registro» a secas, arriba a la derecha de la portada, se lee como darse de
   alta en la web. El nombre entero —el mismo de la barra de escritorio y del
   pie— dice a qué se apunta uno. No cabe en un renglón a este cuerpo, así que
   se parte por la última palabra: «Registro a / eventos». Se calcula y no se
   escribe a mano para que siga saliendo de `site.ts` como en todas partes. */
const partes = registroEventos.label.split(' ');
const registroCola = partes.pop();
const registroCabeza = partes.join(' ');

const puertas = [
  { n: '01', label: 'Manifiesto', href: '#manifiesto', nota: 'Qué es esto', fondo: 'rojo' },
  { n: '02', label: programa.titulo, href: '/programa', nota: estadoPrograma, fondo: 'amarillo' },
  {
    n: '03',
    label: sedes.titulo,
    href: '/sedes',
    nota: `${sedes.lista.length} lugares`,
    fondo: 'rojo',
  },
  {
    n: '04',
    label: artistas.titulo,
    href: '/artistas',
    /* Sin nombres todavía, la puerta va sin nota: «Por anunciar» debajo de
       ARTISTAS no dice nada que no diga la propia página al abrirla, y en una
       rejilla de cuatro puertas es la única que se disculpa. */
    nota: artistas.lista.length
      ? `${artistas.lista.length} ${artistas.lista.length === 1 ? 'nombre' : 'nombres'}`
      : '',
    fondo: 'amarillo',
  },
] as const;

/** Los atajos del pie de la portada. No son puertas: son la letra chica del
 *  índice. Se quedan fuera de las cuatro grandes a propósito —una quinta
 *  puerta le come 70 px a la escena de la silla, y en un iPhone SE la silla,
 *  que mide 217 px, se recortaría contra el `overflow: hidden` del marco—.
 *  La convocatoria de voluntarixs comparte esta franja con la galería;
 *  «Apoya» sólo aparece cuando exista la cuenta de PayPal. */
const atajos = [
  { label: archivo.titulo, href: '/galeria' },
  { ...convocatoriaVoluntarixs, externa: true },
  ...(festival.donaciones.paypal
    ? [{ label: 'Apoya', href: festival.donaciones.paypal, externa: true }]
    : []),
];
---

<div class="movil-marco" id="portada">
  <div class="portada">
    <header class="movil-barra portada-barra">
      {/* Mismo cambio que la barra de escritorio: la silla vive en la escena
          de abajo, así que aquí queda el nombre a dos renglones y nada más. */}
      <span class="px-4">
        <span class="meta block text-[0.5rem] leading-[1.55] text-rojo">
          Festival de arte<br />conceptual
        </span>
      </span>
      <a
        href={conBase(registroEventos.href)}
        class="border-l-2 border-tinta px-4"
      >
        <span class="meta block text-right leading-[1.2] font-bold text-rojo">
          {registroCabeza}<br />{registroCola}
        </span>
      </a>
    </header>

    {/* La silla en medio, con el rótulo encima */}
    <div class="portada-escena">
      <Silla variante="roja" class="portada-silla" />

      <h1 class="portada-rotulo">
        <span class="sr-only">
          {festival.nombre} — {festival.fechas} — {festival.ciudad}
        </span>
        {/* Los tres renglones, con «de Arte» en tinta: es el mismo rótulo
            del hero de escritorio, y el color parte el nombre por donde lo
            parte el manual. Van en tres elementos y no en uno con <br>
            porque cada línea lleva su propio color. */}
        <span class="display display-centro block leading-[0.88] text-rojo" aria-hidden="true">
          Festival
        </span>
        <span class="display display-centro block leading-[0.88] text-tinta" aria-hidden="true">
          de Arte
        </span>
        <span class="display display-centro block leading-[0.88] text-rojo" aria-hidden="true">
          Conceptual
        </span>
      </h1>
    </div>

    {/* Cuándo y cuánto falta, en una línea en vez de cuatro cajas */}
    <div class="portada-datos" data-cuenta={festival.inicioISO}>
      <p class="meta text-[0.6rem]">
        24 — 27 SEP {festival.anio}
        <span class="opacity-50" aria-hidden="true">/</span>
        Guadalajara
      </p>
      <p class="meta mt-1 text-[0.6rem] opacity-70">
        Faltan <span class="font-bold opacity-100" data-campo="dias">--</span> días
      </p>
    </div>

    <nav class="portada-puertas" aria-label="Secciones">
      {
        puertas.map((p) => (
          <a
            href={conBase(p.href)}
            class={`puerta puerta--${p.fondo}`}
            target={p.externa ? '_blank' : undefined}
            rel={p.externa ? 'noopener' : undefined}
          >
            <span class="puerta-numero meta text-[0.6rem]">{p.n}</span>
            <span>
              <span class="puerta-titulo display block text-3xl leading-none">
                {p.label}
              </span>
              {p.nota && (
                <span class="puerta-nota meta mt-1 block text-[0.5rem]">
                  {p.nota}
                </span>
              )}
            </span>
            <span class="puerta-flecha display text-2xl" aria-hidden="true">
              {p.externa ? '↗' : '→'}
            </span>
          </a>
        ))
      }
    </nav>

    <nav class="portada-atajos" aria-label="Más">
      {
        atajos.map((a) => (
          <a
            href={conBase(a.href)}
            target={a.externa ? '_blank' : undefined}
            rel={a.externa ? 'noopener' : undefined}
          >
            {a.label} <span aria-hidden="true">{a.externa ? '↗' : '→'}</span>
          </a>
        ))
      }
    </nav>

    {/* El pie del sitio grande no se pinta aquí, y con él se iba el único
        enlace al aviso de privacidad. Una línea basta. */}
    <p class="portada-legal">
      <a href={conBase("/privacidad")} class="enlace">{privacidad.titulo}</a>
      <span class="opacity-40"> · {festival.creditoFooter}</span>
    </p>
  </div>

  {/* ── Manifiesto: pantalla con :target ─────────────────────────────── */}
  {/* En escritorio es una sección de la home; aquí necesita pantalla propia
      y no merece una URL nueva. `:target` da las dos cosas y el botón atrás
      del teléfono funciona solo. */}
  <section
    id="manifiesto"
    class="movil-modal bg-rojo text-amarillo"
    aria-label={manifiesto.titulo}
  >
    <div class="movil-barra bg-rojo">
      <a href="#portada" class="meta border-r-2 border-tinta bg-amarillo px-4 font-bold text-tinta">
        <span aria-hidden="true">←</span>&nbsp; Volver
      </a>
      <span class="meta px-4 text-papel/80">01</span>
    </div>

    <div class="movil-cuerpo px-4 py-6">
      <h2 class="display text-[9cqw] leading-[1] text-amarillo">
        {manifiesto.titulo}
      </h2>

      <div class="mt-6 space-y-4">
        {
          manifiesto.parrafos.map((p) => (
            <p class="text-[0.95rem] leading-relaxed text-papel">{p}</p>
          ))
        }
      </div>

      <blockquote
        class="mt-8 border-l-4 border-amarillo pl-4 font-mono text-base leading-snug font-bold text-papel"
      >
        {manifiesto.cierre}
      </blockquote>
    </div>
  </section>
</div>
