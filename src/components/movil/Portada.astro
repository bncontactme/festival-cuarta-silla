---
/**
 * La portada móvil: la silla roja en medio del campo amarillo, y debajo
 * cuánto falta. Todo lo demás —incluido el manifiesto— vive detrás de una
 * sola puerta, el índice, que se abre desde la barra y sube desde el canto
 * de abajo cuando se toca.
 *
 * No es la home de escritorio recortada — es un cartel con un reloj y un
 * índice: dice cuándo, dónde, y guarda el resto a un toque.
 *
 * Aquí hubo cuatro puertas de 70 px y un renglón de atajos, y el manifiesto
 * tenía su propio atajo en la barra. Entre las dos cosas se llevaban 326 px
 * de una pantalla de 812 para dar seis destinos que casi nadie mira dos
 * veces: se entra al sitio a ver qué es y cuándo es. Ahora esos destinos
 * —manifiesto incluido, al final de la lista— viven en la hoja del índice,
 * la barra sólo abre esa puerta, y el cartel se queda con el alto que le
 * sobraba: la silla crece y el reloj deja de ser un renglón para ser los
 * cuatro números del escritorio.
 *
 * La secuencia de entrada vive entera en movil.css; aquí sólo están las
 * piezas que anima.
 */
import Silla from '../Silla.astro';
import Mosaico from '../Mosaico.astro';
import { conBase } from '../../lib/base';
import {
  actividadesConRegistro,
  festival,
  manifiesto,
  patrocinadores,
  privacidad,
  programa,
  registro,
  registroEventos,
  sedes,
  convocatoriaVoluntarixs,
  estadoPrograma,
} from '../../data/site';
import { artistas } from '../../data/artistas';
import { archivo } from '../../data/archivo';

/* Los cuatro campos del reloj, los mismos del escritorio. El reloj de
   `motion.ts` rellena los `[data-campo]` que encuentre dentro de un
   `[data-cuenta]`, así que pedir cuatro en vez de uno no cuesta una línea de
   guion: hasta ahora el móvil sólo pedía los días. */
const cuenta = [
  { campo: 'dias', label: 'Días' },
  { campo: 'horas', label: 'Horas' },
  { campo: 'minutos', label: 'Min' },
  { campo: 'segundos', label: 'Seg' },
] as const;

/* Cuántos eventos, si los hay; si todavía no hay formularios, lo que se va a
   encontrar al entrar, que es mejor saberlo antes de pulsar. */
const cuantosEventos = actividadesConRegistro.length;

/** El índice: todo lo que el sitio tiene, con su cifra al lado.
 *
 * El manifiesto va al final y no al principio: es lo único de la lista que
 * no lleva a otra sección del sitio, sino a la pantalla `#manifiesto` que ya
 * vive aquí mismo — la letra chica del índice, después de los destinos de
 * verdad. El aviso de privacidad no entra: es la línea legal del pie, no una
 * sección.
 *
 * La cifra no se escribe a mano: sale de la posición en la lista, así que
 * mover una entrada —como el manifiesto, que ya se ha movido dos veces— no
 * obliga a renumerar las demás. «Apoya» aparece sólo cuando exista la cuenta
 * de PayPal; hasta entonces el índice tiene siete entradas y no una
 * desactivada pidiendo perdón. */
const indice = [
  {
    label: registroEventos.label,
    href: registroEventos.href,
    nota: cuantosEventos
      ? `${cuantosEventos} ${cuantosEventos === 1 ? 'evento' : 'eventos'}`
      : registro.estado,
  },
  { label: programa.titulo, href: '/programa', nota: estadoPrograma },
  {
    label: sedes.titulo,
    href: '/sedes',
    nota: `${sedes.lista.length} lugares`,
  },
  {
    label: artistas.titulo,
    href: '/artistas',
    /* Sin nombres todavía, la entrada va sin nota: «Por anunciar» debajo de
       ARTISTAS no dice nada que no diga la propia página al abrirla. */
    nota: artistas.lista.length
      ? `${artistas.lista.length} ${artistas.lista.length === 1 ? 'nombre' : 'nombres'}`
      : '',
  },
  {
    label: archivo.titulo,
    href: '/galeria',
    nota: archivo.lista.length
      ? `${archivo.lista.length} ${archivo.lista.length === 1 ? 'edición' : 'ediciones'}`
      : archivo.estado,
  },
  {
    label: 'Voluntarixs',
    href: convocatoriaVoluntarixs.href,
    nota: 'Convocatoria',
    externa: true,
  },
  ...(festival.donaciones.paypal
    ? [
        {
          label: 'Apoya',
          href: festival.donaciones.paypal,
          nota: 'Donar',
          externa: true,
        },
      ]
    : []),
  { label: 'Manifiesto', href: '#manifiesto' },
].map((entrada, i) => ({ ...entrada, n: String(i + 1).padStart(2, '0') }));

/* ── La cinta de marcas ──────────────────────────────────────────────────
   La misma tira del escritorio a escala de teléfono: la ficha mide 5.5rem
   —88 px— más medio rem de aire, y la tira corre a 42 px por segundo, más
   despacio que los 52 de allá porque aquí el recorrido visible es un tercio.

   Con veintitantas marcas una vuelta ya cubre de sobra el ancho del teléfono;
   el `repes` es el seguro para el día que queden dos, y el `length > 0` de
   abajo es lo que evita dividir entre cero. */
const PASO = 96;
const VELOCIDAD = 42;
const repes = Math.max(
  1,
  Math.ceil(600 / PASO / Math.max(1, patrocinadores.lista.length)),
);
const tira = Array.from({ length: repes }, () => patrocinadores.lista).flat();
const duracionCinta = ((tira.length * PASO) / VELOCIDAD).toFixed(1);
---

<div class="movil-marco" id="portada">
  <div class="portada">
    <header class="movil-barra portada-barra">
      {/* Mismo cambio que la barra de escritorio: la silla vive en la escena
          de abajo, así que aquí queda el nombre a dos renglones y nada más. */}
      <span class="px-4">
        <span class="meta block text-[0.5rem] leading-[1.55] text-rojo">
          Festival de arte<br />conceptual
        </span>
      </span>
      {/* El índice, no el manifiesto: es la única puerta que le queda a la
          portada, así que vive en la esquina de la barra, donde antes vivía
          el atajo al manifiesto. El manifiesto no se pierde — es la entrada
          01 de la lista de abajo, con el mismo número que lleva en la
          sección homónima de escritorio. */}
      <a
        href="#indice"
        class="meta border-l-2 border-tinta px-4 font-bold text-rojo"
      >
        Índice
      </a>
    </header>

    {/* La silla en medio, con el rótulo encima */}
    <div class="portada-escena">
      <Silla variante="roja" class="portada-silla" />

      <h1 class="portada-rotulo">
        <span class="sr-only">
          {festival.nombre} — {festival.fechas} — {festival.ciudad}
        </span>
        {/* Los tres renglones, con «de Arte» en tinta: es el mismo rótulo
            del hero de escritorio, y el color parte el nombre por donde lo
            parte el manual. Van en tres elementos y no en uno con <br>
            porque cada línea lleva su propio color. */}
        <span class="display display-centro block leading-[0.88] text-rojo" aria-hidden="true">
          Festival
        </span>
        <span class="display display-centro block leading-[0.88] text-tinta" aria-hidden="true">
          de Arte
        </span>
        <span class="display display-centro block leading-[0.88] text-rojo" aria-hidden="true">
          Conceptual
        </span>
      </h1>
    </div>

    {/* ── El tiempo ──────────────────────────────────────────────────────
        Cuándo y cuánto falta. Era un renglón con los días; ahora son los
        cuatro números del escritorio, que es lo que pide una portada donde
        sólo quedan dos cosas: el cartel y esto.

        Es además el tercer color de la portada, y por eso es un elemento de
        verdad y no una capa de la animación: entra barriendo y se queda. */}
    <div class="portada-tiempo" data-cuenta={festival.inicioISO}>
      <p class="meta portada-cuando">
        24 — 27 SEP {festival.anio}
        <span class="opacity-55" aria-hidden="true">/</span>
        Guadalajara
      </p>
      <dl class="portada-reloj">
        {
          cuenta.map(({ campo, label }) => (
            <div>
              <dd class="display display-centro" data-campo={campo}>
                --
              </dd>
              <dt class="meta">{label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    {/* ── Patrocinadores ─────────────────────────────────────────────────
        La misma cinta del escritorio, a escala de teléfono. Las fichas son
        blancas sobre el rojo: en el feed el blanco es exactamente eso, la
        tira de logos y el marco de las fotos, nunca un fondo decorativo. */}
    {
      patrocinadores.lista.length > 0 && (
        <section class="portada-marcas" aria-label={patrocinadores.titulo}>
          <p class="meta portada-marcas-rotulo">
            <span class="portada-marcas-filete" aria-hidden="true" />
            {patrocinadores.titulo}
          </p>
          <div class="portada-pista">
            {/* Dos copias de la misma tira, la segunda escondida de los
                lectores de pantalla: la animación corre la primera hasta su
                ancho y la segunda entra detrás sin costura. */}
            <div class="marquee" style={`--duracion: ${duracionCinta}s`}>
              {[0, 1].map((copia) => (
                <div class="flex shrink-0" aria-hidden={copia === 1}>
                  {tira.map((marca) => (
                    <Mosaico marca={marca} class="mr-2" />
                  ))}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* El pie del sitio grande no se pinta aquí, y con él se iba el único
        enlace al aviso de privacidad. Una línea basta. */}
    <p class="portada-legal">
      <a href={conBase("/privacidad")} class="enlace">{privacidad.titulo}</a>
      <span class="opacity-40"> · {festival.creditoFooter}</span>
    </p>

    {/* ── La hoja del índice ─────────────────────────────────────────────
        Sube desde el canto de abajo al tocar el tirador y tapa el reloj, la
        cinta y la línea legal; el cartel se queda asomando arriba, que es lo
        que dice dónde estás.

        `:target` otra vez, como el manifiesto: sin una línea de JS, con URL
        de verdad y con el botón atrás del teléfono cerrándola. La ✕ del asa
        vuelve a `#portada`, que es lo mismo que hace el manifiesto. */}
    <nav id="indice" class="portada-hoja" aria-label="Índice del sitio">
      <a href="#portada" class="portada-asa">
        <span class="display portada-asa-rotulo">Índice</span>
        <span class="portada-asa-cerrar" aria-hidden="true">✕</span>
        <span class="sr-only">Cerrar el índice</span>
      </a>

      <ul>
        {
          indice.map((e) => (
            <li>
              <a
                href={conBase(e.href)}
                class="indice-fila"
                target={e.externa ? '_blank' : undefined}
                rel={e.externa ? 'noopener' : undefined}
              >
                <span class="indice-numero meta">{e.n}</span>
                {/* Nombre y nota en una sola columna, apilados: puestos en la
                    misma fila que el número compiten por el ancho y un
                    nombre largo —«Registro a eventos»— y una nota larga
                    —«33 actividades · 4 días»— se parten cada uno en dos
                    líneas y chocan entre sí. Apilados, cada uno tiene la
                    columna entera para él solo. */}
                <span class="indice-cuerpo">
                  <span class="indice-nombre display">{e.label}</span>
                  {e.nota && <span class="indice-nota meta">{e.nota}</span>}
                </span>
                <span class="indice-flecha display" aria-hidden="true">
                  {e.externa ? '↗' : '→'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {/* ── Manifiesto: pantalla con :target ─────────────────────────────── */}
  {/* En escritorio es una sección de la home; aquí necesita pantalla propia
      y no merece una URL nueva. `:target` da las dos cosas y el botón atrás
      del teléfono funciona solo. */}
  <section
    id="manifiesto"
    class="movil-modal bg-rojo text-amarillo"
    aria-label={manifiesto.titulo}
  >
    <div class="movil-barra bg-rojo">
      <a href="#portada" class="meta border-r-2 border-tinta bg-amarillo px-4 font-bold text-tinta">
        <span aria-hidden="true">←</span>&nbsp; Volver
      </a>
      {/* El manifiesto lleva número dentro del índice, pero esta es su
          propia pantalla y no una fila de la lista: aquí el índice es el
          año, como en las demás pantallas que no tienen número. */}
      <span class="meta px-4 text-papel/80">{festival.anio}</span>
    </div>

    <div class="movil-cuerpo px-4 py-6">
      <h2 class="display text-[9cqw] leading-[1] text-amarillo">
        {manifiesto.titulo}
      </h2>

      <div class="mt-6 space-y-4">
        {
          manifiesto.parrafos.map((p) => (
            <p class="text-[0.95rem] leading-relaxed text-papel">{p}</p>
          ))
        }
      </div>

      <blockquote
        class="mt-8 border-l-4 border-amarillo pl-4 font-mono text-base leading-snug font-bold text-papel"
      >
        {manifiesto.cierre}
      </blockquote>
    </div>
  </section>
</div>
