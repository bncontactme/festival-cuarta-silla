---
import {
  festival,
  nav,
  inicio,
  accionPrincipal,
  registroEventos,
  privacidad,
} from '../data/site';
import { conBase } from '../lib/base';
import Marquee from './Marquee.astro';

/** El pie conserva el sitio entero, pero en una sola línea flexible. Registro
 *  sale de la lista porque ya vive como botón de acción. */
const enlaces = [
  inicio,
  ...nav.filter((item) => item.href !== registroEventos.href),
  accionPrincipal,
  { label: privacidad.titulo, href: '/privacidad' },
];
---

<footer class="border-t-2 border-amarillo bg-tinta text-papel">
  <Marquee
    items={[festival.fechas, festival.ciudad, 'Cuarta Silla', 'Arte Conceptual']}
    duracion="46s"
    inverso
    separador="●"
    class="meta border-b-2 border-amarillo py-3 text-amarillo"
  />

  <div class="px-4 py-8 sm:px-6 lg:px-10 lg:py-9">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <img
          src={conBase("/logos/wordmark-amarilla.svg")}
          alt="Cuarta Silla"
          width="533"
          height="85"
          class="w-40 sm:w-48"
        />
        <p class="meta max-w-xs text-papel/60">
          {festival.nombre} · {festival.ciudad}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a href={conBase(registroEventos.href)} class="boton boton--papel">
          {registroEventos.label}
        </a>

        {
          festival.donaciones.paypal && (
            <div>
              <a
                href={festival.donaciones.paypal}
                target="_blank"
                rel="noopener"
                class="boton"
              >
                ★ Donar ★
              </a>
            </div>
          )
        }
      </div>
    </div>

    <nav class="mt-7 border-t border-papel/20 pt-5" aria-label="Pie de página">
      <p class="sr-only">Navegación</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          enlaces.map((item) => (
            <li>
              <a href={conBase(item.href)} class="enlace text-sm">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="meta mt-5 border-t border-papel/15 pt-4 text-papel/45">
      {festival.creditoFooter}
    </p>
  </div>
</footer>
