---
import {
  festival,
  nav,
  inicio,
  accionPrincipal,
  registroEventos,
  privacidad,
} from '../data/site';
import { conBase } from '../lib/base';
import Marquee from './Marquee.astro';

/** El pie es el único sitio donde está el sitio entero: las pestañas, la
 *  destacada y las dos que no gastan pestaña arriba —la portada y el aviso
 *  legal—. Aquí no hay que ahorrar espacio, así que no se esconde nada.
 *
 *  El registro sale de `nav`, no suelto: cuando volvió a ser pestaña, tenerlo
 *  además en esta lista lo pintaba dos veces. */
const enlaces = [
  inicio,
  ...nav,
  accionPrincipal,
  { label: privacidad.titulo, href: '/privacidad' },
];
---

<footer class="border-t-2 border-amarillo bg-tinta text-papel">
  <Marquee
    items={[festival.fechas, festival.ciudad, 'Cuarta Silla', 'Arte Conceptual']}
    duracion="46s"
    inverso
    separador="●"
    class="meta border-b-2 border-amarillo py-3 text-amarillo"
  />

  <div class="px-4 py-14 sm:px-6 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <img
          src={conBase("/logos/wordmark-amarilla.svg")}
          alt="Cuarta Silla"
          width="533"
          height="85"
          class="w-44 sm:w-56"
        />
        <p class="meta mt-4 max-w-xs text-papel/60">
          {festival.nombre} · {festival.ciudad}
        </p>
      </div>

      <nav aria-label="Pie de página">
        <p class="meta mb-4 text-rojo">Navegación</p>
        <ul class="space-y-2">
          {
            enlaces.map((item) => (
              <li>
                <a href={conBase(item.href)} class="enlace text-lg">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* La columna que era «Participa → Convocatoria». Cerrada la
          convocatoria, lo que le queda por hacer a quien llega es apuntarse; y
          debajo, cuando exista la cuenta, el botón de donar. Sin enlace de
          PayPal no se pinta nada: en el pie hay sitio de sobra y un botón
          dormido aquí sería ruido —en el cierre de la portada sí sale, porque
          allí es lo único que hay debajo del logotipo—. */}
      <div>
        <p class="meta mb-4 text-rojo">Participa</p>
        <a href={conBase(registroEventos.href)} class="boton boton--papel">
          {registroEventos.label}
        </a>

        {
          festival.donaciones.paypal && (
            <div class="mt-6">
              <a
                href={festival.donaciones.paypal}
                target="_blank"
                rel="noopener"
                class="boton"
              >
                ★ Donar ★
              </a>
              <p class="meta mt-3 max-w-[26ch] leading-relaxed text-papel/45">
                {festival.donaciones.nota}
              </p>
            </div>
          )
        }
      </div>
    </div>

    <p class="meta mt-16 border-t-2 border-papel/20 pt-6 text-papel/45">
      {festival.creditoFooter}
    </p>
  </div>
</footer>
