---
import { imagen, juegoDeImagenes } from '../lib/imagen';
import type { Marca } from '../data/site';

/** Un logo de la cinta de marcas.
 *
 * Las marcas de las que todavía no tenemos archivo se pintan con el nombre en
 * display, en la misma caja y del mismo tamaño: un hueco honesto antes que un
 * logo inventado.
 *
 * Lleva la clase `mosaico` además de las utilidades: la cinta de marcas le
 * vuelca el canto a amarillo cuando la cara de la sección es oscura, y para eso
 * hace falta poder nombrarlo desde fuera.
 *
 * El logo pasa por `imagen()` y no por `conBase()` porque desde que hay panel
 * puede ser una URL de Cloudinary. La caja son 208 px de ancho: se pide el
 * doble para las pantallas densas y ahí se para. Un logo que sube alguien desde
 * el teléfono son cuatro megas, y en la cinta hay dieciocho. */
interface Props {
  marca: Marca;
  class?: string;
}

const { marca, class: clase = '' } = Astro.props;
---

<figure
  class={`mosaico flex aspect-[3/2] w-52 shrink-0 flex-col border-2 border-tinta bg-papel ${clase}`}
>
  <div class="flex min-h-0 flex-1 items-center justify-center p-4">
    {
      marca.logo ? (
      <img
        src={imagen(marca.logo, 416)}
        srcset={juegoDeImagenes(marca.logo, [208, 416]) || undefined}
        sizes="208px"
        alt={marca.nombre}
        loading="lazy"
        decoding="async"
        class="max-h-full w-auto max-w-full object-contain"
      />
      ) : (
        <span class="display text-center text-xl leading-none text-tinta/70">
          {marca.nombre}
        </span>
      )
    }
  </div>
</figure>
