---
import FichaArtista from './FichaArtista.astro';
import { artistas } from '../data/artistas';

/**
 * La reja de artistas, o el hueco cuando todavía no hay ninguno.
 *
 * Vive en un componente y no suelta en cada página porque la pintan dos: la
 * sección de la portada, recortada, y `/artistas` entera. Es la misma reja de
 * `sedes.astro` —tres columnas, cantos de 2 px, entrada escalonada por
 * filas—; lo único propio es el estado vacío.
 *
 * El vacío no es un error ni un cartel de obras: es la misma ficha de papel
 * con sombra dura que usa el resto del sitio, y dice lo único que no se ve
 * solo —cuándo habrá nombres—, no que no los haya. Mientras `artistas.lista`
 * esté vacía se pinta eso; en cuanto haya un nombre se pinta la reja. Nadie
 * tiene que venir a cambiar una plantilla.
 *
 * La reja no lleva cantos propios, igual que la de sedes: los filetes los
 * ponen las fichas (`border-r-2 border-b-2`) y el de arriba lo pone lo que
 * haya encima —el encabezado de la página, o la cabecera de la sección vía
 * `class`—. Poniéndolo aquí salían cuatro píxeles de raya en `/artistas`,
 * donde el `Encabezado` ya trae el suyo.
 */
interface Props {
  /** Cuántas fichas como mucho. Sin él, todas. */
  limite?: number;
  class?: string;
}

const { limite, class: clase = '' } = Astro.props;
const lista = limite ? artistas.lista.slice(0, limite) : artistas.lista;

/**
 * Cuántas celdas sobran en la última fila, en cada ancho.
 *
 * Las fichas se cargan de una en una, y con una sola la página era una tarjeta
 * a la izquierda y novecientos píxeles de amarillo vacío a su derecha: no se
 * lee como composición, se lee como que algo no cargó. La reja se termina con
 * una celda muda que sólo cierra los filetes de la fila, y que se va sola en
 * cuanto las fichas la llenan. Muda a propósito: un letrero contando lo que
 * falta convierte el final de una fila en una disculpa.
 *
 * En una columna —el móvil— no se pinta: debajo de una ficha, a lo ancho de la
 * pantalla, deja de ser el final de una fila y pasa a ser una tarjeta más.
 */
const resto2 = (2 - (lista.length % 2)) % 2;
const resto3 = (3 - (lista.length % 3)) % 3;
---

{
  lista.length === 0 ? (
    <div class={`ficha ficha--ancha max-w-3xl ${clase}`} data-reveal="escala">
      <p class="display text-4xl leading-[0.95] lg:text-5xl">
        {artistas.vacio.titulo}
      </p>
      <p class="mt-5 max-w-[52ch] font-mono text-sm leading-relaxed text-tinta/70">
        {artistas.vacio.nota}
      </p>
    </div>
  ) : (
    <ul class={`grid sm:grid-cols-2 lg:grid-cols-3 ${clase}`}>
      {lista.map((artista, i) => (
        <FichaArtista artista={artista} indice={i} retraso={(i % 3) * 90} />
      ))}

      {(resto2 > 0 || resto3 > 0) && (
        <li
          class:list={[
            'flex-col justify-end border-r-2 border-b-2 border-tinta p-6 lg:p-8',
            /* Se enseña sólo en el ancho donde de verdad sobra hueco. */
            resto2 > 0 ? 'hidden sm:flex' : 'hidden',
            resto3 > 0 ? 'lg:flex' : 'lg:hidden',
            resto3 === 2 && 'lg:col-span-2',
          ]}
          aria-hidden="true"
        />
      )}
    </ul>
  )
}
