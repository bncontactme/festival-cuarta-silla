---
import { conBase } from '../lib/base';
/** La silla del logo, como elemento gráfico recurrente.
 *
 * Vector extraído de `identidad visual.ai`. El respaldo lleva el logotipo
 * calado (transparente, no pintado), así que la silla es de un solo color y
 * deja ver el fondo por debajo del texto, como en el manual. */
interface Props {
  variante?: 'roja' | 'amarilla' | 'hueso';
  class?: string;
  style?: string;
  deriva?: boolean;
  alt?: string;
  /** La silla secreta: diez toques y lleva al juego. Sólo las de la
   *  portada —ver `src/scripts/silla-secreta.ts`—. */
  secreta?: boolean;
}

const {
  variante = 'roja',
  class: clase = '',
  style,
  deriva = false,
  alt = '',
  secreta = false,
} = Astro.props;
---

<img
  src={conBase(`/logos/silla-${variante}.svg`)}
  alt={alt}
  data-silla-secreta={secreta ? '' : undefined}
  aria-hidden={alt === '' ? 'true' : undefined}
  loading="lazy"
  decoding="async"
  width="316"
  height="420"
  class={`pointer-events-none select-none ${deriva ? 'deriva' : ''} ${clase}`}
  style={style}
/>
