---
import { nav, accionPrincipal, festival } from '../data/site';
import { conBase } from '../lib/base';

// `Astro.url.pathname` ya trae la base incorporada, así que el enlace se
// normaliza igual antes de comparar; si no, bajo un subdirectorio ninguna
// entrada quedaría marcada como la actual.
const limpia = (p: string) => p.replace(/\/$/, '') || '/';
const ruta = limpia(Astro.url.pathname);
const activo = (href: string) => (ruta === limpia(conBase(href)) ? 'page' : undefined);

// El nombre partido en dos renglones, «Festival de arte / conceptual», que es
// el corte del manual. Se parte aquí y no por ancho de caja: dejárselo al
// contenedor lo rompería por un sitio distinto en cada tamaño de pantalla.
const [nombreArriba, nombreAbajo] = ['Festival de arte', 'conceptual'];
---

<header
  class="sticky top-0 z-50 border-b-2 border-tinta bg-amarillo/95 backdrop-blur-sm"
>
  <!-- Progreso de lectura: 0 KB de JS donde hay scroll-driven animations -->
  <div
    class="progreso absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-rojo"
    aria-hidden="true"
  >
  </div>

  <div class="flex items-stretch justify-between">
    <a
      href={conBase("/")}
      class="vt-wordmark group flex items-center gap-3 border-r-2 border-tinta px-4 py-3 sm:px-6"
      aria-label={`${festival.nombreCompleto} — Inicio`}
    >
      <img
        src={conBase("/logos/silla-roja.svg")}
        alt=""
        width="316"
        height="420"
        class="h-8 w-auto transition-transform duration-500 ease-[var(--ease-salida)] group-hover:-rotate-6 sm:h-10"
      />
      <!-- El cliente pidió la barra así: la silla y «Festival de arte
           conceptual», sin el wordmark gótico —«que no diga festival de arte
           (CUARTA SILLA)», 26/08—.

           Dos líneas de mono miden ~22 px contra los 32/40 de la silla, así
           que la barra no cambia de alto. Y el wordmark gótico no se pierde:
           sigue en el cierre de la portada, en el pie y calado en el respaldo
           de la silla. -->
      <span
        class="meta block text-[0.5rem] leading-[1.55] text-rojo sm:text-[0.6rem]"
      >
        {nombreArriba}<br />{nombreAbajo}
      </span>
    </a>

    <!-- Escritorio -->
    <nav class="hidden items-stretch lg:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={conBase(item.href)}
            aria-current={activo(item.href)}
            class="meta flex items-center border-l-2 border-tinta px-5 transition-colors duration-300 hover:bg-rojo hover:text-amarillo aria-[current=page]:bg-tinta aria-[current=page]:text-amarillo"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={conBase(accionPrincipal.href)}
        aria-current={activo(accionPrincipal.href)}
        class="meta flex items-center gap-2 border-l-2 border-tinta bg-rojo px-6 font-bold text-amarillo transition-colors duration-300 hover:bg-tinta aria-[current=page]:bg-tinta"
      >
        ★ {accionPrincipal.label} ★
      </a>
    </nav>

    <!-- Móvil -->
    <button
      type="button"
      data-menu-boton
      aria-expanded="false"
      aria-controls="menu-movil"
      class="menu-boton meta relative z-50 flex items-center gap-2 border-l-2 border-tinta px-5 font-bold lg:hidden"
    >
      <span class="menu-abrir">Menú</span>
      <span class="menu-cerrar">Cerrar</span>
      <span class="menu-aspas" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<!-- Panel móvil: cortina roja de arriba a abajo -->
<div
  id="menu-movil"
  data-menu-panel
  data-abierto="false"
  class="menu-panel fixed inset-0 z-40 bg-rojo lg:hidden"
>
  <nav
    class="flex h-full flex-col justify-center gap-2 px-6 pt-20"
    aria-label="Principal (móvil)"
  >
    {
      nav.map((item, i) => (
        <a
          href={conBase(item.href)}
          aria-current={activo(item.href)}
          class="display display-centro block text-[13vw] text-amarillo transition-colors duration-300 hover:text-tinta aria-[current=page]:text-tinta"
          style={`transition-delay: ${i * 40}ms`}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={conBase(accionPrincipal.href)}
      aria-current={activo(accionPrincipal.href)}
      class="meta mt-8 inline-flex items-center justify-center gap-2 border-2 border-amarillo px-6 py-4 font-bold text-amarillo"
    >
      ★ {accionPrincipal.label} ★
    </a>
  </nav>
</div>
