---
/**
 * Las dos maneras de mirar el programa en la portada: por horas y en rejilla.
 *
 * «Por horas» es la banda del ahora —qué hay abierto, hasta qué hora y qué
 * entra después—, y es la de arranque: quien abre la portada durante el
 * festival pregunta qué está pasando, no cómo se reparte la jornada.
 *
 * «Rejilla» es lo que había: el carril de los cuatro días y la silueta del que
 * se elija. Contesta «qué se pisa con qué» y lo contesta con una forma, sin
 * una palabra dentro — buenísima para eso, inútil para saber cómo se llama lo
 * que uno está mirando.
 *
 * Las dos se turnan el mismo hueco, y no se apilan. Apiladas eran dos bloques
 * hablando del programa uno debajo del otro, y el de abajo no lo veía nadie.
 *
 * ── Qué entra y por dónde ────────────────────────────────────────────────
 *
 * Las dos vistas llegan por ranura y no se construyen aquí dentro: la banda
 * tiene su reloj y su propio componente, y la rejilla la monta la portada con
 * sus opciones —mini, resumen, atada al carril—. Este componente sólo es el
 * mando y el hueco.
 *
 * ── Y si la banda no tiene nada que decir ────────────────────────────────
 *
 * La banda se esconde sola cuando el festival ya terminó. Si eso pasa, la
 * vista de arranque sería un hueco vacío, así que el mando se cae entero y
 * queda la rejilla — que es exactamente lo que había antes de todo esto.
 */
---

<div class="vistas" data-vistas>
  {/* El mando. Al canto izquierdo, en la misma vertical que el rótulo, el
      titular y el carril: la sección se lee por ahí. */}
  <div class="conmutador vistas-mando" role="tablist" aria-label="Cómo ver el programa">
    <span class="conmutador-burbuja" aria-hidden="true"></span>
    <button
      type="button"
      role="tab"
      class="conmutador-opcion"
      data-vista="horas"
      id="vista-horas"
      aria-controls="panel-horas"
      aria-selected="true"
    >
      Por horas
    </button>
    <button
      type="button"
      role="tab"
      class="conmutador-opcion"
      data-vista="rejilla"
      id="vista-rejilla"
      aria-controls="panel-rejilla"
      aria-selected="false"
      tabindex="-1"
    >
      Gantt
    </button>
  </div>

  <div
    class="panel-vista"
    id="panel-horas"
    role="tabpanel"
    aria-labelledby="vista-horas"
    data-panel-vista="horas"
  >
    <slot name="horas" />
  </div>

  <div
    class="panel-vista"
    id="panel-rejilla"
    role="tabpanel"
    aria-labelledby="vista-rejilla"
    data-panel-vista="rejilla"
    hidden
  >
    <slot name="rejilla" />
  </div>
</div>

<style>
  /* ── La pista del conmutador ─────────────────────────────────────────
     En papel, y ésta es la única decisión del mando que importa.

     El conmutador de `global.css` nace con la pista transparente: vive sobre
     campos claros, así que la celda apagada es letra de tinta sobre el propio
     campo y la burbuja es lo único macizo. Aquí el campo es rojo y tinta sobre
     rojo son 4,2:1 para una letra de 11 px, así que la pista tiene que traer
     campo propio.

     Fue amarilla y era un error: sobre rojo, el amarillo es el color con el
     que este sitio dice «mira esto». La celda APAGADA salía gritando más que
     la burbuja de tinta, y el mando se leía como dos cosas encendidas a la vez
     en vez de como una elegida entre dos. En papel la pista se calla, la
     burbuja vuelve a ser lo único macizo, y se ve de un golpe cuál está
     puesta. */
  .vistas-mando {
    display: inline-grid;
    margin-bottom: 1.25rem;
    background-color: var(--color-papel);
  }

  /* Y la apagada, además, más tenue que la puesta: el color hace la mitad del
     trabajo y la burbuja la otra mitad. */
  .vistas-mando .conmutador-opcion:not([aria-selected='true']) {
    color: var(--color-apagado);
  }
</style>

<script>
  /**
   * El mando de las dos vistas.
   *
   * Sin JavaScript no hay mando —los `hidden` salen del build— y lo que queda
   * es la banda, que es la vista de arranque. Se pierde poder cambiar, no se
   * pierde nada de lo que hay que leer.
   */
  const marco = document.querySelector<HTMLElement>('[data-vistas]');

  if (marco) {
    const mando = marco.querySelector<HTMLElement>('.conmutador')!;
    const pestanas = [...marco.querySelectorAll<HTMLElement>('[data-vista]')];
    const paneles = [...marco.querySelectorAll<HTMLElement>('[data-panel-vista]')];

    const verVista = (cual: string) => {
      pestanas.forEach((p, i) => {
        const suya = p.dataset.vista === cual;
        p.setAttribute('aria-selected', String(suya));
        /* Una sola parada de tabulador para el mando entero, que es como se
           recorre un grupo de pestañas: dentro se cambia con las flechas. */
        p.tabIndex = suya ? 0 : -1;
        /* Y dónde se para la burbuja. El conmutador de `global.css` la mueve
           en múltiplos exactos de una celda, así que aquí sólo va el número. */
        if (suya) mando.style.setProperty('--activa', String(i));
      });

      for (const panel of paneles) {
        const suyo = panel.dataset.panelVista === cual;
        panel.hidden = !suyo;
        /* La vista que entra sube desde abajo, como las cortinas del resto del
           sitio. El estado se quita al acabar para que la próxima vez vuelva a
           dispararse. */
        if (suyo) {
          panel.dataset.estado = 'entrando';
          panel.addEventListener('animationend', () => delete panel.dataset.estado, {
            once: true,
          });
        }
      }
    };

    mando.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest<HTMLElement>('[data-vista]');
      if (boton?.dataset.vista) verVista(boton.dataset.vista);
    });

    /* Flechas dentro del mando, que es lo que un grupo de pestañas tiene que
       hacer con el teclado. */
    mando.addEventListener('keydown', (e) => {
      const paso = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!paso) return;
      e.preventDefault();
      const ahora = pestanas.findIndex((p) => p.getAttribute('aria-selected') === 'true');
      const siguiente = pestanas[(ahora + paso + pestanas.length) % pestanas.length];
      verVista(siguiente.dataset.vista!);
      siguiente.focus();
    });

    /**
     * Y el caso en que «Por horas» no tiene nada que enseñar.
     *
     * La banda se esconde sola con el festival terminado. Sin esto, la portada
     * arrancaría en una vista vacía con un mando que promete algo que no está.
     * Cuando eso pasa se cae el mando entero y queda la rejilla: dos celdas de
     * las que una no lleva a ningún sitio son peores que ninguna celda.
     *
     * Se mira en el siguiente cuadro porque la banda se pinta en su propio
     * script, y los dos módulos no tienen orden garantizado entre sí.
     */
    requestAnimationFrame(() => {
      const banda = marco.querySelector<HTMLElement>('[data-panel-vista="horas"] [data-ahora]');
      if (banda && banda.hidden) {
        verVista('rejilla');
        mando.hidden = true;
      }
    });
  }
</script>
