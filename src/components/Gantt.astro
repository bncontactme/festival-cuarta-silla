---
import { conBase } from '../lib/base';
import {
  actividades,
  coloresGantt,
  festival,
  programa,
  sedeDe,
  enlaceMapa,
  enTodasLasSedes,
} from '../data/site';

/**
 * La rejilla de barras del programa.
 *
 * El tiempo corre de izquierda a derecha y cada línea es una sede —o un día,
 * en el resumen de la portada—, así que de un vistazo se ve qué hay a la vez
 * y dónde. La lista del programa dice qué pasa; esto dice cómo se pisan las
 * cosas entre sí, que es la pregunta que no contesta una lista.
 *
 * Todo se coloca en el build: cada barra llega al navegador con su columna de
 * inicio y su largo puestos. El JS sólo cambia de día, enseña el globo y abre
 * la ficha.
 */
interface Props {
  /** `sede`: una línea por sede del día elegido, con selector de día.
   *  `dia`: una línea por día, todo el festival a la vez y sin selector. */
  agrupar?: 'sede' | 'dia';
  /** Sin ficha ni leyenda: el resumen de la portada sólo enseña la forma. */
  resumen?: boolean;
  /** Versión de bolsillo: un solo día —el que toca hoy—, barras finas y sin
   *  texto, y una hora de cada tres. Cabe dentro de una columna. */
  mini?: boolean;
  /** Selector CSS de una lista de días que vive FUERA del componente y hace
   *  de pestañas. La portada lo usa: la lista de los cuatro días de la
   *  derecha manda sobre la rejilla de la izquierda. Sin esto había dos
   *  mandos para lo mismo —el rótulo del mini decía un día y la lista de al
   *  lado los cuatro, sin que uno supiera del otro—. */
  selector?: string;
  class?: string;
}

const {
  agrupar = 'sede',
  resumen = false,
  mini = false,
  selector,
  class: clase = '',
} = Astro.props;

/** Un nombre propio para esta rejilla. La ficha y el globo son hermanos del
 *  marco y no hijos —tienen que poder salirse de él—, así que sin un nombre
 *  dos rejillas en la misma página compartirían la ficha de la primera. */
const id = `gantt-${Math.random().toString(36).slice(2, 8)}`;

/** Minutos por columna.
 *
 * Fueron 30 y era un error latente: `grid-column` no admite decimales, y una
 * actividad que empiece a y cuarto caía en la columna «4.5». El navegador
 * descarta la regla entera y coloca esa barra donde le toque por orden
 * automático —o sea, al final de la fila, a las diez de la noche—. Con el
 * programa de ejemplo, todo a en punto y a y media, no se veía; con la
 * programación de verdad se habría visto el primer día.
 *
 * A cuarto de hora entran las horas que escribe cualquiera, y lo que no sea
 * múltiplo de quince se redondea al cuarto más cercano en vez de romperse.
 * Que sean cuatro columnas por hora en vez de dos no ensancha nada: el ancho
 * mínimo de la rejilla se mide por hora (`--ancho-hora`), no por columna. */
const PASO = 15;

const aMinutos = (hhmm: string) => {
  const [h, m] = hhmm.split(':').map(Number);
  return h * 60 + m;
};
const aReloj = (min: number) => `${String(Math.floor(min / 60)).padStart(2, '0')}:00`;

/**
 * El eje de horas, medido sobre las actividades que va a enseñar esta rejilla.
 *
 * **Y por eso se calcula por panel y no una vez para todo.** Se medía sobre el
 * programa entero, así que un jueves que empieza a las siete de la tarde
 * heredaba el eje del viernes —que abre a las dos— y salía con media rejilla en
 * blanco antes de la primera barra. Cada día trae sus horas y nada más: lo que
 * no tiene evento no ocupa sitio.
 *
 * En la vista por días sí se mide sobre todo, y también es lo correcto: ahí las
 * cuatro líneas son los cuatro días y tienen que compartir eje para poder
 * compararse.
 */
const ejeDe = (lista: typeof actividades) => {
  if (!lista.length) return { desde: 0, hasta: 0, columnas: 0, horas: [] as number[] };
  const desde = Math.floor(Math.min(...lista.map((a) => aMinutos(a.inicio))) / 60) * 60;
  const hasta = Math.ceil(Math.max(...lista.map((a) => aMinutos(a.fin))) / 60) * 60;
  return {
    desde,
    hasta,
    columnas: (hasta - desde) / PASO,
    horas: Array.from({ length: (hasta - desde) / 60 }, (_, i) => desde + i * 60),
  };
};

/** Cuántas columnas mide una hora. Lo usan las guías y la fila del reloj. */
const porHora = 60 / PASO;
/** En mini se rotula una hora de cada tres: trece rótulos en una columna de
 *  portada se tocan entre sí y no se lee ninguno. */
const cadaHora = mini ? 3 : 1;

/** Cuántas sedes caben en el resumen de la portada antes de que la tarjeta
 *  deje de ser un adelanto y se convierta en la página del programa metida a
 *  la fuerza en media columna. Lo que no entra no se esconde: se cuenta en una
 *  línea de resumen que dice cuántas son y en qué franja del día pasan. */
const MAX_LINEAS_MINI = 6;

/** Y cuántos carriles se le consienten a una sede dentro del resumen. Una sola
 *  sede con seis cosas a la vez levantaba la tarjeta media pantalla ella sola,
 *  y en un adelanto sin texto dentro de las barras el sexto carril no aporta
 *  nada: se ve que hay bulto, que es todo lo que un resumen tiene que decir.
 *  Lo que no entra tampoco se pierde — se suma a la línea de abajo. */
const MAX_CARRILES_MINI = 2;

/** Una barra ya colocada: +2 en la columna porque la 1 es la de etiquetas.
 *  `desde` es el arranque del eje de SU panel, no el del programa entero. */
const aBarra = (a: (typeof actividades)[number], desde: number) => ({
  ...a,
  col: Math.round((aMinutos(a.inicio) - desde) / PASO) + 2,
  largo: Math.max(1, Math.round((aMinutos(a.fin) - aMinutos(a.inicio)) / PASO)),
  sedeInfo: sedeDe(a.sede),
  cuando: `${programa.dias[a.dia].dia} ${programa.dias[a.dia].fecha} · ${a.inicio}–${a.fin}`,
});

/**
 * Carriles: cuántas líneas hace falta apilar para que dos cosas que pasan a
 * la vez no se pisen.
 *
 * Sin esto la rejilla se apaña sola —el grid empuja a una fila nueva lo que
 * no cabe—, pero la etiqueta se queda arriba y las líneas de abajo salen sin
 * nombre a la izquierda: parecen de otro. Repartiéndolas aquí, cada barra
 * sabe su fila exacta y la etiqueta puede abarcar de la primera a la última.
 *
 * El reparto es el de toda la vida: cada actividad va al primer carril que ya
 * esté libre a esa hora, y si no hay ninguno se abre otro.
 */
let siguienteFila = 2; // la 1 es la cabecera de horas

const enCarriles = (lista: ReturnType<typeof aBarra>[], tope = Infinity) => {
  const ocupadoHasta: number[] = [];
  const barras: (ReturnType<typeof aBarra> & { fila: number })[] = [];
  /** Lo que no cupo dentro del tope de carriles. En la rejilla grande no hay
   *  tope y esto sale siempre vacío. */
  const sobran: ReturnType<typeof aBarra>[] = [];

  for (const b of [...lista].sort((x, y) => aMinutos(x.inicio) - aMinutos(y.inicio))) {
    const inicio = aMinutos(b.inicio);
    let carril = ocupadoHasta.findIndex((fin) => fin <= inicio);
    if (carril === -1) {
      if (ocupadoHasta.length >= tope) {
        sobran.push(b);
        continue;
      }
      carril = ocupadoHasta.push(0) - 1;
    }
    ocupadoHasta[carril] = aMinutos(b.fin);
    barras.push({ ...b, fila: siguienteFila + carril });
  }

  const alto = Math.max(1, ocupadoHasta.length);
  const filaBase = siguienteFila;
  siguienteFila += alto;
  return { barras, sobran, filaBase, alto };
};

/* Dos formas de agrupar la misma lista. Por sede son cuatro rejillas, una por
   día; por día es una sola con los cuatro días como líneas. */
const paneles =
  agrupar === 'sede'
    ? programa.dias.map((d, i) => {
        // Cada día es su propia rejilla y empieza a contar filas de cero.
        siguienteFila = 2;
        const delDia = actividades.filter((a) => a.dia === i);
        const eje = ejeDe(delDia);

        /* Las sedes, por la hora a la que abren. Antes salían en el orden en
           que estaban escritas en los datos, que no es un orden: la rejilla se
           leía a saltos —una sede de la tarde, otra de la mañana, otra de la
           tarde— y había que recorrerla entera para saber cómo empieza el día.
           Puestas por su primera actividad, las barras bajan en diagonal y el
           día se lee de un vistazo, que es lo único que se le pide a esto. */
        const abre = (sede: string) =>
          Math.min(...delDia.filter((a) => a.sede === sede).map((a) => aMinutos(a.inicio)));
        const nombres = [...new Set(delDia.map((a) => a.sede))].sort(
          (x, y) => abre(x) - abre(y),
        );

        // En la portada sólo caben unas cuantas: el resto va a la línea de
        // resumen de más abajo.
        const visibles = mini ? nombres.slice(0, MAX_LINEAS_MINI) : nombres;
        const fuera = nombres.slice(visibles.length);

        const lineas = visibles.map((sede) => {
          const propias = delDia.filter((a) => a.sede === sede);
          return {
            etiqueta: sede,
            nota: `${propias.length}`,
            ...enCarriles(propias.map((a) => aBarra(a, eje.desde)), mini ? MAX_CARRILES_MINI : Infinity),
          };
        });

        /* Lo que no cupo, en una sola barra rayada: cuántas sedes son, cuántas
           actividades y —lo que de verdad importa en un gráfico de tiempo— en
           qué tramo del día caen. Es un adelanto: la puerta al programa
           entero está en la propia barra.
           Cae aquí lo de las sedes que no entraron y también lo que se salió
           del tope de carriles de las que sí. */
        const sobrantes = [
          ...delDia.filter((a) => fuera.includes(a.sede)),
          ...lineas.flatMap((l) => l.sobran),
        ];
        const resto = sobrantes.length
          ? (() => {
              const ini = Math.min(...sobrantes.map((a) => aMinutos(a.inicio)));
              const fin = Math.max(...sobrantes.map((a) => aMinutos(a.fin)));
              const fila = siguienteFila;
              siguienteFila += 1;
              return {
                // Sin sedes fuera el rótulo no puede decir «+0 sedes».
                etiqueta: fuera.length ? `+${fuera.length} sedes` : '+ más',
                actos: sobrantes.length,
                fila,
                col: Math.round((ini - eje.desde) / PASO) + 2,
                largo: Math.max(1, Math.round((fin - ini) / PASO)),
                tramo: `${aReloj(Math.floor(ini / 60) * 60)}–${aReloj(Math.ceil(fin / 60) * 60)}`,
              };
            })()
          : null;

        return {
          ...eje,
          clave: String(i),
          titulo: d.dia,
          fecha: d.fecha,
          iso: `${(() => {
            const p = new Date(festival.inicioISO);
            p.setDate(p.getDate() + i);
            return `${p.getFullYear()}-${String(p.getMonth() + 1).padStart(2, '0')}-${String(p.getDate()).padStart(2, '0')}`;
          })()}`,
          total: delDia.length,
          sedes: nombres.length,
          lineas,
          resto,
          filas: siguienteFila - 2,
        };
      })
    : (() => {
        siguienteFila = 2;
        // Las cuatro líneas son los cuatro días: comparten eje para poder
        // compararse, así que aquí el rango sí sale de todo el programa.
        const eje = ejeDe(actividades);
        const lineas = programa.dias.map((d, i) => ({
          etiqueta: mini ? d.dia.slice(0, 3) : d.dia,
          nota: mini ? '' : d.fecha.replace(' de septiembre', ' sep'),
          ...enCarriles(actividades.filter((a) => a.dia === i).map((a) => aBarra(a, eje.desde))),
        }));
        return [
          {
            ...eje,
            clave: '0',
            titulo: '',
            fecha: '',
            iso: '',
            total: actividades.length,
            sedes: lineas.length,
            lineas,
            resto: null,
            filas: siguienteFila - 2,
          },
        ];
      })();

/** Cuánto apretar la rejilla. Un día con cuatro actividades y un día con
 *  treinta no pueden dibujarse con la misma fila: a partir de cierto número de
 *  carriles la rejilla deja de caber en una pantalla y hay que bajar por ella
 *  como por una lista, que es justo lo que un Gantt viene a evitar.
 *  En «mucho» las barras además se quedan sólo con el título: la hora la dice
 *  el globo al pasar por encima, y a esa altura no cabían las dos líneas. */
const densidad = (filas: number) => (filas > 12 ? 'mucho' : filas > 6 ? 'si' : undefined);
---

<div
  class={`gantt-marco ${mini ? 'gantt-marco--mini ficha' : ''} ${clase}`}
  data-gantt={id}
  data-selector={selector}
>
  {/* El rótulo del mini es una línea de Courier y nada más: qué día se está
      enseñando y cuánto tiene. Antes era una cabecera de tinta a sangre que
      repetía el nombre del día que la lista de al lado ya decía. */}
  {
    mini && (
      <p class="gantt-rotulo">
        <span data-rotulo-dia>
          {paneles[0].titulo} {paneles[0].fecha}
        </span>
        <span class="gantt-rotulo-nota" data-rotulo-nota>
          {paneles[0].total === 0
            ? 'Por anunciar'
            : `${paneles[0].total} actividades · ${paneles[0].sedes} sedes`}
        </span>
      </p>
    )
  }

  {
    agrupar === 'sede' && !mini && !selector && (
      <div class="conmutador conmutador--dias gantt-dias" data-selector-dia>
        <span class="conmutador-burbuja" aria-hidden="true" />
        {paneles.map((p, i) => (
          <button
            type="button"
            class="conmutador-opcion"
            data-dia={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="conmutador-opcion-dia">{p.titulo}</span>
            <span class="conmutador-opcion-nota">
              {p.fecha.replace(' de septiembre', '')} / {p.total}
            </span>
          </button>
        ))}
      </div>
    )
  }

  {/* `overflow-x`: en una ventana angosta la rejilla no se comprime hasta ser
      ilegible, se arrastra. El cuarto de hora tiene que seguir midiendo lo
      que mide. */}
  <div class="gantt-scroll" data-scroll>
    {
      paneles.map((panel, i) => panel.total === 0 ? (
        /* Un día sin nada no es una rejilla vacía: es una frase. Con el eje, la
           cabecera de horas y las guías puestas sobre cero barras, lo que se
           veía era una caja en blanco con un reloj encima — se lee como que
           algo no cargó, no como que ese día todavía no hay programa. */
        <div
          class="gantt-vacio"
          data-panel={i}
          data-fecha={panel.iso}
          data-nombre={panel.titulo}
          data-dia-fecha={panel.fecha}
          data-total="0"
          data-sedes="0"
          hidden={i !== 0}
        >
          <p>Este día todavía no tiene actividades anunciadas.</p>
        </div>
      ) : (
        <div
          class="gantt"
          style={`--columnas:${panel.columnas};--horas:${panel.horas.length};--filas:${panel.filas}`}
          data-panel={i}
          data-denso={densidad(panel.filas)}
          data-fecha={panel.iso}
          data-nombre={panel.titulo}
          data-dia-fecha={panel.fecha}
          data-total={panel.total}
          data-sedes={panel.sedes}
          hidden={i !== 0}
        >
          {/* Guías: una celda por hora, de la cabecera al suelo. Es lo que deja
              leer a qué hora cae una barra sin seguir la fila con el dedo. */}
          {panel.horas.map((_, h) => (
            <div
              class="gantt-guia"
              style={`grid-column:${h * porHora + 2} / span ${porHora}`}
              aria-hidden="true"
            />
          ))}

          <div class="gantt-esquina" />
          {panel.horas.map((hora, h) => (
            <div
              class="gantt-hora"
              style={`grid-column:span ${porHora}`}
              data-ultima={h === panel.horas.length - 1 ? '' : undefined}
            >
              {h % cadaHora === 0 ? aReloj(hora) : ''}
            </div>
          ))}

          {panel.lineas.map((linea) => (
            <>
              {/* Banda de la fila: existe para que el filete cruce la rejilla
                  entera. Puesto en la etiqueta se cortaba donde terminaba el
                  nombre y las filas no se leían como filas. */}
              <div
                class="gantt-fila"
                style={`grid-row:${linea.filaBase} / span ${linea.alto}`}
                aria-hidden="true"
              />
              <div
                class="gantt-etiqueta"
                style={`grid-row:${linea.filaBase} / span ${linea.alto}`}
                data-apilada={linea.alto > 1 ? '' : undefined}
              >
                <span class="gantt-etiqueta-nombre" title={linea.etiqueta}>
                  {linea.etiqueta}
                </span>
                <span class="gantt-etiqueta-nota">{linea.nota}</span>
              </div>

              {linea.barras.map((a) => (
                <button
                  type="button"
                  class="gantt-barra"
                  style={`grid-column:${a.col} / span ${a.largo};grid-row:${a.fila};--fondo:${coloresGantt[a.tipo].fondo};--texto:${coloresGantt[a.tipo].texto}`}
                  {/* El nombre entero va en el `aria-label` y no en lo que se
                      ve: en el resumen de la portada las barras van sin texto
                      —a esa escala no cabe— y con el título escondido se
                      quedaban sin nombre ninguno, o sea catorce botones que un
                      lector de pantalla anuncia como «botón». */}
                  aria-label={`${a.titulo} · ${a.tipo} · ${a.inicio}–${a.fin} · ${a.sede}`}
                  data-barra
                  data-titulo={a.titulo}
                  data-tipo={a.tipo}
                  data-artista={a.artista ?? ''}
                  data-cuando={a.cuando}
                  data-horas={`${a.inicio}–${a.fin}`}
                  data-sede={a.sede}
                  data-direccion={
                    enTodasLasSedes(a.sede)
                      ? 'El recorrido pasa por las sedes del festival'
                      : (a.sedeInfo?.direccion ?? '')
                  }
                  data-mapa={a.sedeInfo ? enlaceMapa(a.sedeInfo) : ''}
                  data-registro={a.registro ?? ''}
                  data-libre={a.libre ? 'si' : ''}
                  data-color={coloresGantt[a.tipo].fondo}
                >
                  <span class="gantt-barra-titulo">{a.titulo}</span>
                  <span class="gantt-barra-hora">
                    {a.inicio}–{a.fin}
                  </span>
                </button>
              ))}
            </>
          ))}

          {panel.resto && (
            <>
              <div class="gantt-fila" style={`grid-row:${panel.resto.fila}`} aria-hidden="true" />
              <div class="gantt-etiqueta" style={`grid-row:${panel.resto.fila}`}>
                <span class="gantt-etiqueta-nombre">{panel.resto.etiqueta}</span>
              </div>
              {/* Al día que se estaba mirando, no al programa por defecto.
                  Llevaba a `/programa` a secas, así que pulsar «+1 sedes» en el
                  viernes abría el jueves y había que volver a buscar el día del
                  que venías — con la mitad de la gracia del adelanto perdida en
                  el camino. El `#dia-N` lo recoge el script de `/programa`. */}
              <a
                class="gantt-resto"
                href={conBase(`/programa#dia-${panel.clave}`)}
                style={`grid-column:${panel.resto.col} / span ${panel.resto.largo};grid-row:${panel.resto.fila}`}
              >
                <span>
                  {panel.resto.actos === 1
                    ? '1 actividad más'
                    : `${panel.resto.actos} actividades más`} · {panel.resto.tramo} ↗
                </span>
              </a>
            </>
          )}
        </div>
      ))
    }
  </div>

  {/* El pie del mini. Las barras van sin texto —a esta escala no cabe—, así
      que lo que dicen se lee aquí al pasarles por encima, además de en el
      globo. Reserva su alto desde el principio para que la rejilla no dé un
      salto al llenarse. */}
  {
    mini && (
      <p class="gantt-pista" data-pista aria-hidden="true">
        Pasa el cursor sobre una barra
      </p>
    )
  }

  {/* El pie: la leyenda a un lado y, al otro, lo que la página quiera poner
      ahí —en `/programa`, el aviso de que la rejilla es un montaje—. Juntos
      en un renglón y no apilados: son dos notas al margen, y cada una en su
      línea eran dos párrafos de más antes de llegar al gráfico. */}
  {
    !resumen && (
      <div class="gantt-pie">
        <ul class="gantt-leyenda">
          {Object.entries(coloresGantt).map(([tipo, color]) => (
            <li>
              <span class="gantt-muestra" style={`background:${color.fondo}`} aria-hidden="true" />
              {tipo}
            </li>
          ))}
        </ul>
        <slot name="pie" />
      </div>
    )
  }
</div>

{/* El globo: lo que dice una barra al pasarle por encima.
    No es la ficha en pequeño, es lo contrario de la ficha. La ficha se abre
    con un clic, se queda, se puede señalar con el ratón y tiene botones; el
    globo aparece y desaparece con el cursor, no se puede tocar y sólo dice
    las cuatro cosas que hacen falta para saber si eso te interesa: de qué
    tipo es, cómo se llama, cuándo y dónde.

    Antes esto lo hacía la propia ficha en `pointerover`: una tarjeta de 22 rem
    con dos botones que saltaba de sitio cada vez que el cursor cruzaba la
    rejilla, y que además tapaba las barras vecinas —que en un día apretado son
    justo las que uno está comparando—. */}
{/* `aria-hidden`: lo que dice el globo ya está, palabra por palabra, en el
    `aria-label` de la barra que lo abre. Anunciado dos veces sería ruido. */}
<div class="gantt-globo" data-globo={id} aria-hidden="true" hidden>
  <span class="gantt-globo-tipo" data-g-tipo></span>
  <p class="gantt-globo-titulo" data-g-titulo></p>
  <p class="gantt-globo-artista" data-g-artista></p>
  <p class="gantt-globo-meta">
    <span data-g-hora></span>
    <span class="gantt-globo-sede" data-g-sede></span>
  </p>
</div>

{
  /* La ficha. Una sola para todas las barras: se rellena al abrirla.
     Hay que poder leer quién la da, dónde es y entrar al registro, así que es
     una tarjeta de verdad: se queda abierta, se puede señalar con el ratón y
     tiene botones. La abre el clic; el hover es cosa del globo. */
  !resumen && (
    <div class="gantt-ficha" data-ficha={id} data-lenis-prevent hidden>
      <button type="button" class="gantt-ficha-cerrar" data-ficha-cerrar aria-label="Cerrar">
        ✕
      </button>

      <p class="gantt-ficha-tipo" data-f-tipo />
      <h3 class="gantt-ficha-titulo" data-f-titulo />
      <p class="gantt-ficha-artista" data-f-artista />

      <dl class="gantt-ficha-datos">
        <div>
          <dt>Cuándo</dt>
          <dd data-f-cuando />
        </div>
        <div>
          <dt>Dónde</dt>
          <dd>
            <span class="gantt-ficha-sede" data-f-sede />
            <span class="gantt-ficha-direccion" data-f-direccion />
          </dd>
        </div>
      </dl>

      <div class="gantt-ficha-acciones">
        {/* El rótulo lo pone el script: con Tally la ficha se abre encima de la
            página y no lleva flecha; con Google Forms —o cualquier otro— se va
            a otra pestaña y sí. */}
        <a class="gantt-ficha-boton" target="_blank" rel="noopener" data-f-registro>
          Registrarme
        </a>
        <a
          class="gantt-ficha-boton gantt-ficha-boton--suave"
          target="_blank"
          rel="noopener"
          data-f-mapa
        >
          Ver en el mapa ↗
        </a>
      </div>

      {/* Sin formulario hay dos casos distintos y antes se decían igual: que
          la actividad no pida registro —que es una respuesta— y que todavía no
          nos hayan pasado el Tally —que es un hueco—. El texto lo pone el
          script según `data-libre`. */}
      <p class="gantt-ficha-sin" data-f-sin hidden></p>
    </div>
  )
}

<style>
  /* ── Marco ─────────────────────────────────────────────────────────── */
  .gantt-marco {
    --alto-fila: 3.75rem;
    --etiqueta: 11rem;
    /* Lo que mide una hora cuando la rejilla se queda sin sitio. El ancho
       mínimo se mide por hora y no por columna: son cuatro columnas por hora
       —el cuarto de hora es la unidad de colocación— y atarle un mínimo a cada
       una multiplicaría por cuatro el ancho mínimo de la rejilla entera. */
    --ancho-hora: 3.5rem;
    /* El fondo sobre el que se apoya. Lo necesitan la columna de sedes y la
       fila de horas, que van pegadas al arrastrar: transparentes dejarían
       pasar las barras por debajo. */
    --papel: var(--color-papel);
  }

  /* Cabecera de la tarjeta del mini: qué día se está enseñando y cuánto
     tiene. Sin ella, unas barras sueltas no dicen de cuándo son.
     Del mismo cuerpo que los rótulos «03 / Programa» de las secciones: es una
     anotación, no un titular; el titular de la sección está justo encima y
     dos titulares seguidos no se leen. */
  .gantt-rotulo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .gantt-rotulo-nota {
    font-weight: 400;
    color: color-mix(in srgb, var(--color-tinta) 45%, transparent);
  }

  /* Las pestañas de día son el conmutador de burbuja de `global.css`; aquí
     sólo queda separarlas de la rejilla que mandan. */
  .gantt-dias {
    margin-bottom: 1.5rem;
  }

  /* ── Rejilla ───────────────────────────────────────────────────────── */
  /* Sin caja propia: en `/programa` la rejilla vive dentro de una ficha —canto
     de 2 px, sombra dura, papel blanco— y una caja dentro de otra caja es
     ruido; en la portada, dentro de la ficha del mini. */
  .gantt-scroll {
    overflow-x: auto;
  }
  .gantt {
    display: grid;
    /* Columnas sin mínimo propio: el mínimo de la rejilla lo pone `min-width`,
       una vez, medido en horas. */
    grid-template-columns: var(--etiqueta) repeat(var(--columnas), minmax(0, 1fr));
    min-width: calc(var(--etiqueta) + var(--horas) * var(--ancho-hora));
    /* Las filas, explícitas. No es cosmético: las guías van de la fila 2 a la
       `-1`, y los índices negativos sólo cuentan líneas *explícitas*. Con las
       filas implícitas, esa `-1` se resolvía a la línea 1 y las guías caían
       encima de la cabecera, empujando las horas media rejilla a la derecha. */
    grid-template-rows: auto repeat(var(--filas), minmax(var(--alto-fila), auto));
    align-items: center;
  }

  /* Un día con treinta actividades no se dibuja con la fila de un día con
     cuatro: a partir de ahí la rejilla deja de caber en una pantalla y se
     recorre como una lista, que es justo lo que un gráfico de tiempo viene a
     evitar. Aprieta sola, por tramos, y en el último se queda con el título:
     la hora la dice el globo. */
  .gantt[data-denso='si'] {
    --alto-fila: 3.1rem;
  }
  .gantt[data-denso='mucho'] {
    --alto-fila: 2.45rem;
  }
  .gantt[data-denso='mucho'] .gantt-barra {
    min-height: 1.5rem;
    margin-block: 0.3rem;
    padding: 0.2rem 0.55rem;
  }
  .gantt[data-denso='mucho'] .gantt-barra-hora {
    display: none;
  }

  /* `min-width: 0` en todo lo que lleva texto: sin esto un título largo con
     `nowrap` reclama su ancho intrínseco, infla su columna y arrastra a las
     demás. Con el mínimo a cero manda el reparto de la rejilla y el título se
     corta con puntos suspensivos, que para eso están. */
  .gantt-barra,
  .gantt-etiqueta {
    min-width: 0;
  }

  /* La cabecera de horas no es una banda: es el eje X de la gráfica, y por eso
     lo que la cierra por debajo es un filete rojo —el mismo de 2 px que abre
     cada rótulo de sección del sitio— y no una regla de tinta. Antes era una
     banda negra que hacía parecer la rejilla una terminal. */
  .gantt-esquina,
  .gantt-hora {
    /* Fila 1 a mano: en cuanto las barras traen su `grid-row` calculado, el
       colocado automático deja de servir y las horas se colaban entre medias
       de las actividades. */
    grid-row: 1;
    position: sticky;
    top: 0;
    z-index: 3;
    background-color: var(--papel);
    align-self: stretch;
  }
  .gantt-hora {
    border-bottom: 2px solid var(--color-rojo);
  }
  /* Eje Y. Va sin el filete de abajo para que los dos se encuentren en ángulo
     y el eje X no asome por la izquierda del vertical. */
  .gantt-esquina {
    left: 0;
    z-index: 4;
    border-right: 2px solid var(--color-rojo);
  }
  .gantt-hora {
    display: flex;
    align-items: center;
    padding: 0.8rem 0 0.8rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--color-tinta) 55%, transparent);
  }

  /* La etiqueta se queda pegada al arrastrar: una barra a las diez de la noche
     sin saber de qué sede es no dice nada.
     Su filete derecho es el eje Y, continuado hacia abajo fila a fila. Y no
     lleva ninguno horizontal: ninguna línea separa las sedes, que es lo que
     distingue una gráfica de una hoja de cálculo. Lo que separa las filas son
     las propias barras.
     Los nombres se apoyan contra el eje por la derecha, como las etiquetas de
     cualquier gráfica, en vez de arrancar todos de un margen izquierdo, que
     es lo que hacen las listas. */
  .gantt-etiqueta {
    position: sticky;
    left: 0;
    z-index: 2;
    grid-column: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    min-height: var(--alto-fila);
    border-right: 2px solid var(--color-rojo);
    background-color: var(--papel);
    padding: 0.5rem 0.9rem 0.5rem 0;
    text-align: right;
    align-self: stretch;
  }

  /* Cuando una sede tiene cosas a la vez, su línea son varios carriles y la
     etiqueta abarca todos. Centrada, el nombre quedaba a media altura de una
     torre de seis barras —tres carriles por debajo de la primera— y ya no se
     leía como el nombre de nada. Se sube al primer carril, que es donde
     arranca lo que nombra. */
  .gantt-etiqueta[data-apilada] {
    justify-content: flex-start;
    padding-top: calc(var(--alto-fila) / 2 - 0.85rem);
  }

  /* Un día sin nada. Ocupa el sitio de la rejilla para que cambiar de día no
     dé un salto de alto, y dice lo que pasa en vez de enseñar una caja en
     blanco con un reloj encima. */
  .gantt-vacio {
    display: grid;
    place-items: center;
    min-height: 10rem;
    padding: 2rem 1rem;
    border: 2px dashed color-mix(in srgb, var(--color-tinta) 30%, transparent);
  }

  .gantt-vacio p {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-align: center;
    opacity: 0.55;
  }

  .gantt-etiqueta-nombre {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.05;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
    /* Anton pone la tilde de las mayúsculas por encima de la caja de línea, y
       con `overflow: hidden` —que hace falta para el «…» de lo que no cabe—
       la Ó de INAUGURACIÓN salía decapitada. Se le da aire a la caja de
       recorte y se le quita por fuera: la tilde entra y nada se mueve. */
    padding-block: 0.18em;
    margin-block: -0.18em;
  }
  .gantt-etiqueta-nota {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    opacity: 0.45;
    text-transform: uppercase;
  }

  .gantt-fila {
    grid-column: 1 / -1;
    z-index: 0;
    pointer-events: none;
  }

  .gantt-guia {
    grid-row: 2 / -1;
    z-index: 0;
    border-left: 1px solid color-mix(in srgb, var(--color-tinta) 16%, transparent);
    pointer-events: none;
  }

  /* ── Barras ────────────────────────────────────────────────────────── */
  /* Todas del mismo color —tinta sobre papel— y el tipo en un filete de color
     a la izquierda.
     Antes cada tipo pintaba la barra entera y la rejilla salía a cuatro
     colores planos a la vez: rojo, amarillo, tinta y ladrillo compitiendo
     en la misma pantalla. Eso no es una rejilla, es un carnaval, y encima el
     que manda es el color y no la hora, que es lo que se viene a leer aquí.
     Con la barra en tinta se lee la forma del día de un golpe y el color pasa
     a lo que debe ser: un dato más, en el canto. */
  .gantt-barra {
    position: relative;
    z-index: 1;
    overflow: hidden;
    min-height: calc(var(--alto-fila) - 1.1rem);
    margin: 0.5rem 2px;
    border: 0;
    border-left: 5px solid var(--fondo);
    background-color: var(--color-tinta);
    padding: 0.42rem 0.6rem;
    text-align: left;
    color: var(--color-papel);
    transition:
      background-color 0.18s var(--ease-salida),
      color 0.18s var(--ease-salida);
  }
  .gantt-barra:hover,
  .gantt-barra[data-activa],
  .gantt-barra[data-mirada] {
    background-color: var(--color-rojo);
    border-left-color: var(--color-amarillo);
    color: var(--color-amarillo);
  }
  .gantt-barra-titulo {
    display: block;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.05;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
    /* Anton pone la tilde de las mayúsculas por encima de la caja de línea, y
       con `overflow: hidden` —que hace falta para el «…» de lo que no cabe—
       la Ó de INAUGURACIÓN salía decapitada. Se le da aire a la caja de
       recorte y se le quita por fuera: la tilde entra y nada se mueve. */
    padding-block: 0.18em;
    margin-block: -0.18em;
  }
  .gantt-barra-hora {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    opacity: 0.6;
    white-space: nowrap;
  }

  /* ── La línea de lo que no cupo ────────────────────────────────────── */
  /* Rayada y en hueco: se lee como «aquí hay más» y no como una actividad.
     Ocupa exactamente el tramo del día en el que caen las sedes que se
     quedaron fuera, así que sigue diciendo algo cierto sobre el reloj. */
  .gantt-resto {
    z-index: 1;
    display: flex;
    align-items: center;
    overflow: hidden;
    min-height: calc(var(--alto-fila) - 1.4rem);
    margin: 0.4rem 2px;
    border: 1px solid color-mix(in srgb, var(--color-tinta) 45%, transparent);
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--color-tinta) 22%, transparent) 0 2px,
      transparent 2px 7px
    );
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-tinta) 70%, transparent);
    transition:
      background-color 0.18s var(--ease-salida),
      color 0.18s var(--ease-salida);
  }
  .gantt-resto > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gantt-resto:hover {
    background-color: var(--color-rojo);
    background-image: none;
    border-color: var(--color-tinta);
    color: var(--color-amarillo);
  }

  /* ── Pie: leyenda y notas ──────────────────────────────────────────── */
  .gantt-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 1.35rem;
  }
  .gantt-leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .gantt-leyenda li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    opacity: 0.6;
    text-transform: uppercase;
  }
  .gantt-muestra {
    display: inline-block;
    width: 1.5rem;
    height: 0.75rem;
    border: 2px solid var(--color-tinta);
  }

  /* ── Globo ─────────────────────────────────────────────────────────── */
  /* Papel, canto de tinta y sombra dura: una tarjeta de la casa, la misma
     receta que la ficha, el mosaico de los logos y los botones. Pasó por
     tinta y por rojo antes de esto y las dos fallaban por lo mismo: la
     rejilla ya es barras negras que se ponen rojas al señalarlas, así que un
     globo negro era una barra más y un globo rojo era la barra señalada otra
     vez. El papel es lo único que no está ya en el gráfico, y por eso es lo
     único que se lee encima de él a la primera.

     `pointer-events: none` es lo que lo hace un globo y no una tarjeta: no se
     puede señalar, así que nunca se interpone entre el cursor y la barra
     siguiente. En un día apretado ésa es la diferencia entre poder comparar
     dos barras vecinas y no poder. */
  .gantt-globo {
    position: fixed;
    z-index: 70;
    width: max-content;
    max-width: min(20rem, calc(100vw - 2rem));
    border: 2px solid var(--color-tinta);
    box-shadow: 5px 5px 0 var(--color-tinta);
    background-color: var(--color-papel);
    padding: 0.7rem 0.85rem 0.75rem;
    color: var(--color-tinta);
    pointer-events: none;
  }
  .gantt-globo[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gantt-globo {
      animation: globo-entra 0.16s var(--ease-salida) both;
    }
  }
  @keyframes globo-entra {
    from {
      opacity: 0;
      translate: 0 0.35rem;
    }
  }
  /* El chip lleva el color del tipo, y uno de los cuatro es el propio papel:
     por eso va con canto de tinta y no a pelo. El texto, en tinta, porque los
     otros dos claros del juego son el amarillo y el papel. */
  .gantt-globo-tipo {
    display: inline-block;
    border: 2px solid var(--color-tinta);
    background-color: var(--color-acento, var(--color-rojo));
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-tinta);
  }
  .gantt-globo-titulo {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .gantt-globo-artista {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-rojo);
  }
  .gantt-globo-artista:empty {
    display: none;
  }
  .gantt-globo-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.6rem;
    margin-top: 0.55rem;
    border-top: 2px solid var(--color-tinta);
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-tinta) 55%, transparent);
  }
  .gantt-globo-sede {
    color: var(--color-tinta);
  }

  /* ── Ficha ─────────────────────────────────────────────────────────── */
  /* `fixed` y colocada por JS junto a la barra. Ancha de verdad —22rem— y con
     sitio para los dos botones: es una ficha, no un globo de ayuda. */
  .gantt-ficha {
    position: fixed;
    z-index: 60;
    width: min(22rem, calc(100vw - 2rem));
    /* Nunca más alta que la ventana menos la barra de arriba: con la
       programación de verdad —títulos largos, direcciones de tres líneas— la
       ficha crecía por debajo del pie de la pantalla y el botón de registro
       quedaba fuera, sin manera de llegar a él. */
    max-height: calc(100svh - 7rem);
    overflow-y: auto;
    border: 2px solid var(--color-tinta);
    box-shadow: 8px 8px 0 var(--color-tinta);
    background-color: var(--color-papel);
    color: var(--color-tinta);
    padding: 1.5rem 1.5rem 1.25rem;
  }
  .gantt-ficha[hidden] {
    display: none;
  }
  .gantt-ficha-cerrar {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--color-tinta);
    background-color: var(--color-papel);
    font-size: 0.7rem;
    line-height: 1;
  }
  .gantt-ficha-cerrar:hover {
    background-color: var(--color-tinta);
    color: var(--color-amarillo);
  }
  .gantt-ficha-tipo {
    display: inline-block;
    border: 2px solid var(--color-tinta);
    background-color: var(--color-acento, var(--color-rojo));
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .gantt-ficha-titulo {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .gantt-ficha-artista {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-rojo);
  }
  .gantt-ficha-artista:empty {
    display: none;
  }
  .gantt-ficha-datos {
    margin-top: 1.25rem;
    border-top: 2px solid var(--color-tinta);
  }
  .gantt-ficha-datos > div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-tinta) 15%, transparent);
    padding: 0.7rem 0;
  }
  .gantt-ficha-datos dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--color-rojo);
    text-transform: uppercase;
  }
  .gantt-ficha-datos dd {
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .gantt-ficha-sede {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
  }
  .gantt-ficha-direccion {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    line-height: 1.35;
    opacity: 0.65;
  }
  .gantt-ficha-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .gantt-ficha-boton {
    flex: 1 1 auto;
    border: 2px solid var(--color-tinta);
    background-color: var(--color-rojo);
    padding: 0.7rem 0.9rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-amarillo);
    text-transform: uppercase;
    transition: box-shadow 0.2s var(--ease-salida);
  }
  .gantt-ficha-boton:hover {
    box-shadow: 3px 3px 0 var(--color-tinta);
  }
  .gantt-ficha-boton--suave {
    background-color: transparent;
    color: var(--color-tinta);
  }
  .gantt-ficha-boton[hidden] {
    display: none;
  }
  .gantt-ficha-sin {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    opacity: 0.45;
    text-transform: uppercase;
  }

  /* ── Mini ──────────────────────────────────────────────────────────── */
  /* Quinta versión. Las cuatro anteriores, en orden: caja gris sin aire
     —un panel de control pegado con cinta—; filetes y Courier de la lista de
     días —el hermano gemelo del bloque de al lado—; bloque de tinta a sangre
     —un agujero negro en mitad del amarillo—; y un gráfico sin caja, con los
     ejes tocando los cantos de la columna, que era la primera con la forma
     correcta y ni un milímetro de margen: un dibujo suelto en la página, sin
     nada que dijera dónde empieza y dónde acaba.

     Ésta es la de antes metida en una tarjeta de la casa: canto de 2 px,
     sombra dura de 6 px —la misma de los botones— y papel blanco, con
     1.5 rem de aire por los cuatro lados. Dentro, el mismo gráfico: dos ejes
     rojos en L —el vertical entre los nombres y el tiempo, el horizontal bajo
     el reloj—, las verticales de las horas a un pelo de tinta y las barras
     macizas. Ninguna línea horizontal separa las sedes: esto no es una tabla.

     El papel blanco es lo que termina de separarla de la lista de días, que
     vive directamente sobre el amarillo de la sección. Un panel y una lista
     no se confunden aunque estén uno al lado del otro. */
  .gantt-marco--mini {
    --alto-fila: 2rem;
    --etiqueta: 7.5rem;
    /* La hora, mucho más estrecha que en la rejilla grande: aquí no hay texto
       dentro de las barras que sostener.
       Va holgada a propósito. Ajustada al ancho real de la columna en una
       ventana de 1024 —la más angosta en que se ve este sitio— la rejilla
       quedaba justo en su ancho mínimo y desbordaba por dos píxeles de
       redondeo: nada que se vea, pero bastante para que Windows pinte una
       barra de desplazamiento horizontal debajo. */
    --ancho-hora: 1.2rem;
  }

  /* En el mini la densidad no espera a los trece carriles: la tarjeta vive en
     media columna de la portada y a partir de la sexta línea ya está alta. */
  .gantt-marco--mini .gantt[data-denso='si'],
  .gantt-marco--mini .gantt[data-denso='mucho'] {
    --alto-fila: 1.7rem;
  }

  /* Sueltas del pegado y sin fondo. En el mini sólo se rotula una hora de cada
     tres, y un rótulo de reloj es más ancho que sus columnas: se sale por
     la derecha, sobre el hueco de la hora muda. Con fondo, la celda de al
     lado —que se pinta después— le comía el último dígito y el reloj marcaba
     «22:0». Nada scrollea por debajo de esta fila, así que el fondo no hacía
     falta para nada más.

     El `min-width: 0` va en el mismo paquete: el rótulo puede pisar el hueco
     de la derecha, que está vacío; lo que no puede es decidir el ancho de la
     rejilla. */
  .gantt-marco--mini .gantt-hora {
    position: static;
    min-width: 0;
    border-bottom: 2px solid var(--color-rojo);
    background-color: transparent;
    padding: 0.15rem 0 0.55rem 0.4rem;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-tinta) 50%, transparent);
  }
  /* La última no tiene hueco a la derecha por el que salirse: se sale de la
     rejilla entera y le abre una barra de desplazamiento de nueve píxeles.
     Pegada al canto queda además casi a plomo con su línea, porque el rótulo
     mide más que la celda. */
  .gantt-marco--mini .gantt-hora[data-ultima] {
    justify-content: flex-end;
    padding-right: 0.1rem;
    padding-left: 0;
  }

  .gantt-marco--mini .gantt-etiqueta {
    padding: 0.25rem 0.65rem 0.25rem 0;
  }
  .gantt-marco--mini .gantt-etiqueta[data-apilada] {
    padding-top: calc(var(--alto-fila) / 2 - 0.55rem);
  }
  /* En Courier y no en la display: a este cuerpo la condensada se apelmaza, y
     además la display aquí competía con los nombres de los días de la lista
     de al lado, que sí son titulares. */
  .gantt-marco--mini .gantt-etiqueta-nombre {
    overflow: visible;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    /* Partido en dos líneas antes que cortado con puntos suspensivos: media
       columna de «TALLER INDUSTRI…» y «ESTUDIO ARRECHI…» no son nombres de
       sede, son un error de maquetación. */
    white-space: normal;
    color: color-mix(in srgb, var(--color-tinta) 70%, transparent);
  }
  .gantt-marco--mini .gantt-etiqueta-nota {
    display: none;
  }

  /* Tinta maciza sobre el papel y sin filete de tipo: aquí no hay leyenda,
     así que el color no significaba nada para quien mira. Lo que importa es
     dónde caen los bultos en el día, y eso se lee mejor con una sola tinta.
     El rojo queda para los ejes y para lo único que cambia de estado: la
     barra que se está señalando. */
  .gantt-marco--mini .gantt-barra {
    min-height: 0.9rem;
    margin: 0 3px 0 0;
    border: 0;
    background-color: var(--color-tinta);
    padding: 0;
  }
  .gantt-marco--mini .gantt-barra:hover,
  .gantt-marco--mini .gantt-barra:focus-visible,
  .gantt-marco--mini .gantt-barra[data-mirada] {
    background-color: var(--color-rojo);
  }
  .gantt-marco--mini .gantt-barra-titulo,
  .gantt-marco--mini .gantt-barra-hora {
    display: none;
  }

  /* En el mini las barras miden nueve píxeles de alto y ésta no puede: lleva
     texto, y a esa altura no se lee ninguno. Se queda con el alto de una fila
     entera —es la última, no descuadra nada— y con el canto entero de tinta,
     que es lo que la separa del rayado de dentro. */
  .gantt-marco--mini .gantt-resto {
    min-height: 1.15rem;
    margin: 0 3px 0 0;
    border-color: var(--color-tinta);
    padding: 0 0.35rem;
    font-size: 0.52rem;
    letter-spacing: 0.05em;
    color: var(--color-tinta);
  }

  /* El pie que dice qué es la barra señalada. Alto reservado y una sola
     línea: si creciera al llenarse, media portada daría un salto cada vez que
     el cursor cruza la rejilla.
     Sigue aquí aunque exista el globo: el globo lo trae el cursor, y esto se
     lee igual con el tabulador y en un teléfono.

     `width: 0` con `min-width: 100%` es lo que impide que crezca A LO ANCHO,
     que era el otro salto y el gordo. `overflow: hidden` recorta lo que se
     pinta, pero no lo que el elemento MIDE: con `white-space: nowrap`, su
     ancho mínimo sigue siendo el del renglón entero, y ese mínimo sube por los
     padres hasta la columna de la portada. Con un título largo la columna del
     mini pasaba de 657 a 886 px —la rejilla entera se estiraba y la lista de
     días de al lado se aplastaba de 487 a 258— cada vez que el cursor cruzaba
     esa barra. Con el ancho declarado en cero, el elemento no aporta ninguna
     medida a nadie, y el `min-width: 100%` lo estira a lo que le den. */
  .gantt-pista {
    overflow: hidden;
    width: 0;
    min-width: 100%;
    min-height: 1.1rem;
    margin-top: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-tinta) 20%, transparent);
    padding-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-tinta) 45%, transparent);
    transition: color 0.18s var(--ease-salida);
  }
  .gantt-pista[data-lleno] {
    color: var(--color-tinta);
  }

  @media (prefers-reduced-motion: reduce) {
    .gantt-barra {
      transition: none;
    }
  }
</style>

<script>
  /** ── Tally, a la carta ───────────────────────────────────────────────────
   *
   * Abre un formulario de Tally encima de la página. El widget se descarga la
   * primera vez que alguien pulsa «Registrarme» y no antes: mientras nadie
   * pulse, este sitio sigue sin hacer una sola petición a un tercero, que es
   * como está construido todo lo demás.
   *
   * Si el script no llega —red caída, bloqueador, lo que sea— se cae al
   * comportamiento de siempre: abrir el formulario en una pestaña nueva. El
   * botón nunca se queda sin hacer nada.
   */
  /** Lo único que le pedimos al widget. Se declara aquí y no en un `.d.ts`
   *  global porque es el único sitio del sitio que lo toca. */
  declare global {
    interface Window {
      Tally?: {
        openPopup: (
          id: string,
          opciones?: { layout?: 'modal' | 'default'; width?: number },
        ) => void;
      };
    }
  }

  const TALLY = 'https://tally.so/widgets/embed.js';
  let cargandoTally: Promise<void> | null = null;

  /** El id del formulario es el último tramo de `tally.so/r/XXXX`. */
  const idDeTally = (url: string) => {
    try {
      const u = new URL(url);
      if (!/(^|\.)tally\.so$/.test(u.hostname)) return null;
      return u.pathname.split('/').filter(Boolean).pop() ?? null;
    } catch {
      return null;
    }
  };

  const cargarTally = () => {
    if (window.Tally) return Promise.resolve();
    if (cargandoTally) return cargandoTally;
    cargandoTally = new Promise<void>((listo, falla) => {
      const s = document.createElement('script');
      s.src = TALLY;
      s.async = true;
      s.onload = () => listo();
      s.onerror = () => falla(new Error('Tally no cargó'));
      document.head.append(s);
    });
    return cargandoTally;
  };

  const abrirTally = (url: string) => {
    const id = idDeTally(url);
    // Cualquier otro formulario —Google Forms, que es el que usa el festival—
    // se abre como cualquier enlace: en otra pestaña. Los `forms.gle` son
    // enlaces cortos que sólo se resuelven siguiendo la redirección, así que no
    // hay forma de incrustarlos sin pedirle la página a Google antes de que
    // nadie haya pulsado nada, y eso es justo lo que este sitio no hace.
    if (!id) return void window.open(url, '_blank', 'noopener');
    cargarTally()
      .then(() => {
        if (window.Tally?.openPopup) {
          window.Tally.openPopup(id, { layout: 'modal', width: 640 });
        } else {
          window.open(url, '_blank', 'noopener');
        }
      })
      .catch(() => window.open(url, '_blank', 'noopener'));
  };

  /** ── Colocar una caja al lado de una barra ──────────────────────────────
   *
   * La usan el globo y la ficha, que tienen el mismo problema: caben debajo de
   * su barra casi siempre, y cuando no, hay que decidir a dónde van sin tapar
   * justamente aquello de lo que hablan.
   *
   * El techo no es el borde de la ventana: es el borde de abajo de la barra de
   * navegación, que va pegada arriba. Sin descontarla, una barra de las
   * primeras filas abría su ficha por debajo del menú y el título salía
   * cortado —o directamente fuera de cuadro, que es lo que pasaba: la ficha
   * llegaba a colocarse en −6 px—.
   */
  const MARGEN = 12;

  function techo() {
    const barra = document.querySelector<HTMLElement>('body > header');
    const alto = barra?.getBoundingClientRect().bottom ?? 0;
    return Math.max(MARGEN, alto + 8);
  }

  function aLaVista(el: HTMLElement) {
    const r = el.getBoundingClientRect();
    return r.bottom > techo() && r.top < window.innerHeight - MARGEN;
  }

  function colocar(caja: HTMLElement, ancla: HTMLElement) {
    const b = ancla.getBoundingClientRect();
    const c = caja.getBoundingClientRect();
    const alto = techo();
    const suelo = window.innerHeight - MARGEN;

    let izq = Math.max(MARGEN, Math.min(b.left, window.innerWidth - c.width - MARGEN));
    let arriba = b.bottom + 10;

    if (arriba + c.height > suelo) {
      const encima = b.top - c.height - 10;
      if (encima >= alto) {
        arriba = encima;
      } else {
        /* Ni debajo ni encima: al costado, que es lo único que deja la barra a
           la vista. A la derecha si hay sitio, y si no a la izquierda. */
        arriba = Math.min(Math.max(alto, b.top + b.height / 2 - c.height / 2), suelo - c.height);
        arriba = Math.max(alto, arriba);
        const derecha = b.right + 10;
        izq =
          derecha + c.width + MARGEN <= window.innerWidth
            ? derecha
            : Math.max(MARGEN, b.left - c.width - 10);
      }
    }

    /* Y el remate: la caja nunca sale del hueco entre la barra de navegación y
       el pie de la pantalla, se haya elegido el sitio que se haya elegido.
       Sin esta línea, una barra que ya está medio subida por el scroll —su
       borde de abajo por encima del menú— colocaba su ficha «debajo de la
       barra», que es un número negativo: la ficha se iba fuera de cuadro por
       arriba y sólo asomaba su mitad de abajo. */
    arriba = Math.max(alto, Math.min(arriba, suelo - c.height));

    caja.style.left = `${Math.round(izq)}px`;
    caja.style.top = `${Math.round(arriba)}px`;
  }

  /** Pestañas de día, globo al pasar y ficha al pulsar.
   *
   * Las barras ya vienen colocadas del build; aquí sólo se enseña un panel,
   * se rellena lo que toque y se lo coloca al lado de la barra.
   */
  for (const marco of document.querySelectorAll<HTMLElement>('[data-gantt]')) {
    const esMini = marco.classList.contains('gantt-marco--mini');
    const nombre = marco.dataset.gantt ?? '';

    /* Las pestañas propias del componente o, si se le pasó un selector, una
       lista que vive fuera. La portada usa lo segundo: los cuatro días de la
       columna de la derecha son el mando de esta rejilla. */
    const selector =
      marco.querySelector('[data-selector-dia]') ??
      (marco.dataset.selector
        ? document.querySelector(marco.dataset.selector)
        : null);
    const paneles = marco.querySelectorAll<HTMLElement>('[data-panel]');

    /* El globo y la ficha se mudan al `<body>` en cuanto arranca el script.
       No es un capricho de orden: las dos son `position: fixed`, y basta con
       que un ancestro tenga puesta la propiedad `translate` —aunque valga
       `0 0`, que es lo que dejan las animaciones de entrada del sitio cuando
       terminan— para que dejen de anclarse a la ventana y pasen a anclarse a
       ese ancestro. Con la ficha dentro de la tarjeta de `/programa` eso hacía
       dos estropicios a la vez: la colocaba fuera de cuadro —su `top: 156px`
       se medía desde el borde de la tarjeta, no desde el de la ventana— y
       encerraba su `z-index: 60` en el contexto de apilado de la tarjeta, así
       que los botones del final de la página se le pintaban encima. */
    const globo = document.querySelector<HTMLElement>(`[data-globo="${nombre}"]`);
    const ficha = document.querySelector<HTMLElement>(`[data-ficha="${nombre}"]`);
    if (globo) document.body.append(globo);
    if (ficha) document.body.append(ficha);

    // El nombre, la fecha y las cuentas viajan en el propio panel: el script
    // de un componente Astro es un módulo aparte y no ve el frontmatter.
    const rotuloDia = marco.querySelector('[data-rotulo-dia]');
    const rotuloNota = marco.querySelector('[data-rotulo-nota]');

    function pintarRotulo(panel: HTMLElement) {
      if (rotuloDia) {
        rotuloDia.textContent =
          `${panel.dataset.nombre ?? ''} ${panel.dataset.diaFecha ?? ''}`.trim();
      }
      if (rotuloNota) {
        const actos = Number(panel.dataset.total ?? 0);
        const sedes = Number(panel.dataset.sedes ?? 0);
        // «0 actividades · 0 sedes» encima de un cartel que ya dice que ese día
        // no hay nada es contarlo dos veces, y la segunda con números.
        rotuloNota.textContent = actos === 0
          ? 'Por anunciar'
          : `${actos} ${actos === 1 ? 'actividad' : 'actividades'} · ` +
            `${sedes} ${sedes === 1 ? 'sede' : 'sedes'}`;
      }
    }

    function marcarSelector(clave: string | undefined) {
      if (!selector) return;
      const botones = [...selector.querySelectorAll<HTMLElement>('[data-dia]')];
      for (const otro of botones) {
        otro.setAttribute('aria-pressed', String(otro.dataset.dia === clave));
      }
      // Y dónde se para la burbuja, cuando el mando es un conmutador. En la
      // lista de días de la portada la variable no la lee nadie y no molesta.
      const puesto = botones.findIndex((b) => b.dataset.dia === clave);
      if (puesto >= 0) {
        (selector as HTMLElement).style?.setProperty('--activa', String(puesto));
      }
    }

    /* El mini enseña un día y punto: el de hoy, si el festival está en marcha,
       y si no el primero. Se decide aquí y no en el build porque el sitio es
       estático: la página se genera una vez y se sirve durante meses, así que
       «hoy» sólo lo sabe el navegador de quien entra. */
    if (esMini && paneles.length > 1) {
      const ahora = new Date();
      const hoy = `${ahora.getFullYear()}-${String(ahora.getMonth() + 1).padStart(2, '0')}-${String(ahora.getDate()).padStart(2, '0')}`;
      const enCurso = [...paneles].find((p) => p.dataset.fecha === hoy);
      const elegido = enCurso ?? paneles[0];

      for (const panel of paneles) panel.hidden = panel !== elegido;
      pintarRotulo(elegido);
      marcarSelector(elegido.dataset.panel);

      // Que la lista diga por qué arranca en ese día y no en el primero.
      if (enCurso) {
        selector
          ?.querySelector(`[data-dia="${enCurso.dataset.panel}"]`)
          ?.setAttribute('data-hoy', '');
      }
    }

    selector?.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest<HTMLElement>('[data-dia]');
      if (!boton || !selector.contains(boton)) return;
      marcarSelector(boton.dataset.dia);
      for (const panel of paneles) {
        panel.hidden = panel.dataset.panel !== boton.dataset.dia;
        if (!panel.hidden) pintarRotulo(panel);
      }
      ponPista(null);
      esconder();
      cerrar();
    });

    /* El pie del mini. Las barras van sin texto, así que lo que dicen se lee
       abajo al señalarlas —con el ratón o con el tabulador—. `data-cuando`
       trae «Jueves 24 de septiembre · 10:00–13:00»; aquí sólo hace falta el
       tramo de horas, porque el día ya está en el rótulo de arriba. */
    const pista = marco.querySelector<HTMLElement>('[data-pista]');
    const pistaEnReposo = pista?.textContent ?? '';

    function ponPista(barra: HTMLElement | null) {
      if (!pista) return;
      if (!barra) {
        pista.textContent = pistaEnReposo;
        delete pista.dataset.lleno;
        return;
      }
      pista.textContent = [barra.dataset.horas, barra.dataset.titulo, barra.dataset.sede]
        .filter(Boolean)
        .join(' · ');
      pista.dataset.lleno = '';
    }

    /* ── El globo ─────────────────────────────────────────────────────────
       Aparece al pasar por encima y se va al salir. No se puede señalar
       —`pointer-events: none`—, así que jamás se interpone entre el cursor y
       la barra de al lado: en un día apretado eso es lo que deja comparar dos
       actividades vecinas sin pelearse con la tarjeta. */
    let mirada: HTMLElement | null = null;
    let abierta: HTMLElement | null = null;

    const pon = (raiz: HTMLElement, sel: string, texto: string) => {
      const el = raiz.querySelector<HTMLElement>(sel);
      if (el) el.textContent = texto;
    };

    function mostrar(barra: HTMLElement) {
      if (!globo) return;
      // Con una ficha fijada manda la ficha: dos tarjetas hablando de dos
      // actividades distintas a la vez no se leen.
      if (abierta) return;
      mirada?.removeAttribute('data-mirada');
      mirada = barra;
      barra.setAttribute('data-mirada', '');

      pon(globo, '[data-g-tipo]', barra.dataset.tipo ?? '');
      pon(globo, '[data-g-titulo]', barra.dataset.titulo ?? '');
      pon(globo, '[data-g-artista]', barra.dataset.artista ?? '');
      pon(globo, '[data-g-hora]', barra.dataset.horas ?? '');
      pon(globo, '[data-g-sede]', barra.dataset.sede ?? '');
      globo.style.setProperty('--color-acento', barra.dataset.color ?? '');

      // Visible antes de medir: con `hidden` puesto la caja mide cero y la
      // colocación saldría siempre pegada arriba a la izquierda.
      globo.hidden = false;
      colocar(globo, barra);
    }

    function esconder() {
      mirada?.removeAttribute('data-mirada');
      mirada = null;
      if (globo) globo.hidden = true;
    }

    marco.addEventListener('pointerover', (e) => {
      const barra = (e.target as HTMLElement).closest<HTMLElement>('[data-barra]');
      if (!barra || barra === mirada) return;
      ponPista(barra);
      mostrar(barra);
    });
    marco.addEventListener('pointerleave', () => {
      ponPista(null);
      esconder();
    });
    /* Con el tabulador el globo tiene que salir igual: es la única manera de
       saber en qué barra está el foco cuando las barras van sin texto. */
    marco.addEventListener('focusin', (e) => {
      const barra = (e.target as HTMLElement).closest<HTMLElement>('[data-barra]');
      if (!barra) return;
      ponPista(barra);
      mostrar(barra);
    });
    marco.addEventListener('focusout', (e) => {
      if (marco.contains(e.relatedTarget as Node)) return;
      ponPista(null);
      esconder();
    });

    /* ── La ficha ─────────────────────────────────────────────────────── */
    function cerrar() {
      if (!ficha) return;
      ficha.hidden = true;
      abierta?.removeAttribute('data-activa');
      abierta = null;
    }

    function abrir(barra: HTMLElement) {
      if (!ficha) return;
      const d = barra.dataset;

      pon(ficha, '[data-f-tipo]', d.tipo ?? '');
      pon(ficha, '[data-f-titulo]', d.titulo ?? '');
      pon(ficha, '[data-f-artista]', d.artista ?? '');
      pon(ficha, '[data-f-cuando]', d.cuando ?? '');
      pon(ficha, '[data-f-sede]', d.sede ?? '');
      pon(ficha, '[data-f-direccion]', d.direccion ?? '');

      // La etiqueta de tipo se pinta del color de la barra: es lo que ata la
      // ficha a la barra que la abrió cuando hay varias abiertas seguidas.
      ficha.style.setProperty('--color-acento', d.color ?? '');

      const registro = ficha.querySelector<HTMLAnchorElement>('[data-f-registro]');
      const sin = ficha.querySelector<HTMLElement>('[data-f-sin]');
      if (registro && sin) {
        if (d.registro) {
          registro.href = d.registro;
          registro.textContent = idDeTally(d.registro) ? 'Registrarme' : 'Registrarme ↗';
          registro.hidden = false;
          sin.hidden = true;
        } else {
          registro.removeAttribute('href');
          registro.hidden = true;
          sin.textContent = d.libre
            ? 'Entrada libre · sin registro'
            : 'El registro de esta actividad todavía no está abierto';
          sin.hidden = false;
        }
      }

      /** El formulario abre ENCIMA de la página en vez de sacarte a otra
       *  pestaña, y el código de Tally se descarga **en el primer clic**.
       *
       *  Lo segundo no es una optimización, es la regla del sitio: aquí no se
       *  pide nada a terceros —las tipografías son propias, el plano es propio,
       *  no hay Google—. Cargar el widget de Tally al entrar rompería eso para
       *  todo el que sólo viene a mirar el programa. Cargándolo al pulsar, lo
       *  paga sólo quien ya iba a Tally de todos modos.
       *
       *  El `href` real se queda puesto: sin JS, con el script bloqueado o si
       *  la red falla, el botón sigue siendo un enlace que abre el formulario
       *  en pestaña nueva. Nunca se queda muerto. */
      if (registro && !registro.dataset.popup) {
        registro.dataset.popup = 'si';
        registro.addEventListener('click', (e) => {
          const url = registro.href;
          if (!url) return;
          // Respetar los gestos de «abrir en pestaña nueva» del usuario.
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          e.preventDefault();
          abrirTally(url);
        });
      }

      const mapa = ficha.querySelector<HTMLAnchorElement>('[data-f-mapa]');
      if (mapa) {
        if (d.mapa) {
          mapa.href = d.mapa;
          mapa.hidden = false;
        } else {
          mapa.hidden = true;
        }
      }

      abierta?.removeAttribute('data-activa');
      barra.setAttribute('data-activa', '');
      abierta = barra;

      ficha.hidden = false;
      ficha.scrollTop = 0;
      colocar(ficha, barra);
    }

    marco.addEventListener('click', (e) => {
      const barra = (e.target as HTMLElement).closest<HTMLElement>('[data-barra]');
      if (!barra) return;
      // El resumen de la portada no tiene ficha: ahí el globo es todo lo que
      // hay, y el clic no promete nada que no vaya a pasar.
      if (!ficha) return;
      esconder();
      if (barra === abierta) return cerrar();
      abrir(barra);
    });

    ficha?.querySelector('[data-ficha-cerrar]')?.addEventListener('click', cerrar);

    /* Un clic en cualquier otro sitio cierra las dos cajas. Cubre lo obvio
       —pulsar fuera— y también el cambio de vista de `/programa`: el mando de
       «por horas / por días» no es ni ficha ni barra, así que al saltar a la
       tabla la ficha que estuviera abierta no se queda flotando sobre ella
       apuntando a una barra que ya no está en pantalla. */
    document.addEventListener('click', (e) => {
      const dentro = (e.target as HTMLElement).closest('[data-ficha],[data-barra]');
      if (dentro) return;
      esconder();
      cerrar();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      esconder();
      cerrar();
    });

    /* Las dos cajas viven en coordenadas de ventana: cuando la página se mueve
       por debajo hay que volver a apuntarlas a su barra. Antes esto cerraba la
       ficha en el primer píxel de scroll, que con el desplazamiento suave del
       sitio significaba que abrirla y perderla eran el mismo gesto. Ahora sólo
       se cierra cuando su barra se va de la pantalla, que es cuando deja de
       tener sentido. */
    const seguir = () => {
      if (abierta && ficha) {
        if (aLaVista(abierta)) colocar(ficha, abierta);
        else cerrar();
      }
      if (mirada && globo && !globo.hidden) {
        if (aLaVista(mirada)) colocar(globo, mirada);
        else esconder();
      }
    };
    window.addEventListener('scroll', seguir, { passive: true });
    window.addEventListener('resize', seguir, { passive: true });
    // Y cuando lo que se arrastra es la propia rejilla.
    marco
      .querySelector('[data-scroll]')
      ?.addEventListener('scroll', seguir, { passive: true });
  }
</script>
