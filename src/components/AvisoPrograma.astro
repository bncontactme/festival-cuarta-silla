---
/**
 * El «Próximamente» de la rejilla.
 *
 * La forma la pone `Cartel.astro`; aquí sólo se dice de qué va este cartel. Se
 * partió en dos al hacer falta el mismo en `/registro`: son la misma
 * declaración en dos puertas de lo mismo, y decirla con dos formas distintas
 * habría hecho creer que son dos cosas distintas.
 */
import Cartel from './Cartel.astro';
import { festival, programa } from '../data/site';

interface Props {
  movil?: boolean;
  compacto?: boolean;
}

const { movil = false, compacto = false } = Astro.props;
const estado = programa.estado.replace(/[()]/g, '');
---

<Cartel
  rotulo={`Programa / ${festival.anio}`}
  cuando={movil ? '24—27 / 09' : festival.fechas.replace('Del ', '')}
  titulo={estado}
  pieIzquierda={festival.nombre}
  pieDerecha={festival.ciudad}
  movil={movil}
  compacto={compacto}
/>
