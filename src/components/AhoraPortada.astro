---
/**
 * La banda del AHORA, en la portada y para el festival entero.
 *
 * Es la banda negra del cartel de sede —`CartelDeSede`, punto 2— traída a la
 * portada y con una diferencia que lo cambia todo: allí contesta «¿qué hay en
 * ESTA sede?» y aquí contesta «¿qué hay abierto, en cualquiera de las
 * dieciséis?». Por eso cada renglón trae el nombre de su sede y es un enlace:
 * durante los cuatro días la pregunta de la portada no es qué se programó,
 * es a dónde me muevo ahora.
 *
 * Sustituye al adelanto que había aquí —la rejilla mini y la lista de los
 * cuatro días— como PRIMERA cosa de la sección. Aquello enseñaba la forma de
 * la jornada, que es una buena pregunta el día 10 de septiembre y la peor
 * posible a la una y media de la tarde del día 26. La rejilla no se va: baja
 * un escalón, debajo del carril de días, que es donde se pregunta «¿y el
 * sábado qué hay?».
 *
 * ── Nace escondida ───────────────────────────────────────────────────────
 *
 * Igual que la del cartel: sale del build vacía y con `hidden`, y sólo la
 * rellena el script si el reloj cae dentro del festival. Sin JavaScript, con
 * el festival terminado o si algo falla, la sección se lee como se leía —el
 * carril y la rejilla— y aquí no ha pasado nada. Es la razón de que este
 * componente no traiga ni un dato pintado en HTML.
 */
import { conBase } from '../lib/base';
import {
  agendaPorDia,
  enTodasLasSedes,
  instanteDe,
  rutaDeSede,
  sedeDe,
} from '../data/site';

interface Props {
  /** `escritorio`: dos columnas, la hora al canto izquierdo. `movil`: un
   *  tablero de dos renglones dentro del cartel del teléfono, con la hora a
   *  su izquierda. */
  variante?: 'escritorio' | 'movil';
}

const { variante = 'escritorio' } = Astro.props;

/** Cuántas actividades se enseñan.
 *
 * Cinco: lo que cabe en escritorio sin que la banda pase de alto de pantalla.
 * En el teléfono el tablero enseña una a la vez y lo demás pasa por turnos,
 * así que allí el cinco es otra cosa: el tope de la cola de «después» cuando
 * no hay nada abierto. Sin tope, a las tres de la mañana esa cola eran las
 * veinticinco actividades que quedaban, y una vuelta entera tardaba dos
 * minutos y medio. */
const caben = 5;

/**
 * Lo que el script necesita para saber qué está pasando: cada actividad del
 * festival con su instante real, su sede y su puerta.
 *
 * Va en un `<script type="application/json">` y no en mil atributos por la
 * misma razón que en el cartel: es una sola lectura y se ve de un vistazo en
 * el inspector.
 *
 * La ruta sólo se escribe si la sede existe en la lista. `rutaDeSede` deduce
 * la dirección del nombre, así que un nombre escrito a mano en el panel que no
 * esté en `sedes.lista` daría un enlace a un 404 — y un 404 a media tarde, con
 * alguien en la calle buscando dónde entrar, es peor que no poner enlace.
 */
const paraElReloj = agendaPorDia.flatMap((dia) =>
  dia.actividades.map((a) => {
    const suya = sedeDe(a.sede);
    return {
      inicio: instanteDe(dia.indice, a.inicio),
      fin: instanteDe(dia.indice, a.fin),
      titulo: a.titulo,
      artista: a.artista ?? '',
      /* El recorrido dice su nombre y ya: «Todas las sedes» es dónde es, igual
         que «No Museo», y con eso queda dicho. Aquí estuvo una chapa amarilla
         de «Pasa por aquí» y se cae — era la única de los renglones que se
         pintaba distinta, y un renglón de cada seis con campo propio se lee
         como que ése importa más, que es justo lo que no se quería decir. */
      sede: enTodasLasSedes(a.sede) ? 'Todas las sedes' : a.sede,
      ruta: suya ? conBase(rutaDeSede(suya.nombre)) : '',
      dia: dia.indice,
    };
  }),
);
---

<section
  class:list={['ahora', variante === 'movil' && 'ahora--movil']}
  data-ahora
  data-caben={caben}
  data-variante={variante}
  hidden
  aria-label="Qué está pasando ahora"
>
  {/* Los datos van DENTRO de la sección, y no sueltos al final del
      componente: la portada monta esta banda dos veces —una de escritorio y
      otra de teléfono— y cada una tiene que encontrar los suyos sin contar
      posiciones ni inventarse identificadores. */}
  <script type="application/json" data-reloj-portada set:html={JSON.stringify(paraElReloj)} is:inline />

  <div class="ahora-reja">
    {/* ── La hora ──────────────────────────────────────────────────────────
        Es lo único de la portada que caduca: quien llega y ve «13:40» ya sabe,
        antes de leer una sola palabra, que lo de al lado es de verdad y está
        pasando ahora mismo. Y es SIEMPRE la hora —nunca el día—: un reloj que
        unas veces marca las 13:40 y otras pone «JUE 24» deja de ser un reloj,
        y lo que se mira ahí se mira sin leer.

        `display-centro` y no sólo el `text-align` de la columna: la clase
        `.display` aprieta la Anton un 8 % con un `scaleX` anclado a la
        izquierda, así que centrar el texto sin mover el ancla deja el bloque
        descuadrado hacia la derecha. */}
    <div class="ahora-reloj">
      <p class="meta text-amarillo" data-ahora-dia></p>
      <p class="display display-centro ahora-hora" data-ahora-reloj></p>
      <p class="meta ahora-cierre" data-ahora-cierre></p>
      {/* El día, debajo de la hora, y sólo en el teléfono. Allí la columna del
          reloj mide lo que mide la hora, y «Ahora · sábado 26» en un renglón
          le quitaba al tablero de al lado el ancho que necesitan los títulos:
          se parte en dos —«Ahora» encima, «sáb 26» debajo— y la hora queda
          en medio. */}
      {variante === 'movil' && <p class="meta ahora-fecha" data-ahora-fecha></p>}
    </div>

    <div class="ahora-cuerpo">
      <p class="meta ahora-rotulo" data-ahora-rotulo></p>

      {/* Los renglones los escribe el script. Son renglones y no fichas por lo
          mismo que en el panel de `/sedes`: con las dieciséis sedes abiertas a
          la vez, seis tarjetas apiladas son una pared. */}
      <ul class="ahora-lista" data-ahora-lista></ul>

      {/* La chapa roja: lo único de la banda que todavía no ha pasado, y por
          eso se separa de lo que ya está corriendo con su propio campo. */}
      <p class="ahora-luego" data-ahora-luego hidden>
        <span class="meta ahora-cuando" data-ahora-cuando></span>
        <span class="display ahora-proxima" data-ahora-proxima></span>
        <span class="meta ahora-quien" data-ahora-artista hidden></span>
      </p>
    </div>
  </div>
</section>

<style>
  /* La banda entera: negra dentro del campo rojo de la sección, con su canto
     de 2 px como cualquier otro objeto del sitio.

     Y apretada a propósito. El aire de aquí dentro estaba puesto con la mano
     del resto del sitio —secciones que respiran, con una cosa cada una—, y
     esto no es una sección: es un tablero de salidas. Lo que se le pide es
     que quepa de una pasada, y cada renglón de aire que se le quita es media
     actividad más a la vista sin tocar un solo cuerpo de letra. El negro es lo que la separa
     del rojo sin inventar un color nuevo — es el mismo trato que recibe en el
     cartel de sede, donde el campo de al lado también es rojo. */
  .ahora {
    background-color: var(--color-tinta);
    border: var(--borde) solid var(--color-tinta);
    color: var(--color-papel);
  }

  /* Dos columnas: la hora manda a la izquierda con un ancho fijo —18rem, que
     es lo que mide «13:40» a este cuerpo con aire a los dos lados— y lo que
     pasa ocupa el resto. Es la banda del cartel de sede, y es de izquierda a
     derecha por lo mismo que allá: primero cuándo, después qué. Una banda
     compacta que se entiende de una pasada.

     En cuanto la ventana se estrecha, una encima de la otra: la hora en una
     columna de ocho centímetros deja de ser un titular y pasa a ser un estorbo
     al lado de los títulos. */
  .ahora-reja {
    display: grid;
    gap: 1.25rem 2rem;
    padding: 1.25rem 1.25rem;
  }
  @media (min-width: 1024px) {
    .ahora-reja {
      grid-template-columns: 18rem minmax(0, 1fr);
      padding: 1.4rem 1.75rem;
    }
  }

  /* ── La columna del reloj ────────────────────────────────────────────
     Centrada, y centrada de las dos maneras.

     El reloj se apoyaba en el canto de arriba de su columna, y la columna mide
     lo que mida la lista de al lado: con cuatro actividades corriendo eso son
     tres dedos de hueco negro debajo de la hora, y la mitad izquierda de la
     banda se lee como una caja a medio llenar. Centrado en vertical, el hueco
     se reparte arriba y abajo y deja de ser un socavón.

     Y el filete que la cierra por la derecha es lo que la convierte en una
     columna: sin él, la hora y los renglones flotan en el mismo campo negro y
     no hay nada que diga dónde acaba una cosa y empieza la otra. Es de un pelo
     y del mismo papel al 22 % que separa los renglones — la misma familia de
     filetes, no una raya nueva. */
  .ahora-reloj {
    text-align: center;
  }
  @media (min-width: 1024px) {
    .ahora-reloj {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-right: 2rem;
      border-right: 1px solid color-mix(in srgb, var(--color-papel) 22%, transparent);
    }
  }

  /* Y un punto más grande, que para eso tiene la columna entera: es el objeto
     al que se le mira primero. */
  .ahora-hora {
    margin-top: 0.3rem;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    line-height: 0.85;
    color: var(--color-amarillo);
  }

  .ahora-cuerpo {
    min-width: 0;
  }

  /* Sobre negro, el papel al 60 % da 9:1 de sobra: es el gris de este sitio
     para lo que acompaña sin mandar. */
  .ahora-cierre {
    margin-top: 0.5rem;
    color: var(--color-apagado-papel);
  }
  .ahora-rotulo {
    color: var(--color-apagado-papel);
  }

  /* ── Los renglones ───────────────────────────────────────────────────
     Un filete de un pelo entre uno y otro, como la lista de las dieciséis
     sedes y como el panel: lo que separa las actividades es una línea, no un
     marco. El último no lleva filete — un canto suelto al aire se lee como que
     la lista sigue y se cortó. */
  .ahora-lista {
    margin-top: 0.5rem;
  }

  /* ── Y por qué estos van en `:global` ─────────────────────────────────
     Los renglones los escribe el script en el navegador, así que no llevan
     —no pueden llevar— la marca de ámbito que Astro le pone a lo que sale del
     build. Un `.ahora-fila` escrito a secas aquí dentro compila a
     `.ahora-fila:where(.astro-xxxx)` y no pinta nada.

     La alternativa era escribir los renglones con utilidades de Tailwind desde
     el script —que es lo que hace el cartel de sede— y se descarta: aquí cada
     renglón tiene cuatro estados (enlace, recorrido, hover, foco) y eso en
     utilidades es una ristra ilegible dentro de un `createElement`. El nombre
     no se escapa a ningún sitio: los seis empiezan por `ahora-` y sólo los
     escribe este componente. */
  .ahora-lista :global(.ahora-fila) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.25rem;
    padding: 0.38rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-papel) 22%, transparent);
  }
  .ahora-lista :global(li:last-child .ahora-fila) {
    border-bottom: 0;
  }

  /* La fila entera es la puerta a su sede, así que se enciende entera al
     pasar por encima: el objetivo es el renglón, no dos palabras. */
  .ahora-lista :global(a.ahora-fila) {
    width: 100%;
    text-align: left;
  }
  .ahora-lista :global(a.ahora-fila:hover .ahora-que),
  .ahora-lista :global(a.ahora-fila:focus-visible .ahora-que) {
    color: var(--color-amarillo);
  }
  .ahora-lista :global(a.ahora-fila:hover .ahora-donde),
  .ahora-lista :global(a.ahora-fila:focus-visible .ahora-donde) {
    color: var(--color-papel);
  }

  /* «hasta 18:00» a ancho fijo: con las horas alineadas en columna, seis
     renglones se leen de un barrido vertical y no uno por uno. */
  .ahora-lista :global(.ahora-hasta) {
    flex: 0 0 auto;
    min-width: 5.5rem;
    color: var(--color-amarillo);
  }
  /* Un punto por debajo de lo que era: con el reloj mandando a tamaño de
     cartel, la lista no tiene que competir con él. Es lo que se lee después,
     no a la vez. */
  .ahora-lista :global(.ahora-que) {
    flex: 1 1 14rem;
    min-width: 0;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-papel);
    transition: color 0.2s var(--ease-salida);
  }
  .ahora-lista :global(.ahora-donde) {
    flex: 0 0 auto;
    color: var(--color-apagado-papel);
    transition: color 0.2s var(--ease-salida);
  }

  /* ── La fecha, entre un día y el siguiente ───────────────────────────
     Cuando la lista es lo que viene, seis renglones pueden cruzar de un día a
     otro. Sin esto, «11:00» y «19:00» seguidos se leen como la misma tarde, y
     no lo son. Con la fecha delante, cada renglón puede decir sólo su hora y
     dejar de repetir el día seis veces.

     Es un renglón de la lista y no un titular: un pelo de aire por encima, la
     fecha en amarillo y nada más. El primero no lleva el aire de arriba, que
     lo pondría a flotar debajo del filete del cuerpo. */
  .ahora-lista :global(.ahora-dia) {
    padding-top: 0.75rem;
    color: var(--color-amarillo);
  }
  .ahora-lista :global(li:first-child.ahora-dia) {
    padding-top: 0;
  }

  /* ── La chapa roja ───────────────────────────────────────────────────
     Es la misma de la banda del cartel de sede: campo rojo, canto amarillo.
     Lo que cambia es que aquí lleva tres cosas —cuándo, qué y quién— porque
     en la portada nadie sabe todavía de qué actividad se habla. */
  .ahora-luego {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.9rem;
    background-color: var(--color-rojo);
    border: var(--borde) solid var(--color-amarillo);
    padding: 0.6rem 1rem;
  }

  /* El «en 20 min» trae su propio campo, y no va suelto sobre el rojo. Es la
     regla de la casa y la cuenta la explica el cartel de sede: tinta sobre
     rojo son 4,2:1 y esta letra mide 11,5 px, que pide 4,5. Sobre negro son
     15:1 y no hay nada que discutir. */
  .ahora-cuando {
    background-color: var(--color-tinta);
    color: var(--color-amarillo);
    padding: 0.3rem 0.6rem;
    font-weight: 700;
  }
  .ahora-proxima {
    flex: 1 1 12rem;
    min-width: 0;
    font-size: 1.25rem;
    line-height: 1.05;
    color: var(--color-amarillo);
  }
  /* El artista, al otro canto: es de quien es, no qué es, y por eso no compite
     con el título. En negrita porque es lo único que se escribe chico sobre el
     rojo. */
  .ahora-quien {
    margin-left: auto;
    color: var(--color-tinta);
    font-weight: 700;
  }

  /* ══ La variante del teléfono ══════════════════════════════════════════

     ── Un tablero de salidas ─────────────────────────────────────────────

     La hora a la izquierda y, a su derecha, dos renglones del mismo alto:
     arriba lo que está pasando, abajo lo que entra. Se lee como el tablero
     de una estación —de arriba abajo, en el orden del reloj— y mide 93 px,
     lo mismo que la cinta de patrocinadores que tiene debajo. Ésa es la
     unidad de esta portada: una franja, no un bloque.

     Venía de medir entre 133 y 167 px en dos columnas —el ahora a la
     izquierda, la chapa roja a la derecha—, con la chapa estirada al alto
     de su vecina y media vacía, y con cuatro rótulos para una sola
     actividad: «Ahora», «Abierto hasta las 18:00», «En este momento» y
     «Hasta 14:00». Queda uno por renglón.

     ── Y mide siempre lo mismo ───────────────────────────────────────────

     Cada cosa es de un renglón y se corta con puntos, y los dos renglones
     del tablero tienen el alto clavado. Es la mitad del arreglo y no un
     detalle: el cartel de arriba se mide contra el hueco que le deja esta
     banda —`cqh` en `.portada-escena`—, y una banda que crecía cuando el
     turno le traía un título de dos líneas hacía respirar el cartel entero,
     catorce píxeles cada seis segundos. */
  .ahora--movil {
    background-color: transparent;
    border: 0;
  }

  .ahora--movil .ahora-reja {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0 0.75rem;
    padding: 0.375rem 1rem 0.45rem;
  }

  /* ── La columna del reloj ────────────────────────────────────────────
     «Ahora», la hora y el día, uno encima de otro y del ancho de la hora.
     Centrada en vertical contra el tablero, que es quien manda en el alto. */
  .ahora--movil .ahora-reloj {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }
  .ahora--movil [data-ahora-dia],
  .ahora--movil .ahora-fecha {
    font-size: 0.5rem;
    line-height: 0.75rem;
  }
  .ahora--movil .ahora-fecha {
    color: var(--color-apagado-papel);
  }

  /* El mismo cuerpo que tenía —la banda encoge sin que encoja la hora— y
     anclada a la izquierda. `display-centro` escala la Anton desde el
     centro, que es lo que pide la columna centrada del escritorio; aquí,
     con la hora alineada a la izquierda, la dejaba ocho píxeles metida
     hacia dentro y fuera de la línea de todo lo demás.

     Y con el ancho de la hora más ancha, no el de la que toca. La Anton no
     trae cifras tabulares —`tabular-nums` no le hace nada— y «11:11» mide
     54 px donde «00:00» mide 78: con la columna siguiendo a la hora, el
     tablero entero se corría a un lado cada vez que cambiaba el minuto.
     2,15 em es «00:00» con un pelo de aire, y en `em` sigue al cuerpo de la
     hora, que crece con el marco. */
  .ahora--movil .ahora-hora {
    min-width: 2.15em;
    margin: 0.1rem 0;
    font-size: clamp(1.85rem, 9.5cqw, 2.5rem);
    line-height: 0.85;
    transform-origin: left center;
  }

  /* Lo que el escritorio dice en renglones propios, aquí lo dice el
     tablero. «Abierto hasta las 18:00» además se leía como que el festival
     cerraba a esa hora, y es sólo cuándo acaba lo último de lo que está
     abierto; «Corriendo ahora · 4 en 3 sedes» lo cuenta el «1/4» del
     renglón. */
  .ahora--movil .ahora-cierre,
  .ahora--movil .ahora-rotulo {
    display: none;
  }

  /* ── El tablero ──────────────────────────────────────────────────────
     Dos renglones de alto fijo, que se llenan en el orden del DOM. Ese
     orden lo pone el guion: con algo abierto la chapa va debajo —ahora,
     luego—, y sin nada abierto sube, porque entonces lo siguiente es lo
     primero que va a pasar y el renglón negro es lo de después. El tablero
     se lee siempre en el orden del reloj, y un lector de pantalla lo oye
     en el mismo. */
  .ahora--movil .ahora-cuerpo {
    display: grid;
    grid-template-rows: repeat(2, 2.25rem);
    row-gap: 0.25rem;
  }

  /* Y si falta uno —lo último del festival no tiene siguiente, y la última
     espera no tiene después— el otro se queda con los dos renglones y su
     título con dos líneas, en vez de dejar un marco vacío. */
  .ahora--movil .ahora-cuerpo:has(.ahora-luego[hidden]) .ahora-lista,
  .ahora--movil .ahora-cuerpo:has(.ahora-lista:empty) .ahora-luego {
    grid-row: 1 / -1;
    --lineas: 2;
  }

  /* ── El renglón de lo que pasa ───────────────────────────────────────
     El marco es la lista y no la fila, para que el relevo pase por dentro:
     la fila vieja sube y se va, la nueva entra desde abajo, y el marco se
     queda quieto, como la ventanilla de un tablero. */
  .ahora--movil .ahora-lista {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-papel) 22%, transparent);
  }
  .ahora--movil .ahora-lista:empty {
    display: none;
  }
  .ahora--movil .ahora-lista :global(li) {
    height: 100%;
  }

  /* Arriba hasta cuándo, dónde y cuál de cuántas; abajo qué. El `order`
     del escritorio no hace falta: cada pieza tiene su casilla, y lo que se
     lee sigue siendo hora, título y sede, que es como tiene sentido
     escucharlo. */
  .ahora--movil .ahora-lista :global(.ahora-fila) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-content: center;
    column-gap: 0.35rem;
    height: 100%;
    padding: 0 0.5rem;
  }
  .ahora--movil .ahora-lista :global(.ahora-hasta),
  .ahora--movil .ahora-lista :global(.ahora-donde),
  .ahora--movil .ahora-lista :global(.ahora-turno) {
    grid-row: 1;
    min-width: 0;
    font-size: 0.5rem;
    line-height: 0.75rem;
  }
  .ahora--movil .ahora-lista :global(.ahora-donde) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ahora--movil .ahora-lista :global(.ahora-donde::before) {
    content: '· ';
  }
  .ahora--movil .ahora-lista :global(.ahora-turno) {
    grid-column: 3;
    color: var(--color-apagado-papel);
  }

  /* En Anton y en caja alta, que es como esta pantalla escribe los nombres
     —el índice, la lista de sedes, el titular—, y de un renglón: un título
     de doce palabras no puede decidir el alto del tablero.

     La interlínea no se aprieta más de 1,25rem, y es por las tildes. A 14 px
     la Anton ocupa 21 de alto y la Í sube un píxel y medio por encima de su
     propio renglón: con 1,05rem, las tildes del segundo renglón —el que el
     corte esconde— asomaban por debajo del primero como rayitas sueltas.
     Con 20 px cada tilde cabe en su renglón y el corte es limpio. */
  .ahora--movil .ahora-lista :global(.ahora-que) {
    grid-row: 2;
    grid-column: 1 / -1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--lineas, 1);
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.875rem;
    line-height: 1.25rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* El destello rojo al tocar: el mismo con el que responden las filas de
     sedes en este sitio móvil. El dedo ya sabe de qué color es tocar aquí. */
  .ahora--movil .ahora-lista :global(a.ahora-fila:active .ahora-que) {
    color: var(--color-rojo);
  }

  /* El anillo del foco, por dentro. La lista recorta lo que se sale del
     marco —es lo que deja pasar el relevo por dentro—, y el anillo de la
     casa, que va tres píxeles por fuera, se quedaba cortado. */
  .ahora--movil .ahora-lista :global(a.ahora-fila:focus-visible) {
    outline-offset: -4px;
  }

  /* ── El relevo ───────────────────────────────────────────────────────
     La fila que se va sube y se apaga; la que llega entra desde abajo. Es el
     movimiento de un tablero de estación, y es lo que convierte el turno en
     un relevo: sin él, lo que se ve es un renglón que cambia de texto solo,
     que se lee como un error de pintado.

     Los 260 ms de la salida están también en el guion, en `SALIDA`: es él
     quien espera a que termine para pintar la siguiente. */
  .ahora--movil .ahora-lista :global(.ahora-fila) {
    animation: ahora-entra 0.3s var(--ease-salida) both;
  }
  .ahora--movil .ahora-lista[data-saliendo] :global(.ahora-fila) {
    animation: ahora-sale 0.26s var(--ease-salida) both;
  }

  @keyframes ahora-entra {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }
  @keyframes ahora-sale {
    to {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  /* Quieto para quien lo pidió: el turno ya no gira —lo mira el guion— y aquí
     se apaga también el movimiento del primer pintado. */
  @media (prefers-reduced-motion: reduce) {
    .ahora--movil .ahora-lista :global(.ahora-fila),
    .ahora--movil .ahora-lista[data-saliendo] :global(.ahora-fila) {
      animation: none;
    }
  }

  /* ── El renglón de lo siguiente: la chapa roja ──────────────────────
     La chapa del escritorio —campo rojo, canto amarillo— con su misma
     regla: la letra chica no va suelta sobre el rojo. Tinta sobre rojo da
     4,2:1 y a este cuerpo le hacen falta 4,5, así que el «Siguiente · en 20
     min» y la sede van juntos en una tira negra, que es el campo propio que
     el escritorio le da al «cuándo». Aquí habían acabado sueltos sobre el
     rojo. Sobre el rojo queda el título, como en escritorio. */
  .ahora--movil .ahora-luego {
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    align-items: center;
    gap: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .ahora--movil .ahora-cuando,
  .ahora--movil .ahora-quien {
    grid-row: 1;
    align-self: start;
    font-size: 0.5rem;
    line-height: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background-color: var(--color-tinta);
  }
  .ahora--movil .ahora-cuando {
    padding: 0 0.4rem;
  }
  /* La sede, al otro canto de la tira y apagada: acompaña al cuándo, no
     compite con él. */
  .ahora--movil .ahora-quien {
    grid-column: 2;
    margin: 0;
    padding-right: 0.4rem;
    text-align: right;
    color: var(--color-apagado-papel);
    font-weight: 400;
  }
  .ahora--movil .ahora-proxima {
    grid-row: 2;
    grid-column: 1 / -1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--lineas, 1);
    overflow: hidden;
    padding: 0 0.4rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
</style>


<script>
  /**
   * El reloj de la portada: qué hay abierto en el festival, y qué entra luego.
   *
   * Es el de `CartelDeSede` con una sola diferencia de fondo: aquel mira una
   * sede y éste mira las dieciséis, así que aquí «corriendo» son varias cosas
   * en varios sitios y cada una tiene que decir dónde. Lo demás —el reloj de
   * mentira, los tres estados, el latido de treinta segundos— es lo mismo, a
   * propósito: son dos bandas que contestan la misma pregunta y tienen que
   * contestarla igual.
   *
   * Las horas llegan con el huso de Guadalajara puesto (`instanteDe` en
   * `site.ts`), así que quien mire desde otro país ve bien qué está pasando
   * ALLÁ, que es lo que preguntaba.
   */
  type Punto = {
    inicio: string;
    fin: string;
    titulo: string;
    artista: string;
    sede: string;
    ruta: string;
    dia: number;
  };

  /**
   * Una banda, y las que hagan falta.
   *
   * La portada monta dos: la de escritorio y la del teléfono. Las dos están
   * en el DOM a la vez —el ancho decide cuál se pinta— y este guion se
   * empaqueta una sola vez para las dos, así que no puede quedarse con la
   * primera que encuentre: con `querySelector` a secas, la del teléfono se
   * quedaba en blanco.
   *
   * Cada una trae sus propios datos dentro y su propio número de renglones,
   * así que arrancarlas es repetir lo mismo sobre otro elemento.
   */
  const arrancar = (banda: HTMLElement) => {
    const fuente = banda.querySelector<HTMLScriptElement>('[data-reloj-portada]');
    if (!fuente) return;

    /** Cuántas actividades se enseñan: la lista entera en escritorio, y el
     *  tope de la cola de «después» en el teléfono. La cuenta está arriba,
     *  junto a `caben`. */
    const CABEN = () => Number(banda.dataset.caben) || 5;

    /** Qué banda es. La del teléfono es un tablero de dos renglones que turna
     *  lo que no cabe; la de escritorio, la guía entera. */
    const movil = banda.dataset.variante === 'movil';

    /** Si hay más de una actividad que turnar. Lo decide `pintarLista`, y lo
     *  lee el reloj del turno para no animar un relevo que no existe. */
    let hayTurnos = false;

    let puntos: Punto[] = [];
    try {
      puntos = JSON.parse(fuente.textContent || '[]');
    } catch {
      puntos = [];
    }

    const $ = <T extends HTMLElement>(sel: string) => banda.querySelector<T>(sel);

    const dosCifras = (n: number) => String(n).padStart(2, '0');
    const relojDe = (d: Date) => `${dosCifras(d.getHours())}:${dosCifras(d.getMinutes())}`;

    /** «sáb 26». En dos llamadas y no en una, por lo mismo que la fecha suelta
     *  de la lista: pedidos juntos, `toLocaleDateString` puede meter una coma
     *  en medio. Y sin el punto de la abreviatura, que según el navegador
     *  viene o no viene. */
    const cortoDe = (f: Date) =>
      `${f.toLocaleDateString('es-MX', { weekday: 'short' }).replace(/\.$/, '')} ${f.getDate()}`;

    /**
     * El reloj de mentira, para poder ver la banda antes del festival.
     *
     * `?ahora=2026-09-26T13:40` y la portada se comporta como si fuera ese
     * momento. Es el mismo parámetro que ya entiende el cartel de sede, y
     * existe por lo mismo: esta banda sólo se pinta durante los cuatro días,
     * así que sin esto la única manera de revisarla —o de enseñársela a
     * alguien— sería cambiarle la hora al ordenador.
     */
    const finge = new URLSearchParams(location.search).get('ahora');
    const desfase = finge ? new Date(finge).getTime() - Date.now() : 0;
    const reloj = () => Date.now() + (Number.isFinite(desfase) ? desfase : 0);

    /**
     * Cuánto falta para algo, en horas y minutos.
     *
     * Es lo que dice la chapa roja, y es una cuenta atrás de verdad: «En 48 h
     * 22 min», no «Jue 24 · 11:00». La hora a la que es ya está escrita en su
     * renglón de la lista; lo que la chapa añade —lo único que añade— es
     * cuánto queda, que es lo que hay que saber para decidir si sales de casa.
     *
     * Y no se corta a la hora y media. Faltando dos días sigue contando en
     * horas, porque el día al que es tampoco dice cuánto falta: entre «jue 24»
     * y «en 48 h» hay una cuenta que, si no la hace la banda, la tiene que
     * hacer quien lee.
     */
    const faltaPara = (cuando: number) => {
      const minutos = Math.max(0, Math.round((cuando - reloj()) / 60000));
      if (minutos < 60) return `En ${minutos} min`;
      const horas = Math.floor(minutos / 60);
      const resto = minutos % 60;
      return resto ? `En ${horas} h ${resto} min` : `En ${horas} h`;
    };

    const conFechas = puntos.map((p) => ({
      ...p,
      desde: new Date(p.inicio).getTime(),
      hasta: new Date(p.fin).getTime(),
    }));

    /** Un renglón: cuándo, qué, y dónde. Si la sede tiene página, el renglón
     *  entero es el enlace; si es un recorrido, no hay a dónde ir.
     *
     *  El «cuándo» llega hecho desde fuera y no se calcula aquí, porque no es
     *  el mismo para las dos mitades de la lista: lo que está corriendo se
     *  dice por cuándo ACABA —«hasta 18:00», que es lo que hay que saber para
     *  decidir si da tiempo— y lo que viene, por cuándo EMPIEZA.
     *
     *  La `cuenta` —«2/4»— sólo la pide el teléfono, donde el renglón va
     *  turnando; en escritorio la lista entera está a la vista. */
    const renglon = (p: (typeof conFechas)[number], cuando: string, cuenta = '') => {
      const li = document.createElement('li');
      const fila = document.createElement(p.ruta ? 'a' : 'div');
      fila.className = 'ahora-fila';
      if (fila instanceof HTMLAnchorElement) {
        fila.href = p.ruta;
        fila.setAttribute('aria-label', `${p.titulo}, en ${p.sede}`);
      }

      const hasta = document.createElement('span');
      hasta.className = 'meta ahora-hasta';
      hasta.textContent = cuando;

      const que = document.createElement('span');
      que.className = 'ahora-que font-bold';
      que.textContent = p.titulo;

      const donde = document.createElement('span');
      donde.className = 'meta ahora-donde';
      donde.textContent = p.sede;

      fila.append(hasta, que, donde);

      if (cuenta) {
        const cual = document.createElement('span');
        cual.className = 'meta ahora-turno';
        cual.textContent = cuenta;
        fila.append(cual);
      }

      li.append(fila);
      return li;
    };

    /**
     * ── La chapa roja: lo siguiente ──────────────────────────────────────
     *
     * Lleva la palabra escrita. Decía sólo «En 20 min», y un tiempo suelto no
     * dice de qué es: el resto de la banda son horas por todas partes —«hasta
     * 18:00», «11:00»— y una más no se distinguía. «Siguiente · en 20 min» sí.
     *
     * ── Y si hay varias a la misma hora, se van turnando ────────────────
     *
     * A las 19:00 del viernes arrancan tres cosas a la vez en tres sedes. No
     * hay una que sea «la siguiente»: son tres, y quedarse con la primera de
     * la lista es elegir por orden de fichero y dejar las otras dos sin
     * anunciar. La chapa las va pasando, y dice cuál de cuántas enseña para
     * que el cambio se lea como un turno y no como un fallo.
     */
    const luego = banda.querySelector<HTMLElement>('[data-ahora-luego]')!;
    const quien = banda.querySelector<HTMLElement>('[data-ahora-artista]')!;
    const cuandoChapa = banda.querySelector<HTMLElement>('[data-ahora-cuando]')!;
    const proximaChapa = banda.querySelector<HTMLElement>('[data-ahora-proxima]')!;

    let empatadas: { desde: number; titulo: string; artista: string; sede: string }[] = [];
    let giro = 0;
    /* Qué empate se está enseñando. Sirve para no reiniciar el turno de la
       chapa cuando la banda se repinta por otra cosa —cada minuto lo hace— y
       el siguiente sigue siendo el mismo: antes, el repintado del minuto
       cortaba el ciclo de tres a mitad y volvía siempre al primero. */
    let claveEmpate = '';

    /** El turno del renglón del teléfono: cuál de la cola se enseña. Lo mueve
     *  su propio reloj, y lo lee `pintarLista` cada vez que pinta. */
    let turno = 0;

    const pintarChapa = () => {
      if (!empatadas.length) {
        luego.hidden = true;
        return;
      }

      const p = empatadas[giro % empatadas.length];
      const turno = empatadas.length > 1 ? ` · ${(giro % empatadas.length) + 1}/${empatadas.length}` : '';
      cuandoChapa.textContent = `Siguiente · ${faltaPara(p.desde).toLowerCase()}${turno}`;
      /* El título y nada más. Aquí estuvo la hora a la que es, delante —«11:00
         · Conversatorio…»—, y sobra por los dos lados: la chapa ya dice cuánto
         falta, y la hora exacta está en el renglón de esa misma actividad
         dentro de la lista. Puesta aquí partía el titular en dos. */
      proximaChapa.textContent = p.titulo;
      /* En el teléfono, la sede y no el artista. El tablero contesta «¿a dónde
         me muevo?», y el renglón de encima ya dice dónde: si el de abajo
         dijera quién, los dos renglones pondrían cosas distintas en la misma
         casilla. */
      quien.textContent = movil ? p.sede : p.artista || p.sede;
      quien.hidden = false;
      luego.hidden = false;
    };

    /**
     * El turno, cada cinco segundos.
     *
     * Sólo con empate —con una sola siguiente no hay nada que turnar— y no
     * con `prefers-reduced-motion`: para quien pidió que las cosas se estén
     * quietas, un bloque que se cambia solo cada cinco segundos es justo lo
     * que pidió no tener. Ahí se queda la primera, y el «1/3» sigue diciendo
     * que hay tres.
     */
    const quieto = matchMedia('(prefers-reduced-motion: reduce)');
    setInterval(() => {
      if (empatadas.length > 1 && !quieto.matches) {
        giro += 1;
        pintarChapa();
      }
    }, 5_000);

    /**
     * El turno del renglón, cada seis segundos.
     *
     * Más lento que el de la chapa —cinco— a propósito: la chapa cambia un
     * título y el renglón cambia título, hora y sede, que es más letra que
     * leer. Y desfasados, para que las dos cosas no salten a la vez y la
     * banda entera parpadee.
     *
     * Lo dispara `repintarTira`, que vuelve a pintar SÓLO la lista: llamar a
     * `pintar()` entero reharía también el reloj y la chapa, y con ellos el
     * ciclo de los empates.
     *
     * Y se para mientras alguien lo está usando. El turno no cambia el texto
     * del renglón: lo tira y pinta uno nuevo, así que con el foco del teclado
     * encima el foco se perdía cada seis segundos, y el enlace que se iba a
     * pulsar pasaba a ser otro. Lo mismo con el puntero parado encima, que es
     * donde se va a hacer clic. En un teléfono el `:hover` se queda pegado
     * después de tocar, así que ése sólo cuenta donde hay puntero de verdad.
     */
    let repintarTira = () => {};

    const conPuntero = matchMedia('(hover: hover)');
    const enUso = () =>
      banda.matches(':focus-within') || (conPuntero.matches && banda.matches(':hover'));

    /** Cuánto dura la salida. El mismo número está en el CSS, en
     *  `@keyframes ahora-sale`: si se separan, la fila vieja se va y deja un
     *  hueco en blanco antes de que entre la nueva. */
    const SALIDA = 260;

    setInterval(() => {
      if (!hayTurnos || !movil || quieto.matches || enUso()) return;

      const lista = banda.querySelector<HTMLElement>('[data-ahora-lista]');
      if (!lista) return;

      /* Sale, y al acabar entra la siguiente. Se hace en dos tiempos y no de
         golpe porque un relevo instantáneo a esta velocidad se lee como un
         error de pintado: lo que se ve es un renglón que cambia de texto. */
      lista.dataset.saliendo = '';
      setTimeout(() => {
        delete lista.dataset.saliendo;
        turno += 1;
        repintarTira();
      }, SALIDA);
    }, 6_000);

    const pintar = () => {
      const ahora = reloj();
      if (!conFechas.length) return;

      /* La banda contesta siempre lo mismo —«¿qué hay abierto?»— en los tres
         momentos en que se puede preguntar: con algo corriendo, con el
         festival en marcha y todo parado, y antes de que empiece nada. Lo
         único que no tiene respuesta es después: con la última actividad del
         festival terminada no hay siguiente que anunciar, y la banda se va. */
      const arranca = Math.min(...conFechas.map((p) => p.desde));
      const termina = Math.max(...conFechas.map((p) => p.hasta));
      if (ahora > termina) return;

      const corriendo = conFechas
        .filter((p) => p.desde <= ahora && p.hasta > ahora)
        .sort((a, b) => a.hasta - b.hasta);
      const proximas = conFechas
        .filter((p) => p.desde > ahora)
        .sort((a, b) => a.desde - b.desde);
      const siguiente = proximas[0];

      const d = new Date(ahora);
      const rotulo = $('[data-ahora-rotulo]')!;
      const lista = $('[data-ahora-lista]')!;
      const cierre = $('[data-ahora-cierre]')!;
      lista.textContent = '';

      /**
       * Cuándo es algo, contado desde ahora y dicho como lo diría uno.
       *
       * Es la única regla de horas de la banda, y la usan los renglones y la
       * chapa roja por igual: dos maneras distintas de decir la misma hora en
       * el mismo bloque se leen como dos horas distintas.
       *
       * La escala es la de quien está en la calle decidiendo si le da tiempo:
       * dentro de hora y media, los minutos que faltan —que es lo único que
       * sirve para eso—; más tarde el mismo día, la hora a secas; y otro día,
       * con su día delante, porque «a las 18:30» sin día no dice nada.
       */
      const cuandoEs = (cuando: number) => {
        const faltan = Math.round((cuando - ahora) / 60000);
        if (faltan <= 90) return { dicho: `En ${faltan} min`, llevaHora: false };
        const fecha = new Date(cuando);
        if (fecha.toDateString() === d.toDateString())
          return { dicho: `Hoy · ${relojDe(fecha)}`, llevaHora: true };
        return {
          dicho: `${fecha.toLocaleDateString('es-MX', { weekday: 'short', day: 'numeric' })} · ${relojDe(fecha)}`,
          llevaHora: true,
        };
      };

      /**
       * Y con qué se llena la lista.
       *
       * Con algo corriendo, la lista es lo que está corriendo y la chapa roja
       * de abajo es lo siguiente. Sin nada corriendo, la lista pasa a ser lo
       * que viene — antes se quedaba VACÍA con un rótulo encima, que es la
       * peor manera de contestar «¿qué hay?»: entre la charla de la tarde y la
       * fiesta de la noche hay cuatro horas, y en esas cuatro horas la banda
       * no decía nada. Y la chapa se cae, porque lo siguiente ya es el primer
       * renglón y repetirlo dos veces en el mismo bloque se lee como dos
       * cosas.
       */
      /**
       * El renglón de la fecha que abre cada día.
       *
       * «Jueves 24 de septiembre», sin la coma que mete `toLocaleDateString`
       * cuando se le piden el día de la semana y la fecha de una vez: es como
       * escribe las fechas el resto del sitio, y sale de juntar dos llamadas
       * en vez de limpiar la coma a posteriori.
       *
       * Y si es hoy, «Hoy» a secas: el reloj que está justo encima ya dice
       * «Ahora · jueves 24», y repetirlo entero dos renglones más abajo es
       * gastar el único sitio donde cabe algo que no se sabe.
       */
      const diaSuelto = (f: Date, rotulo?: string) => {
        const li = document.createElement('li');
        li.className = 'meta ahora-dia';
        li.textContent =
          rotulo ??
          (f.toDateString() === d.toDateString()
            ? 'Hoy'
            : `${f.toLocaleDateString('es-MX', { weekday: 'long' })} ${f.toLocaleDateString('es-MX', { day: 'numeric', month: 'long' })}`);
        return li;
      };

      /**
       * Cuándo es lo de después, en el renglón negro del teléfono cuando no
       * hay nada abierto. Con la palabra delante por lo mismo que la chapa
       * lleva «Siguiente»: una hora suelta no dice de qué es, y justo encima
       * hay otra. La escala es la de `cuandoEs` sin el «Hoy», que en un
       * tablero de hoy no dice nada.
       */
      const despuesDe = (cuando: number) => {
        const faltan = Math.round((cuando - ahora) / 60000);
        const f = new Date(cuando);
        if (faltan <= 90) return `Después · en ${faltan} min`;
        return f.toDateString() === d.toDateString()
          ? `Después · ${relojDe(f)}`
          : `Después · ${cortoDe(f)} ${relojDe(f)}`;
      };

      /**
       * La guía: lo que está puesto y lo que entra después, en un solo carril.
       *
       * Es una guía de televisión y se comporta como una. Antes era una cosa o
       * la otra —con algo corriendo, SÓLO lo que corre; sin nada, sólo lo que
       * viene—, y con cuatro actividades abiertas la banda se quedaba sin
       * decir qué entraba luego. Una guía no hace eso: enseña la franja de
       * ahora y sigue hacia abajo hasta llenar el hueco que tiene.
       *
       * Y se mueve sola. Cada minuto se rehace con el reloj nuevo, así que lo
       * que termina se cae por arriba y lo que se acerca entra por abajo, sin
       * que nadie toque nada.
       */
      const pintarLista = () => {
        lista.textContent = '';

        /* ── El teléfono: un renglón que va turnando ──────────────────
           El tablero tiene un renglón para lo que está pasando, y lo que no
           cabe pasa por él de uno en uno, en orden, volviendo al primero al
           llegar al último. Dice cuál de cuántas enseña —«2/4»— para que el
           cambio se lea como un turno y no como un fallo, igual que la chapa
           con sus empates.

           Sin nada abierto, el renglón es lo de DESPUÉS: lo siguiente ya está
           en la chapa roja, que sube arriba, y aquí van los que vienen detrás
           de ella. Detrás de TODAS las que empatan con ella, que ésas ya las
           va turnando la chapa: contar desde la segunda de la cola, como se
           hacía, repetía en negro la que la chapa enseñaba en rojo.

           Con `prefers-reduced-motion` no gira —eso lo mira el reloj del
           turno—, pero se pinta igual: la primera y la cuenta. Antes caía a
           la guía entera de escritorio, y en el teléfono eso eran cinco
           renglones apilados en una banda pensada para uno. */
        if (movil) {
          const suyos = corriendo.length
            ? corriendo.map((p) => ({ p, cuando: `hasta ${relojDe(new Date(p.hasta))}` }))
            : proximas
                .filter((p) => siguiente && p.desde > siguiente.desde)
                .slice(0, CABEN())
                .map((p) => ({ p, cuando: despuesDe(p.desde) }));

          hayTurnos = suyos.length > 1;
          if (!suyos.length) return;

          const cual = turno % suyos.length;
          const { p, cuando } = suyos[cual];
          lista.append(renglon(p, cuando, hayTurnos ? `${cual + 1}/${suyos.length}` : ''));
          return;
        }

        /* ── Lo demás: la guía entera, de una ─────────────────────────
           Lo que está puesto, dicho por cuándo ACABA —que es lo que hay que
           saber para decidir si da tiempo a llegar— y detrás lo que entra,
           hasta llenar.

           La fecha se escribe una vez y encima de su grupo, y entonces cada
           renglón sólo tiene que decir su hora. El primer grupo se llama «A
           continuación» cuando es de hoy y hay algo corriendo: ahí el
           separador no está diciendo qué día es —eso ya se sabe—, está
           marcando dónde acaba lo que está puesto y empieza lo que no. */
        const cuantas = CABEN();

        for (const p of corriendo.slice(0, cuantas))
          lista.append(renglon(p, `hasta ${relojDe(new Date(p.hasta))}`));

        const hueco = cuantas - Math.min(corriendo.length, cuantas);
        if (hueco <= 0) return;

        let ultimo = '';
        let primero = true;
        for (const p of proximas.slice(0, hueco)) {
          const f = new Date(p.desde);
          const suyo = f.toDateString();
          if (suyo !== ultimo) {
            const hoy = suyo === d.toDateString();
            lista.append(
              diaSuelto(f, primero && hoy && corriendo.length > 0 ? 'A continuación' : undefined),
            );
            ultimo = suyo;
            primero = false;
          }
          const faltan = Math.round((p.desde - ahora) / 60000);
          lista.append(renglon(p, faltan <= 90 ? `En ${faltan} min` : relojDe(f)));
        }
      };

      /**
       * En qué fase estamos, dicho en el propio elemento.
       *
       * Lo lee la portada móvil para saber si relevar la cuenta atrás. No es
       * la única señal: `motion.ts` marca su propio cero, que es el arranque
       * del festival y no la primera actividad, y el relevo entra con el
       * primero de los dos que llegue (ver `movil.css`). Éste hace falta
       * igual, porque el reloj de mentira de `?ahora=` sólo lo entiende esta
       * banda, y sin él no habría manera de ver el relevo antes de tiempo.
       */
      banda.dataset.fase = ahora < arranca ? 'antes' : 'curso';

      if (ahora < arranca) {
        /* Todavía no empieza. La banda dice lo único que se puede decir, que
           es qué va a ser lo primero — y así la mejor franja de la portada no
           se queda en blanco durante los meses de espera. */
        const primera = new Date(arranca);
        const manana = new Date(d);
        manana.setDate(manana.getDate() + 1);

        const esHoy = primera.toDateString() === d.toDateString();
        const esManana = primera.toDateString() === manana.toDateString();

        $('[data-ahora-dia]')!.textContent = esHoy
          ? 'Empieza hoy'
          : esManana
            ? 'Empieza mañana'
            : 'Todavía no empieza';

        /* La hora, como en los otros dos estados.
           Aquí estuvo el día al que abre —«JUE 24»— metido en el sitio del
           reloj, y antes de eso los días que faltaban. Las dos cosas hacen lo
           mismo: convierten en una etiqueta el único sitio de la banda que se
           mira sin leer. Un reloj que unas veces marca las 13:40 y otras pone
           «JUE 24» ya no es un reloj.

           Cuándo abre no se pierde: baja al renglón de debajo, que es donde
           vive lo que acompaña a la hora en los tres estados. Y los días que
           faltan siguen sin decirse — la cuenta regresiva del hero está dos
           pantallas más arriba contando a lo mismo. */
        $('[data-ahora-reloj]')!.textContent = relojDe(d);
        cierre.textContent = esHoy
          ? `Abre a las ${relojDe(primera)}`
          : esManana
            ? `Abre mañana a las ${relojDe(primera)}`
            : `Abre el ${primera.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric' })} a las ${relojDe(primera)}`;

        /* Sin rótulo. Aquí puso «Lo primero» y no decía nada que no estuviera
           ya dicho: el renglón de la fecha que abre la lista —«Jueves 24 de
           septiembre»— la encabeza igual de bien, y el renglón de encima ya
           avisa de que el festival no ha empezado. Un rótulo que repite a sus
           dos vecinos es una franja gastada. */
        rotulo.textContent = '';
      } else {
        $('[data-ahora-dia]')!.textContent = `Ahora · ${d.toLocaleDateString('es-MX', {
          weekday: 'long',
          day: 'numeric',
        })}`;
        $('[data-ahora-reloj]')!.textContent = relojDe(d);

        if (corriendo.length) {
          /* Cuántas y en cuántos sitios: con dieciséis sedes, «3 abiertas» no
             es lo mismo que «3 cosas en la misma sala», y la diferencia es la
             que decide si hay que moverse. */
          const sitios = new Set(corriendo.map((p) => p.sede)).size;
          rotulo.textContent =
            sitios > 1
              ? `Corriendo ahora · ${corriendo.length} en ${sitios} sedes`
              : `Corriendo ahora · ${corriendo.length}`;

          const ultimo = Math.max(...corriendo.map((p) => p.hasta));
          cierre.textContent = `Abierto hasta las ${relojDe(new Date(ultimo))}`;
        } else {
          /* El festival está en marcha pero no hay nada abierto. Es un estado
             de verdad —entre la charla de la tarde y la fiesta de la noche hay
             cuatro horas— y lo que hace falta saber es cuándo vuelve a abrir,
             que ahora lo dice la propia lista. */
          rotulo.textContent = 'Lo que viene';
          cierre.textContent = siguiente ? `Vuelve a abrir ${cuandoEs(siguiente.desde).dicho.toLowerCase()}` : '';
        }
      }

      /* El teléfono dice «Ahora», y el día en su renglón debajo de la hora, en
         las dos fases. Allí la banda puede salir antes de la primera actividad
         —en cuanto la cuenta atrás llega a cero, ver el relevo en `movil.css`—
         y un «Empieza hoy» encima de la hora se leía como si empezara a esa
         hora. Lo que falta para abrir ya lo dice la chapa roja. */
      if (movil) {
        $('[data-ahora-dia]')!.textContent = 'Ahora';
        const fecha = $('[data-ahora-fecha]');
        if (fecha) fecha.textContent = cortoDe(d);
      }

      /* Y si no hay rótulo, no hay franja: un `<p>` vacío mide un renglón
         igual, y ese renglón se ve. */
      rotulo.hidden = !rotulo.textContent;

      /* El orden del tablero del teléfono, que es el del reloj: con algo
         abierto, lo abierto y debajo la chapa; sin nada abierto, la chapa
         arriba y lo de después debajo. Se mueve la chapa en el DOM y no sólo
         en la pantalla para que un lector de pantalla lo oiga en el mismo
         orden en que se ve. */
      if (movil) {
        if (corriendo.length) lista.after(luego);
        else lista.before(luego);
      }

      /* El reloj del turno pinta esta misma lista, con la cola y la hora de
         esta pasada: se le pasa aquí, que es donde las dos cosas existen. */
      repintarTira = pintarLista;
      pintarLista();

      /* La chapa roja la pinta `pintarChapa`, que además es quien la gira
         cuando hay un empate. Aquí sólo se le dice a qué mirar: todas las que
         arrancan en el mismo instante que la primera que queda. */
      empatadas = siguiente ? proximas.filter((p) => p.desde === siguiente.desde) : [];
      const clave = siguiente ? `${siguiente.desde}·${empatadas.length}` : '';
      if (clave !== claveEmpate) {
        claveEmpate = clave;
        giro = 0;
      }
      pintarChapa();

      banda.hidden = false;
    };

    /**
     * Y el latido, clavado al minuto.
     *
     * Fue un `setInterval` de treinta segundos y se cae. Todo lo que enseña
     * esta banda son minutos —el reloj grande, el «en 20 min», el «hasta las
     * 18:00»— y un latido suelto cae donde cae: arranca en el segundo 47 y a
     * partir de ahí el reloj de la portada enseña las 13:39 durante los
     * diecisiete primeros segundos de las 13:40. Es la clase de error que no
     * se ve en una revisión y se ve el sábado, con la banda a tamaño de
     * cartel y el teléfono de al lado diciendo otra hora.
     *
     * Así que cada repintado calcula cuándo empieza el minuto siguiente y se
     * cita ahí. El medio segundo de más es para no llegar justo al filo y
     * pintar todavía el minuto viejo por un redondeo.
     */
    const latir = () => {
      pintar();
      const falta = 60_000 - ((reloj() % 60_000) + 60_000) % 60_000;
      setTimeout(latir, falta + 500);
    };

    latir();
  };

  for (const banda of document.querySelectorAll<HTMLElement>('[data-ahora]')) arrancar(banda);
</script>
