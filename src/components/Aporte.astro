---
import { imagen, juegoDeImagenes } from '../lib/imagen';
import type { Aporte } from '../data/archivo';

/**
 * Una entrada de la galería abierta: las fotos de alguien, juntas, con su
 * título y su nombre.
 *
 * Es **la ficha de la casa** —canto de 2 px, sombra dura, papel— con una hoja
 * de contactos arriba. Las fotos de una entrada se ven juntas porque se
 * mandaron juntas: separarlas en la rejilla general sería perder lo único que
 * las agrupa, que es que las vio la misma persona.
 *
 * **El mosaico cambia con cuántas son**, de una a cinco (`.aporte-mosaico--N`
 * en `global.css`): la primera manda —es la que eligió poner primero quien la
 * mandó— y el resto se reparte a su lado. Una entrada trae hasta quince; si
 * son más de cinco, la quinta lleva encima cuántas faltan («+10») y el visor
 * las tiene todas. Separadas por el mismo filete de 2 px
 * que separa todo en el sitio, que aquí es el fondo de tinta asomando entre
 * foto y foto.
 *
 * Cada foto es un enlace a sí misma en grande. Sin JS abre la foto y ya; con
 * JS abre el visor (`data-abre="visor"`, ver `src/scripts/galeria.ts`) en esa
 * foto, con las demás de la entrada a un toque.
 *
 * **Es compacta a propósito**: el mosaico, el título y quién la mandó, y
 * nada más. La descripción, la fecha y el Instagram con su enlace viven en el
 * visor, que es donde se lee con calma. Así caben dos por fila en el teléfono
 * y cuatro en el escritorio —seis y ocho entradas por pantalla, contra una y
 * tres cuando la ficha lo traía todo—. Elegida el 28/09 entre tres versiones
 * compactas.
 *
 * Se mide a sí misma, como la de artistas: el título escala con su ancho y no
 * con el de la ventana.
 */
interface Props {
  aporte: Aporte;
  /** Su lugar en la lista: el índice del visor. */
  indice: number;
  /** Cuánto mide en la página, para que el navegador pida la foto justa. */
  sizes: string;
}

const { aporte, indice, sizes } = Astro.props;
const n = aporte.fotos.length;
/* El mosaico enseña cinco como mucho; si trae más, la quinta lleva encima
   cuántas faltan y el visor las tiene todas. */
const EN_MOSAICO = 5;
const mosaico = aporte.fotos.slice(0, EN_MOSAICO);
const m = mosaico.length;
const faltan = n - m;
/* Quién la mandó, en un renglón: el nombre y, si lo dio, su cuenta. */
const por = [aporte.nombre, aporte.instagram && `@${aporte.instagram}`].filter(Boolean).join(' · ');

/* En el mosaico la primera ocupa más que las otras: entera con una, la mitad
   con dos o cuatro, dos tercios con tres, la mitad con cinco. Las chicas nunca
   pasan de medio ancho de ficha, así que les basta la escalera corta. */
const anchos = (i: number) => (i === 0 ? [480, 800, 1200] : [320, 480, 800]);

/* Y cuánto de la ficha ocupa cada una, para decírselo al navegador. `sizes`
   llega con el ancho de la ficha entera, y con ése las chicas del mosaico
   —un cuarto de ficha en una de cinco— pedían la foto de la ficha entera: en
   un teléfono de triple densidad, 800 px para pintar 85. Cada foto lleva su
   `sizes` multiplicado por su parte. */
const PARTES: Record<number, [number, number]> = {
  1: [1, 1],
  2: [1 / 2, 1 / 2],
  3: [2 / 3, 1 / 3],
  4: [1 / 2, 1 / 2],
  5: [1 / 2, 1 / 4],
};
const [primera, resto] = PARTES[m] ?? [1, 1];
const sizesDe = (i: number) => {
  const parte = i === 0 ? primera : resto;
  if (parte === 1) return sizes;
  return sizes
    .split(',')
    .map((regla) => {
      const trozos = regla.trim().split(/\s+(?=[^\s]+$)/);
      const largo = trozos.pop()!;
      return [...trozos, `calc(${largo} * ${parte.toFixed(3)})`].join(' ');
    })
    .join(', ');
};
---

<li class="aporte ficha flex flex-col" data-reveal="escala" data-retraso={(indice % 4) * 70}>
  <div class={`aporte-mosaico aporte-mosaico--${m}`}>
    {
      mosaico.map((f, i) => (
        <a
          href={imagen(f.src, 1600)}
          class="aporte-foto"
          data-abre="visor"
          data-aporte={indice}
          data-foto={i}
          aria-label={`${aporte.titulo} — foto ${i + 1} de ${n}`}
        >
          <img
            src={imagen(f.src, i === 0 ? 800 : 480)}
            srcset={juegoDeImagenes(f.src, anchos(i)) || undefined}
            sizes={sizesDe(i)}
            alt=""
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
          {i === m - 1 && faltan > 0 && <span class="aporte-mas display" aria-hidden="true">+{faltan}</span>}
        </a>
      ))
    }
    {n > 1 && <span class="aporte-chapa meta">{n} fotos</span>}
  </div>

  <div class="aporte-pie flex-1">
    <h3 class="display">{aporte.titulo}</h3>
    <p class="aporte-por meta">{por}</p>
  </div>
</li>
