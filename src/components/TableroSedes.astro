---
/**
 * El tablero de `/sedes` en pantalla ancha: las dieciséis a la izquierda, el
 * programa de la elegida a la derecha.
 *
 * Por qué un tablero y no la rejilla de tarjetas que había: la rejilla contesta
 * «dónde es el festival» y no tiene sitio para contestar «qué pasa aquí». Las
 * dos formas que lo intentaban dentro de la tarjeta fallan por el mismo lado:
 * No Museo tiene once actividades y Palma Galería ninguna, así que un pliegue
 * abierto estira su fila hasta mil quinientos píxeles y deja dos columnas de
 * amarillo vacío al lado. En el tablero la lista no se mueve, el programa cae
 * en una columna que es suya, y las cuatro sedes sin nada lo dicen en su
 * renglón sin dejar un hueco del tamaño de una tarjeta.
 *
 * Cada renglón es un enlace de verdad a `/sedes/<ranura>` y no un botón que
 * cambia el panel con JavaScript. Es lo mismo que hace el resto del sitio —la
 * rejilla del programa se coloca entera en el build— y es lo que hace que la
 * sede que estás viendo tenga dirección propia: se comparte por WhatsApp, se
 * abre sin scripts y sale en el mapa del sitio.
 */
import { conBase } from '../lib/base';
import AvisoPrograma from './AvisoPrograma.astro';
import {
  agendaPorSede,
  sedes,
  enlaceMapa,
  enTodasLasSedes,
  programaPublicado,
  rutaSala,
  festival,
} from '../data/site';
import type { AgendaDeSede } from '../data/site';

interface Props {
  /** La sede abierta. Sin ella se abre la primera: una columna vacía con un
   *  «elegí una sede» gasta media pantalla en pedir un clic que el visitante
   *  todavía no sabe que puede dar. */
  activa?: AgendaDeSede;
  /**
   * Si la cabecera del panel repite el nombre de la sede.
   *
   * En `/sedes` sí: el titular de la página dice SEDES y hay que decir cuál se
   * está mirando. En `/sedes/<ranura>` no: el nombre acaba de salir a tamaño
   * cartel tres centímetros más arriba, y repetirlo no es énfasis, es un
   * segundo titular compitiendo con el primero.
   */
  titular?: boolean;
}

const { activa = agendaPorSede[0], titular = true } = Astro.props;
---

<section class="border-t-2 border-tinta bg-amarillo">
  <div class="grid lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)]">
    {/* ── La lista ────────────────────────────────────────────────────────
        Las dieciséis, siempre. El número es el mismo que lleva la sede en el
        plano de la portada, así que el «06» de aquí y la estrella de allá son
        la misma sede. */}
    <nav
      class="border-b-2 border-tinta lg:border-r-2 lg:border-b-0"
      aria-label={`Las ${agendaPorSede.length} sedes`}
    >
      {
        agendaPorSede.map((agenda) => {
          const abierta = agenda.sede.nombre === activa.sede.nombre;
          return (
            <a
              href={conBase(agenda.ruta)}
              aria-current={abierta ? 'page' : undefined}
              class:list={[
                'fila-sede flex items-center gap-4 border-b border-tinta/25 px-6 py-3 transition-colors duration-200',
                abierta ? 'bg-tinta text-amarillo' : 'hover:bg-tinta hover:text-amarillo',
              ]}
            >
              <span class="meta w-6 shrink-0 opacity-60">
                {String(agenda.indice + 1).padStart(2, '0')}
              </span>
              <span class="display min-w-0 text-2xl leading-none">{agenda.sede.nombre}</span>
              {/* La cuenta a la derecha, en dato: es la columna por la que se
                  recorre la lista buscando dónde hay más. Sin programa
                  publicado no se pinta ninguna — contar lo que todavía no se
                  enseña es publicarlo por la puerta de atrás. */}
              {programaPublicado && (
                <span class="meta ml-auto shrink-0 text-right opacity-70">{agenda.total}</span>
              )}
            </a>
          );
        })
      }
    </nav>

    {/* ── El programa de la elegida ───────────────────────────────────── */}
    <div class="flex flex-col">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6 border-b-2 border-tinta bg-tinta px-6 py-6 text-papel lg:px-8">
        <div>
          <p class="meta text-amarillo">
            Sede {String(activa.indice + 1).padStart(2, '0')} / {agendaPorSede.length}
          </p>
          {
            titular && (
              <h2 class="display mt-3 text-5xl leading-[0.95] text-amarillo lg:text-6xl">
                {activa.sede.nombre}
              </h2>
            )
          }
          <address class="mt-4 max-w-md text-base leading-snug not-italic text-papel/85">
            {activa.sede.direccion}
          </address>
          {
            programaPublicado && (
              <p class="meta mt-4 text-papel/60">{activa.resumen}</p>
            )
          }
        </div>

        {/* Las dos puertas de siempre, con el mismo reparto de color que la
            rejilla vieja: conocer en amarillo, ubicar en rojo. */}
        <div class="flex divide-x-2 divide-tinta border-2 border-papel">
          {
            activa.sede.instagram && (
              <a
                href={activa.sede.instagram}
                target="_blank"
                rel="noopener"
                class="meta bg-amarillo px-5 py-4 font-bold text-tinta transition-colors duration-300 hover:bg-papel"
              >
                {sedes.acciones.instagram} ↗
              </a>
            )
          }
          <a
            href={enlaceMapa(activa.sede)}
            target="_blank"
            rel="noopener"
            class="meta bg-rojo px-5 py-4 font-bold text-papel transition-colors duration-300 hover:bg-amarillo hover:text-tinta"
          >
            {sedes.acciones.ubicacion} ↗
          </a>
        </div>
      </div>

      {
        !programaPublicado ? (
          /* El mismo cartel que `/programa` y `/registro`. Es la misma
             declaración en otra puerta, y decirla de otra forma haría creer
             que es otra cosa. */
          <div class="p-6 lg:p-8">
            <AvisoPrograma compacto />
          </div>
        ) : activa.dias.length === 0 ? (
          /* El hueco honesto. No dice «próximamente»: dice lo que hay —nada— y
             por dónde seguir, que es lo único útil aquí. */
          <div class="max-w-2xl p-6 lg:p-8">
            <p class="display text-4xl leading-[0.95] lg:text-5xl">
              Sin actividades<br />en el programa
            </p>
            <p class="mt-5 text-lg leading-relaxed text-tinta/70">
              {activa.sede.nombre} es sede del {festival.nombre}, pero todavía no tiene
              nada anunciado. Lo que se programe aquí sale en esta página.
            </p>
            <div class="mt-7 flex flex-wrap gap-4">
              <a href={conBase('/programa')} class="boton">Ver el programa</a>
              {activa.sede.instagram && (
                <a
                  href={activa.sede.instagram}
                  target="_blank"
                  rel="noopener"
                  class="boton boton--papel"
                >
                  {sedes.acciones.conoce} ↗
                </a>
              )}
            </div>
          </div>
        ) : (
          <div class="grow bg-papel px-6 py-6 lg:px-8 lg:py-7">
            {activa.dias.map((dia, i) => (
              <div class={i > 0 ? 'mt-7' : ''}>
                <p class="meta border-b-2 border-rojo pb-2 text-tinta/70">{dia.corto}</p>

                <ul class="divide-y divide-tinta/12">
                  {dia.actividades.map((a) => {
                    const recorrido = enTodasLasSedes(a.sede);
                    return (
                      <li
                        class:list={[
                          'flex flex-wrap items-baseline gap-x-4 gap-y-2 py-3',
                          /* El recorrido se pinta sobre campo amarillo y con su
                             marca: sin eso, ocho horas de Marcha del Arte en
                             medio de la lista se leen como una obra de esta
                             sede. */
                          recorrido && '-mx-3 bg-amarillo px-3',
                        ]}
                      >
                        <span class="font-mono text-sm font-bold text-rojo tabular-nums">
                          {a.inicio}
                        </span>
                        <span aria-hidden="true" class="text-tinta/25">//</span>

                        <span class="min-w-0 grow">
                          <span class="block text-base leading-snug">{a.titulo}</span>
                          <span class="meta mt-1 block text-[0.55rem] text-tinta/45">
                            {a.tipo}
                            {a.artista && <> · {a.artista}</>}
                          </span>

                          {/* Nunca un botón apagado: el formulario sólo cuando
                              lo hay, y la descripción sólo cuando está
                              publicada. */}
                          {a.registro && (
                            <a
                              href={a.registro}
                              target="_blank"
                              rel="noopener"
                              class="evento-lectura"
                              aria-label={`Registrarme en ${a.titulo}`}
                            >
                              Registrarme <span aria-hidden="true">↗</span>
                            </a>
                          )}
                          {a.sala?.publicado && (
                            <a
                              href={conBase(rutaSala(a.sala))}
                              class="evento-lectura"
                              aria-label={`Leer la descripción de ${a.titulo}`}
                            >
                              Descripción
                            </a>
                          )}
                        </span>

                        {recorrido && (
                          <span class="meta shrink-0 bg-tinta px-2 py-1 text-[0.5rem] text-amarillo">
                            Pasa por aquí
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* El último renglón no lleva filete: el que cierra la lista es el canto de
     la sección, y dos rayas pegadas se ven como un error de medio píxel. */
  .fila-sede:last-child {
    border-bottom: 0;
  }
</style>
