---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { festival } from '../data/site';

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = `${festival.nombre} · ${festival.fechas} · ${festival.ciudad}`,
} = Astro.props;

/**
 * El móvil no es este sitio adaptado: es otro sitio. Una página que trae
 * `slot="movil"` se pinta de dos maneras distintas según el ancho, y sólo
 * una de las dos existe a la vez. Las que no lo traen (privacidad, 404) ya
 * caben en un teléfono tal cual y se sirven igual en todas partes.
 */
const conMovil = Astro.slots.has('movil');

const tituloCompleto = `${titulo} — ${festival.nombreCompleto}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/logos/silla-roja.png" type="image/png" />
    <meta name="theme-color" content="#fffd00" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={festival.nombreCompleto} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Marca que hay JS antes del primer pintado: las reglas de reveal
         cuelgan de `.js`, así que sin esto el contenido se ve directamente.

         Aquí se decide también si la portada móvil juega su entrada. Tiene
         que ser en línea y en el <head>: si se decidiera más tarde, el
         teléfono llegaría a pintar la portada terminada y la entrada
         empezaría con un salto hacia atrás. -->
    <script is:inline>
      document.documentElement.classList.add('js');

      // Una vez por sesión y sólo en la portada. Verla en cada navegación
      // sería un peaje, no una bienvenida.
      try {
        if (
          location.pathname === '/' &&
          !sessionStorage.getItem('cs-entrada')
        ) {
          sessionStorage.setItem('cs-entrada', '1');
          document.documentElement.dataset.intro = 'si';
        }
      } catch (e) {
        // Safari en navegación privada tira al tocar sessionStorage. Sin
        // entrada se ve igual de bien.
      }
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Festival',
        name: festival.nombreCompleto,
        startDate: '2026-09-24',
        endDate: '2026-09-27',
        eventStatus: 'https://schema.org/EventScheduled',
        location: {
          '@type': 'Place',
          name: 'Guadalajara, Jalisco',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Guadalajara',
            addressRegion: 'Jalisco',
            addressCountry: 'MX',
          },
        },
        description: descripcion,
        url: canonica.toString(),
      })}
    />
  </head>

  <body data-movil={conMovil ? 'si' : undefined}>
    <a
      href="#contenido"
      class="meta sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-tinta focus:px-4 focus:py-2 focus:text-amarillo"
    >
      Saltar al contenido
    </a>

    <Nav />

    <!-- tabindex="-1": el enlace de salto tiene que poder dejar el foco aquí -->
    <main id="contenido" tabindex="-1">
      {conMovil && <div class="movil"><slot name="movil" /></div>}
      <div class={conMovil ? 'escritorio' : undefined}>
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
