---
import '../styles/global.css';
import { conBase } from '../lib/base';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { festival } from '../data/site';

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = `${festival.nombre} · ${festival.fechas} · ${festival.ciudad}`,
} = Astro.props;

/**
 * El móvil no es este sitio adaptado: es otro sitio. Una página que trae
 * `slot="movil"` se pinta de dos maneras distintas según el ancho, y sólo
 * una de las dos existe a la vez. Las que no lo traen (privacidad, 404) ya
 * caben en un teléfono tal cual y se sirven igual en todas partes.
 */
const conMovil = Astro.slots.has('movil');

const tituloCompleto = `${titulo} — ${festival.nombreCompleto}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={conBase("/logos/silla-roja.svg")} type="image/svg+xml" />
    <link rel="alternate icon" href={conBase("/logos/silla-roja.png")} type="image/png" />
    <meta name="theme-color" content="#fffd00" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={festival.nombreCompleto} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- La tarjeta que sale al pegar el enlace en WhatsApp, en Instagram o en
         cualquier chat. Faltaba, y encima `twitter:card` ya prometía una imagen
         grande: cada link que compartían salía como un rectángulo gris vacío.
         En un festival que se coordina entero por WhatsApp, eso es la primera
         impresión del sitio.

         `public/og.png` se genera con `scripts/og.html` —ábrelo en el navegador
         y captura a 1200×630— y no en cada build: es una imagen fija, no hay
         nada que recalcular. Si cambian las fechas o la ciudad, se edita esa
         plantilla y se vuelve a capturar.

         La URL tiene que ser ABSOLUTA: los raspadores de WhatsApp y compañía no
         resuelven rutas relativas. `new URL(...)` contra la canónica la resuelve
         bien tanto en producción como en la vista previa de GitHub Pages, que
         cuelga de un subdirectorio. -->
    <meta property="og:image" content={new URL(conBase('/og.png'), canonica)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${festival.nombre} — ${festival.fechas} — ${festival.ciudad}`}
    />

    <!-- La silla del cargador del móvil. Se pide desde el <head> para que baje
         en paralelo con la hoja de estilos: si se esperara al <img>, el campo
         amarillo saldría solo y la silla llegaría un latido tarde. `media` la
         deja fuera del escritorio, que no tiene cargador. -->
    <link
      rel="preload"
      as="image"
      type="image/svg+xml"
      media="(width < 64rem)"
      href={conBase('/logos/silla-roja.svg')}
    />

    <!-- ── El cargador del móvil ────────────────────────────────────────────
         Va en línea y no en `movil.css` a propósito: tiene que pintar en el
         PRIMER cuadro, y una hoja externa llega cuando ya hubo un blanco.

         Sólo se enciende si hay JS, porque sólo con JS se puede apagar: un
         cargador que no se quita es una puerta cerrada. Sin JS, `#carga` se
         queda en `display:none` y nadie se entera. -->
    <style is:inline>
      /* La primera visita no enciende el cargador —juega la entrada de la
         portada— así que el campo amarillo tiene que estar puesto ya, o entre
         el primer cuadro y la hoja de estilos se cuela un blanco. */
      html[data-intro] { background: #fffd00; }

      #carga { display: none; }

      html[data-carga] { overflow: hidden; }
      html[data-carga] #carga {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        /* El amarillo del manual, a pelo: esto pinta antes de que existan
           las variables de tema. */
        background: #fffd00;
      }
      html[data-carga] #carga img {
        width: min(42vw, 11rem);
        height: auto;
      }

      html[data-carga='fuera'] #carga {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        html[data-carga='fuera'] #carga { transition: none; }
      }
    </style>

    <!-- Marca que hay JS antes del primer pintado: las reglas de reveal
         cuelgan de `.js`, así que sin esto el contenido se ve directamente.

         Aquí se decide también si la portada móvil juega su entrada. Tiene
         que ser en línea y en el <head>: si se decidiera más tarde, el
         teléfono llegaría a pintar la portada terminada y la entrada
         empezaría con un salto hacia atrás. -->
    <script is:inline>
      document.documentElement.classList.add('js');

      // Una vez por sesión y sólo en la portada. Verla en cada navegación
      // sería un peaje, no una bienvenida.
      try {
        if (
          location.pathname === '/' &&
          !sessionStorage.getItem('cs-entrada')
        ) {
          sessionStorage.setItem('cs-entrada', '1');
          document.documentElement.dataset.intro = 'si';
        }
      } catch (e) {
        // Safari en navegación privada tira al tocar sessionStorage. Sin
        // entrada se ve igual de bien.
      }

      // El cargador: campo amarillo y la silla roja mientras carga.
      //
      // Sólo en el móvil, y NO cuando va a jugarse la entrada de la portada:
      // ésa abre con la misma imagen —silla roja sobre amarillo— y encadenar
      // las dos sería verla dos veces seguidas. Una cosa a la vez.
      //
      // Se decide aquí, en línea y antes del primer pintado, por lo mismo que
      // la entrada: más tarde ya habría habido un cuadro en blanco, que es
      // justo lo que esto viene a tapar.
      if (
        document.documentElement.dataset.intro !== 'si' &&
        window.matchMedia('(width < 64rem)').matches
      ) {
        document.documentElement.dataset.carga = 'si';
      }
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Festival',
        name: festival.nombreCompleto,
        startDate: '2026-09-24',
        endDate: '2026-09-27',
        eventStatus: 'https://schema.org/EventScheduled',
        location: {
          '@type': 'Place',
          name: 'Guadalajara, Jalisco',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Guadalajara',
            addressRegion: 'Jalisco',
            addressCountry: 'MX',
          },
        },
        description: descripcion,
        url: canonica.toString(),
      })}
    />
  </head>

  <body data-movil={conMovil ? 'si' : undefined}>
    <!-- Lo primero del <body> para que sea lo primero que se pinte. -->
    <div id="carga" aria-hidden="true">
      <img
        src={conBase('/logos/silla-roja.svg')}
        alt=""
        width="316"
        height="420"
        fetchpriority="high"
      />
    </div>

    <script is:inline>
      // Se quita cuando las tipografías están listas, que es el último
      // momento en que la página todavía puede saltar a la vista: las tres
      // familias son de las que cambian el ancho del texto al llegar.
      //
      // Dos frenos, uno por lado. Abajo, `MINIMO`: con todo en caché esto
      // duraría veinte milisegundos y sería un parpadeo, que se lee como un
      // fallo y no como una bienvenida. Arriba, `TOPE`: una tipografía que no
      // llega nunca no puede dejar la página detrás de una cortina.
      (function () {
        var raiz = document.documentElement;
        if (raiz.dataset.carga !== 'si') return;

        var MINIMO = 400;
        var TOPE = 2500;
        var desde = Date.now();

        function quitar() {
          setTimeout(function () {
            raiz.dataset.carga = 'fuera';
            // Y fuera del todo cuando acaba el fundido, para devolver el
            // scroll y no dejar una capa muerta encima de la página.
            setTimeout(function () { delete raiz.dataset.carga; }, 450);
          }, Math.max(0, MINIMO - (Date.now() - desde)));
        }

        // `document.fonts.ready` hay que pedirlo DESPUÉS de que el documento
        // esté armado, y no aquí arriba. Una tipografía no se pide hasta que
        // hay texto que maquetar con ella; preguntando desde lo alto del
        // <body> no hay ninguna en curso todavía y la promesa se cumple al
        // instante — el cargador se iba antes de que llegara nada, que es
        // exactamente lo que venía a tapar.
        function traeFuentes() {
          return document.fonts && document.fonts.ready
            ? document.fonts.ready
            : Promise.resolve();
        }
        var armado =
          document.readyState === 'loading'
            ? new Promise(function (listo) {
                document.addEventListener('DOMContentLoaded', listo, { once: true });
              })
            : Promise.resolve();

        var fuentes = armado.then(traeFuentes);
        var tope = new Promise(function (listo) { setTimeout(listo, TOPE); });

        // `quitar` en los dos lados de la carrera: si algo revienta, se quita
        // igual. Lo único que no puede pasar es que se quede puesto.
        Promise.race([fuentes, tope]).then(quitar, quitar);
      })();
    </script>

    <a
      href="#contenido"
      class="meta sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-tinta focus:px-4 focus:py-2 focus:text-amarillo"
    >
      Saltar al contenido
    </a>

    <Nav />

    <!-- tabindex="-1": el enlace de salto tiene que poder dejar el foco aquí -->
    <main id="contenido" tabindex="-1">
      {conMovil && <div class="movil"><slot name="movil" /></div>}
      <div class={conMovil ? 'escritorio' : undefined}>
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
